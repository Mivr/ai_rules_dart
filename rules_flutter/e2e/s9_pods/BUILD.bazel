# Spike T17a (S9). Not for merge.
#
# The stock app of `flutter create` with eight plugins, in CocoaPods mode. Its pods are the
# targets of `@apple_model`, generated from `apple_model.json`; no podspec is read by the rules.
# The runner is the stock one: ios/Runner/AppDelegate.swift and the GeneratedPluginRegistrant
# that `flutter pub get` writes.
load("@apple_model//:defs.bzl", "FRAMEWORK_PODS", "PODS")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_flutter//flutter:defs.bzl", "flutter_application")
load(
    "@rules_flutter//flutter:ios.bzl",
    "IOS_DEFAULT_LAUNCH_STORYBOARD",
    "IOS_DEFAULT_MAIN_STORYBOARD",
    "IOS_MINIMUM_OS_VERSION",
    "flutter_ios_engine",
    "flutter_ios_framework_gen",
    "flutter_ios_info_plist_gen",
)
load("@rules_swift//swift:swift.bzl", "swift_library")

exports_files([
    "apple_model.json",
    "pubspec.lock",
])

flutter_application(
    name = "app_flutter",
    package_name = "s9app",
    main = "lib/main.dart",
    min_os_version = IOS_MINIMUM_OS_VERSION,
    pub_packages = "@deps//packages",
    deps = [
        "@deps//:firebase_core",
        "@deps//:firebase_messaging",
        "@deps//:flutter",
        "@deps//:google_maps_flutter",
        "@deps//:google_sign_in",
        "@deps//:image_picker",
        "@deps//:permission_handler",
        "@deps//:url_launcher",
        "@deps//:webview_flutter",
    ],
)

flutter_ios_framework_gen(
    name = "app_framework",
    application = ":app_flutter",
)

flutter_ios_engine(name = "app_engine")

apple_bundle_version(
    name = "app_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

flutter_ios_info_plist_gen(
    name = "info_plist",
    app_name = "s9app",
    module_name = "Runner",
)

# The registrant `flutter pub get` wrote: it imports every plugin's module and registers its class.
objc_library(
    name = "registrant",
    srcs = ["ios/Runner/GeneratedPluginRegistrant.m"],
    hdrs = ["ios/Runner/GeneratedPluginRegistrant.h"],
    enable_modules = True,
    includes = ["ios/Runner"],
    module_name = "RunnerRegistrant",
    tags = ["manual"],
    deps = [
        ":app_engine",
        "@apple_model//:Pods-Runner",
    ],
)

swift_library(
    name = "runner",
    srcs = [
        "ios/Runner/AppDelegate.swift",
        "ios/Runner/SceneDelegate.swift",
    ],
    copts = [
        "-import-objc-header",
        "$(execpath ios/Runner/Runner-Bridging-Header.h)",
    ],
    data = [IOS_DEFAULT_MAIN_STORYBOARD],
    module_name = "Runner",
    swiftc_inputs = ["ios/Runner/Runner-Bridging-Header.h"],
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":registrant",
    ],
)

# Release shape: every pod is linked statically into the app binary.
ios_application(
    name = "app",
    bundle_id = "dev.rdf.s9app",
    families = ["iphone"],
    infoplists = [":info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        ":runner",
    ],
)

# Debug shape (W8-9): every pod CocoaPods builds is its own dynamic framework; the app binary
# holds the runner only. An edit in one pod relinks that framework, an edit in the app the binary.
ios_application(
    name = "app_frameworks",
    bundle_id = "dev.rdf.s9app",
    families = ["iphone"],
    frameworks = ["@apple_model//:%s.framework" % pod for pod in PODS if pod in FRAMEWORK_PODS],
    infoplists = [":info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        ":runner",
    ],
)

# Every library the model describes, one target per pod: what `build --nobuild` analyses on Linux
# and what the macOS job compiles.
build_test(
    name = "pods_build_test",
    tags = ["manual"],
    targets = ["@apple_model//:" + pod for pod in PODS],
)
