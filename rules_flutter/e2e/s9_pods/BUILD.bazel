# Spike T17a (S9). Not for merge.
#
# The stock app of `flutter create` with eight plugins, in CocoaPods mode. Its pods are the
# targets of `@apple_model`, generated from `apple_model.json`; no podspec is read by the rules.
# The runner is the stock one: ios/Runner/AppDelegate.swift and the GeneratedPluginRegistrant
# that `flutter pub get` writes.
load("@apple_model//:defs.bzl", "DYNAMIC_FRAMEWORK_PODS", "FRAMEWORK_PODS", "PODS")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_flutter//flutter:defs.bzl", "flutter_application")
load(
    "@rules_flutter//flutter:ios.bzl",
    "IOS_DEFAULT_LAUNCH_STORYBOARD",
    "IOS_DEFAULT_MAIN_STORYBOARD",
    "IOS_MINIMUM_OS_VERSION",
    "flutter_ios_engine",
    "flutter_ios_framework_gen",
    "flutter_ios_info_plist_gen",
)
load("@rules_swift//swift:swift.bzl", "swift_library")

exports_files([
    "apple_model.json",
    "apple_model_m14.json",
    "pubspec.lock",
])

# As the stock project has them: its icon set (Xcode compiles it into Assets.car and the icon
# files of the bundle) and both device families.
_APP_ICONS = glob(["ios/Runner/Assets.xcassets/AppIcon.appiconset/**"])

_FAMILIES = [
    "iphone",
    "ipad",
]

flutter_application(
    name = "app_flutter",
    package_name = "s9app",
    main = "lib/main.dart",
    min_os_version = IOS_MINIMUM_OS_VERSION,
    pub_packages = "@deps//packages",
    deps = [
        "@deps//:firebase_core",
        "@deps//:firebase_messaging",
        "@deps//:flutter",
        "@deps//:google_maps_flutter",
        "@deps//:google_sign_in",
        "@deps//:image_picker",
        "@deps//:permission_handler",
        "@deps//:url_launcher",
        "@deps//:webview_flutter",
    ],
)

flutter_ios_framework_gen(
    name = "app_framework",
    application = ":app_flutter",
)

flutter_ios_engine(name = "app_engine")

apple_bundle_version(
    name = "app_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

flutter_ios_info_plist_gen(
    name = "info_plist",
    app_name = "s9app",
    module_name = "Runner",
)

# The registrant `flutter pub get` wrote: it imports every plugin's module and registers its class.
objc_library(
    name = "registrant",
    srcs = ["ios/Runner/GeneratedPluginRegistrant.m"],
    hdrs = ["ios/Runner/GeneratedPluginRegistrant.h"],
    enable_modules = True,
    includes = ["ios/Runner"],
    module_name = "RunnerRegistrant",
    tags = ["manual"],
    deps = [
        ":app_engine",
        "@apple_model//:Pods-Runner",
    ],
)

swift_library(
    name = "runner",
    srcs = [
        "ios/Runner/AppDelegate.swift",
        "ios/Runner/SceneDelegate.swift",
    ],
    copts = [
        "-import-objc-header",
        "$(execpath ios/Runner/Runner-Bridging-Header.h)",
    ],
    # AppFrameworkInfo.plist is a resource of the stock Runner target and is in its bundle.
    data = [
        IOS_DEFAULT_MAIN_STORYBOARD,
        "ios/Flutter/AppFrameworkInfo.plist",
    ],
    module_name = "Runner",
    swiftc_inputs = ["ios/Runner/Runner-Bridging-Header.h"],
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":registrant_header",
    ],
)

# What the runner sees of the registrant. Which plugins a registrant registers is the app's choice:
# every app below names its own beside the runner.
objc_library(
    name = "registrant_header",
    hdrs = ["ios/Runner/GeneratedPluginRegistrant.h"],
    includes = ["ios/Runner"],
    tags = ["manual"],
    deps = [":app_engine"],
)

# Release shape: every pod is linked statically into the app binary.
ios_application(
    name = "app",
    app_icons = _APP_ICONS,
    bundle_id = "dev.rdf.s9app",
    families = _FAMILIES,
    infoplists = [":info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        ":registrant",
        ":runner",
    ],
)

# Debug shape (W8-9): every pod CocoaPods builds is its own dynamic framework; the app binary
# holds the runner only. An edit in one pod relinks that framework, an edit in the app the binary.
ios_application(
    name = "app_frameworks",
    app_icons = _APP_ICONS,
    bundle_id = "dev.rdf.s9app",
    families = _FAMILIES,
    frameworks = ["@apple_model//:%s.framework" % pod for pod in PODS if pod in FRAMEWORK_PODS],
    infoplists = [":info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        ":registrant",
        ":runner",
    ],
)

# The debug shape with CocoaPods' own choice of linkage, tried beside the one above (an experiment
# of the macOS job, not a stage): only what CocoaPods links as a dynamic framework is one. A pod
# that declares `static_framework` (five of the eight plugins, and Google-Maps-iOS-Utils) stays in
# the app binary, as in the stock build, and the static GoogleMaps binary under two of them is
# linked once.
ios_application(
    name = "app_frameworks_as_pods",
    app_icons = _APP_ICONS,
    bundle_id = "dev.rdf.s9app",
    families = _FAMILIES,
    frameworks = ["@apple_model//:%s.framework" % pod for pod in PODS if pod in DYNAMIC_FRAMEWORK_PODS],
    infoplists = [":info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        ":registrant",
        ":runner",
    ],
)

# Smaller apps, experiments of the macOS job: the same Dart program and the same runner with fewer
# plugins on the native side, so that a pod that does not build yet cannot keep every app from
# linking, launching and being measured. `app_seven` leaves out the Google Maps plugin (and with it
# Google-Maps-iOS-Utils and the binary GoogleMaps). `app_four` has the four plugins whose only pod
# dependency is the engine, and `app_four_frameworks` is its debug shape. The Dart side still calls
# every plugin: a probe of a plugin that is not there prints an `ERR` line.
_SUBSETS = {
    "four": [
        "image_picker_ios",
        "permission_handler_apple",
        "url_launcher_ios",
        "webview_flutter_wkwebview",
    ],
    "seven": [
        "firebase_core",
        "firebase_messaging",
        "google_sign_in_ios",
        "image_picker_ios",
        "permission_handler_apple",
        "url_launcher_ios",
        "webview_flutter_wkwebview",
    ],
}

[
    objc_library(
        name = "registrant_" + subset,
        # GeneratedPluginRegistrant.m of ios/Runner, cut down by hand to the subset's plugins.
        srcs = ["ios/experiments/%s/GeneratedPluginRegistrant.m" % subset],
        hdrs = ["ios/Runner/GeneratedPluginRegistrant.h"],
        enable_modules = True,
        includes = ["ios/Runner"],
        module_name = "RunnerRegistrant_" + subset,
        tags = ["manual"],
        deps = [":app_engine"] + ["@apple_model//:" + pod for pod in pods],
    )
    for subset, pods in _SUBSETS.items()
]

[
    ios_application(
        name = name,
        app_icons = _APP_ICONS,
        bundle_id = "dev.rdf.s9app",
        families = _FAMILIES,
        frameworks = frameworks,
        infoplists = [":info_plist"],
        launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
        minimum_os_version = IOS_MINIMUM_OS_VERSION,
        tags = ["manual"],
        version = ":app_version",
        deps = [
            ":app_framework",
            ":registrant_" + subset,
            ":runner",
        ],
    )
    for name, subset, frameworks in [
        ("app_seven", "seven", []),
        ("app_four", "four", []),
        (
            "app_four_frameworks",
            "four",
            ["@apple_model//:%s.framework" % pod for pod in _SUBSETS["four"]],
        ),
    ]
]

# Every library the model describes, one target per pod: what `build --nobuild` analyses on Linux
# and what the macOS job compiles.
build_test(
    name = "pods_build_test",
    tags = ["manual"],
    targets = ["@apple_model//:" + pod for pod in PODS],
)
