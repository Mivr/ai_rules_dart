        ":hello_world_ios_simulator",
    ],
    main = "test/verify_ios_bundle_contents_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# Portable compile + lint target for `:verify_ios_bundle_contents_test`: the
# test itself skips off macOS (`:hello_world_ios_simulator` requires Xcode), so
