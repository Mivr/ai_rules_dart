# Bazel's test protocol under `flutter_test`: `--test_filter` selects cases,
# `shard_count` splits them, and each case is reported in the XML Bazel
# collects. (Its `size`/`timeout` as the suite's default timeout is unit-tested
# on `suiteTimeout` in `flutter_test_runner_test`.) The sharded twin is what proves
# the runner declares sharding support; see the test file.
# An Impeller-only shader, drawn in flutter_tester running Impeller. Its
# project is `impeller_shader/`: the root pubspec, which the web app shares,
# cannot name a shader a web build cannot compile.
flutter_test(
    name = "impeller_shader_test",
    package_name = "hello_world",
    size = "medium",
    enable_impeller = True,
    main = "test/impeller_shader_test.dart",
    pub_packages = "@deps//packages",
    pubspec = "impeller_shader/pubspec.yaml",
    pubspec_srcs = ["impeller_shader/shaders/indexed.frag"],
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

flutter_test(
    name = "bazel_protocol_test",
    package_name = "hello_world",
    size = "medium",
    main = "test/bazel_protocol_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

flutter_test(
    name = "bazel_protocol_sharded_test",
    package_name = "hello_world",
    size = "medium",
    main = "test/bazel_protocol_test.dart",
    shard_count = 3,
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

# Tag selection, as `flutter test --tags` / `--exclude-tags` resolve it:
# `test/tags_test.dart` carries untagged cases plus cases tagged `golden` at
# test level, and this target excludes that tag. Only the untagged cases
# run — the tagged ones fail if they run at all, so a green run proves the
# pruning. A `--test_env=FLUTTER_TEST_EXCLUDE_TAGS=...` value at run time
# overrides this.
flutter_test(
    name = "tags_test",
    package_name = "hello_world",
    size = "medium",
    exclude_tags = ["golden"],
    main = "test/tags_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

# Library-level `@Tags`: `test/tags_library_test.dart` annotates its own
# entrypoint with `@Tags(['golden'])`, which the rule extracts at build time
# and the runner reports on the suite's root group, so every case inherits it.
# Excluding `golden` prunes the suite to empty, and an empty suite passes — a
# green run proves the root-group inheritance. (A `@Tags` on an imported file
# would stay invisible, exactly as under `flutter test`.)
flutter_test(
    name = "tags_library_test",
    package_name = "hello_world",
    size = "medium",
    exclude_tags = ["golden"],
    main = "test/tags_library_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

# Verifies Dart environment defines: the `defines` attr, the
