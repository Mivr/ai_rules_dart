# Exercises: the coverage path through the runner, which `bazel test` alone
# never reaches. `bazel coverage` spawns flutter_tester with its VM service
# enabled, and the runner collects LCOV over it after the suite runs.
# `COVERAGE_OUTPUT_FILE` is the runner's own trigger for that path, so setting
# it exercises the real code under the canonical `bazel test //...` rather
# than simulating it.
#
# The `moderate` timeout is deliberately *longer* than the runner's own
# two-minute dial-back bound, so a hang is reported by the runner with a reason
# rather than killed by Bazel as a bare TIMEOUT. Do not drop it to `short`.
flutter_test(
    name = "hello_coverage_test",
    package_name = "hello_world",
    size = "small",
    timeout = "moderate",
    env = {"COVERAGE_OUTPUT_FILE": "coverage_probe.lcov"},
    main = "hello_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter_test",
    ],
)

# Exercises: the coverage scope. Same suite as `:hello_coverage_test` without
# the `COVERAGE_OUTPUT_FILE` env, so `bazel coverage` alone drives the run and
# `check_coverage_scope_report.sh` reads the report it produces: the test's own
# code is in it, the Flutter framework is not.
flutter_test(
    name = "hello_coverage_scope_test",
    package_name = "hello_world",
    size = "small",
    timeout = "moderate",
    main = "hello_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter_test",
    ],
)

