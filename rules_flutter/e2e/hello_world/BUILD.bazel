# -- Custom test kernels: the `flutter_test_bootstrap` docstring, running -----
#
# Each `custom_test_kernel` below compiles its suite by hand over the public
# `//flutter:utils.bzl` helpers (see `custom_test_kernel.bzl`) and runs under
# `flutter_prebuilt_test`, with a `flutter_test` on the same sources as the
# oracle. The asset trees are the oracles' own `test_assets`: bundles are
# kernel-independent (only icon tree-shaking reads the kernel), so a
# hand-built kernel runs on the stock bundle.

# The counter-tap widget suite, compiled by hand: passes exactly when
# `:widget_test` passes, proving a custom kernel over the bootstrap dials the
# harness and runs a real `package:flutter_test` suite.
custom_test_kernel(
    name = "widget_custom_kernel",
    srcs = [
        "lib/common_widgets.dart",
        "lib/main.dart",
    ],
    main = "test/widget_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        ":app_lib",
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
        "@deps//:flutter_test",
        "@deps//:platform_assets",
    ],
)

filegroup(
    name = "widget_custom_kernel_tags",
    testonly = True,
    srcs = [":widget_custom_kernel"],
    output_group = "test_library_tags",
)

flutter_prebuilt_test(
    name = "widget_custom_bootstrap_test",
    size = "medium",
    assets = ":widget_test_assets",
    dill = ":widget_custom_kernel",
    library_tags = ":widget_custom_kernel_tags",
    target_compatible_with = _HOST_COMPATIBLE,
)

# A hand-compiled kernel must be reproducible: `:widget_custom_kernel` is
# built over the public `//flutter:utils.bzl` helpers only, and its dill must
# carry no absolute host path — every source URI a stable
# `org-dartlang-app:///` or `package:` URI, as in the stock `:widget_test`
# kernel beside it. Reads the dill's bytes out of runfiles and fails on the
# first sandbox `execroot` URI, so a regression that re-keys a library by
# `file://` breaks `bazel test //...` here instead of silently busting remote
# caches downstream.
dart_test(
    name = "verify_custom_kernel_reproducible_test",
    size = "small",
    data = [":widget_custom_kernel"],
    main = "test/verify_custom_kernel_reproducible_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# The `@Tags(['golden'])` suite, compiled by hand: excluding `golden` prunes
# it to empty, proving library tags extracted by a custom pipeline reach the
# prebuilt run's root group exactly as through the stock one.
custom_test_kernel(
    name = "tags_library_custom_kernel",
    main = "test/tags_library_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

filegroup(
    name = "tags_library_custom_kernel_tags",
    testonly = True,
    srcs = [":tags_library_custom_kernel"],
    output_group = "test_library_tags",
)

flutter_prebuilt_test(
    name = "tags_library_custom_bootstrap_test",
    size = "medium",
    assets = ":tags_library_test_assets",
    dill = ":tags_library_custom_kernel",
    exclude_tags = ["golden"],
    library_tags = ":tags_library_custom_kernel_tags",
    target_compatible_with = _HOST_COMPATIBLE,
)

# -- Custom modular kernels: the `flutter_modular_test_kernel` /
#    `flutter_modular_app_kernel` docstrings, running --------------------------
#
# Each target below is built by hand over the public `//flutter:utils.bzl`
# modular helpers (see `custom_modular_test_kernel.bzl`), compiling each
# `flutter_library` dependency once into a `.flutter.kmod` module and linking
# the entry against the outlines — so a body-only edit to `modular_greeter`
# recompiles only that module plus the entry/link actions, never the whole
# program. The default link is complete: `:widget_modular_prebuilt_test` runs
# it with no `base_dill`. The `use_base_dill` twin delta-links against the
# shared `flutter_test` base instead (the smaller per-test dill for many
# tests sharing one SDK base) and feeds it to `base_dill`. Both run over
