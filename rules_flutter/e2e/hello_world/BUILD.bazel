# -- Recommended: flutter_application with local sources ----------------------

# What pubspec.yaml names: the `assets/` directory and the HelloSans font
# family. `assets/stage_clean.txt` is the macOS rebuild fixture: the glob makes
# a deleted file undeclared without editing this BUILD file, so
# `verify_macos_stage_clean_test` can build, remove it, and rebuild.
_PUBSPEC_SRCS = glob(["assets/**"]) + [
    "fonts/HelloSans-Bold.ttf",
