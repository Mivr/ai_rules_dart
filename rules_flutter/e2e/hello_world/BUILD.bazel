# Unit tests for `test/bazel_client.dart`, the resolver the macOS stage-clean
# test uses for its nested `bazel` and `unzip`. They run on every host: each
# creates a temporary directory and a fake executable, and none runs a real
# Bazel. The macOS lane of full.yaml proves the rebuild assertion itself.
dart_test(
    name = "bazel_client_test",
    size = "small",
    srcs = ["test/bazel_client.dart"],
    main = "test/bazel_client_test.dart",
    deps = ["@deps//:test"],
)

# macOS rebuild guard: under a local framework strategy the staging directory
# survives between builds, so an asset removed from the app must not survive in
# the new App.framework.zip. The test drives real builds in a private output
# base, so it is `external` (never a replayed cached pass) and `no-sandbox` (it
# reaches the workspace through its runfiles anchor). The macOS leg of
# full.yaml runs `bazel test //...`; other hosts cannot build a macOS app.
# `PATH` is inherited with `BAZEL`: Bazel sanitizes a test's environment, so
# the test resolves its nested client from one of those two, never a bare
# spawn against the default environment.
dart_test(
    name = "verify_macos_stage_clean_test",
    size = "enormous",
    srcs = ["test/bazel_client.dart"],
    data = ["test/verify_macos_stage_clean_test.dart"],
    env = {
        "GUARD_ROOT_ANCHOR": "$(rlocationpath :test/verify_macos_stage_clean_test.dart)",
    },
    # The nested build loads this workspace's rules_android_ndk extension, which needs the
    # host's Android paths like the outer build does.
    env_inherit = [
        "BUILD_WORKSPACE_DIRECTORY",
        "BAZEL",
        "PATH",
        "ANDROID_HOME",
        "ANDROID_NDK_HOME",
    ],
    main = "test/verify_macos_stage_clean_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

flutter_ios_simulator_build_test(
