# Verifies the asset bundle structure for pub-package fonts/assets:
# cupertino_icons (flutter.fonts), flutter_localized_locales (flutter.assets),
# and the Material icons the pubspec's `uses-material-design` asks for.
# Asserts files land at packages/<pkg>/<path>, FontManifest.json carries the
# prefixed family for pub fonts and a bare MaterialIcons family, and
# AssetManifest.bin references the prefixed asset path.
dart_test(
    name = "verify_pub_assets_test",
    size = "small",
    data = [":hello_world_app"],
