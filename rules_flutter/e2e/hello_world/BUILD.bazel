    ],
)

# Verifies project-relative asset keys for a subdirectory app bundle:
# `//sub:sub_app` keys its own `assets/notice.txt` relative to its project
# directory `sub/` (no `sub/` prefix): the nested `//sub/nested` file arrives
# as `nested/extra.txt` and the genrule output as `gen_notice.txt`. The
# first-party `//brand` dependency's asset lands at
# `packages/brand/assets/brand.txt`. Reads the bundle's `flutter_assets/`
# tree and AssetManifest.bin like `:verify_pub_assets_test` does for pub
# assets.
dart_test(
    name = "verify_sub_assets_test",
    size = "small",
    data = ["//sub:sub_app"],
    main = "test/verify_sub_assets_test.dart",
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# Path-spoke hermeticity: fetching the `path_probe` / `path_probe_no_build`
# `path:` spokes must leave the source tree untouched. The fixture packages
# carry an android/ directory (with and without a user BUILD.bazel), a
# declared shader, an example/build/ shader and a .plugin_symlinks cycle.
# The data deps force both spokes to fetch and load before the test runs;
# the test then pins the user BUILD's sentinel intact and no BUILD created
# where the user had none. Reads files Bazel does not track as inputs, so
# like the repo's static guards it is tagged `external` (re-run every
# invocation, never a replayed cached pass) and `no-sandbox` (the anchor
# resolves through the runfiles library, under both the Unix tree and the
# Windows manifest).
dart_test(
    name = "verify_path_spoke_hermeticity_test",
    size = "small",
    data = [
        "test/verify_path_spoke_hermeticity_test.dart",
        "@deps//:path_probe",
        "@deps//:path_probe_no_build",
    ],
    env = {"GUARD_ROOT_ANCHOR": "$(rlocationpath :test/verify_path_spoke_hermeticity_test.dart)"},
    env_inherit = ["BUILD_WORKSPACE_DIRECTORY"],
    main = "test/verify_path_spoke_hermeticity_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    target_compatible_with = _HOST_COMPATIBLE,
    deps = [
        "@deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# Verifies that the entitlements blob applied at codesign time on the
# macOS bundle declares the App Sandbox capability — proves
# flutter_macos_app threaded macos/Runner/{DebugProfile,Release}.entitlements
# through to macos_application(entitlements = ...).
#
# iOS doesn't have a counterpart runtime test: rules_apple's
# codesigning pipeline strips user entitlements down to a single
# get-task-allow=true entry for simulator builds (per
# external/rules_apple/.../codesigning_support.bzl), so a sim-build
# codesign blob can't reflect forwarded entitlements. Forwarding is
# verified by `bazel cquery 'deps(//:hello_world_ios)' | grep
# Runner.entitlements`, and the existing `ios_bundle_build_test`
# proves the bundle still analyzes with the auto-discovered file.
dart_test(
    name = "verify_macos_entitlements_test",
    size = "medium",
    data = [":hello_world_macos"],
    main = "test/verify_macos_entitlements_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# The app icon `flutter create` leaves in the tree, which this BUILD file
# never mentions — `flutter_macos_app` discovers it, and the bundle has to
# actually carry it. See the test's own docs for why the Info.plist assertion
# is the load-bearing half.
dart_test(
    name = "verify_macos_app_icon_test",
    size = "medium",
    data = [":hello_world_macos"],
    main = "test/verify_macos_app_icon_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
)

# The workspace's lint ruleset, bundled with the pub package its `include:`
# resolves against. Named here rather than in any library's `deps`: a lint
# ruleset is not a dependency of the code it lints, and listing it there would
# carry it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    package_name = "hello_world",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
    ],
)
