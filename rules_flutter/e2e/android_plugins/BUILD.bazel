load("@android_model//:defs.bzl", "flutter_android_apk_test", "flutter_android_app", "flutter_android_bundle_test")
load("@rules_flutter//flutter:android.bzl", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application")

flutter_application(
    name = "counter",
    package_name = "counter",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    pub_packages = "@deps//packages",
    deps = [
        "@deps//:camera",
        "@deps//:cupertino_icons",
        "@deps//:firebase_core",
        "@deps//:firebase_messaging",
        "@deps//:flutter",
        "@deps//:flutter_local_notifications",
        "@deps//:google_maps_flutter_android",
        "@deps//:google_maps_flutter_platform_interface",
        "@deps//:path_provider",
        "@deps//:shared_preferences",
        "@deps//:url_launcher",
        "@deps//:webview_flutter",
    ],
)

# `bazel run //:android_pin` writes android_model.json (Gradle evaluates the build once).
flutter_android_pin(name = "android_pin")

# `//:app` is the split APKs of a debug build, `//:app_apk` the whole APK.
flutter_android_app(
    name = "app",
    application = ":counter",
    # package:jni builds libdartjni.so with CMake in Gradle; here the Dart side builds it.
    native_built_elsewhere = [":jni"],
)

# The release build: R8, resource shrinking, the AOT library per ABI; `//:app_release_apk` is the whole
# APK, `//:app_release_apk_armeabi_v7a`, `//:app_release_apk_arm64_v8a` and `//:app_release_apk_x86_64` are
# what `--split-per-abi` gives. The ABIs are the model's: the three of a stock release build.
flutter_android_app(
    name = "app_release",
    application = ":counter",
    native_built_elsewhere = [":jni"],
    split_per_abi = True,
    variant = "release",
)

# The profile build: the AOT library with the profile engine.
flutter_android_app(
    name = "app_profile",
    application = ":counter",
    native_built_elsewhere = [":jni"],
    variant = "profile",
)

# What was built: every plugin's code and its own R class, the engine for three ABIs, the Java
# resources of the Maven libraries under the app's packaging rules, each plugin's code in its own
# split and the Dart payload in its own.
flutter_android_apk_test(
    name = "app_test",
    absent_entries = [
        "META-INF/*.kotlin_module",
        "META-INF/MANIFEST.MF",
        "META-INF/maven/**",
    ],
    app = "app",
    classes = [
        "Lio/flutter/plugins/GeneratedPluginRegistrant;",
        "Lio/flutter/plugins/camerax/CameraAndroidCameraxPlugin;",
        "Lio/flutter/plugins/firebase/core/FlutterFirebaseCorePlugin;",
        "Lio/flutter/plugins/firebase/messaging/FlutterFirebaseMessagingPlugin;",
        "Lcom/dexterous/flutterlocalnotifications/FlutterLocalNotificationsPlugin;",
        "Lio/flutter/plugins/googlemaps/GoogleMapsPlugin;",
        "Lcom/github/dart_lang/jni/JniPlugin;",
        "Lio/flutter/plugins/sharedpreferences/SharedPreferencesPlugin;",
        "Lio/flutter/plugins/urllauncher/UrlLauncherPlugin;",
        "Lio/flutter/plugins/webviewflutter/WebViewFlutterPlugin;",
        # BuildConfig of a plugin, and R classes: the app's, a plugin's, an AAR's.
        "Lio/flutter/plugins/urllauncher/BuildConfig;",
        "Ldev/rdf/counter/R$mipmap;",
        "Lio/flutter/plugins/urllauncher/R;",
        "Landroidx/browser/R$id;",
        # Core library desugaring: the desugared library itself.
        "Lj$/time/TimeConversions;",
    ],
    entries = [
        "assets/flutter_assets/kernel_blob.bin",
        "lib/arm64-v8a/libflutter.so",
        "lib/armeabi-v7a/libflutter.so",
        "lib/x86_64/libflutter.so",
        "lib/x86_64/libdartjni.so",
        "META-INF/com/android/build/gradle/app-metadata.properties",
        # Merged from several jars by the app's packaging rules.
        "META-INF/services/kotlinx.coroutines.internal.MainDispatcherFactory",
        "kotlin/kotlin.kotlin_builtins",
    ],
    split_classes = {
        "app": "Ldev/rdf/counter/MainActivity;",
        "base": "Lio/flutter/plugins/urllauncher/R;",
        "p_url_launcher_android__debug": "Lio/flutter/plugins/urllauncher/UrlLauncherPlugin;",
        "p_webview_flutter_android__debug": "Lio/flutter/plugins/webviewflutter/WebViewFlutterPlugin;",
    },
    split_entries = {
        "base": "lib/x86_64/libflutter.so",
        "dart": "assets/flutter_assets/kernel_blob.bin",
    },
    splits = [
        "app",
        "dart",
        "p_camera_android_camerax__debug",
        "p_firebase_core__debug",
        "p_firebase_messaging__debug",
        "p_flutter_local_notifications__debug",
        "p_flutter_plugin_android_lifecycle__debug",
        "p_google_maps_flutter_android__debug",
        "p_jni__debug",
        "p_jni_flutter__debug",
        "p_shared_preferences_android__debug",
        "p_url_launcher_android__debug",
        "p_webview_flutter_android__debug",
    ],
    version_code = 1,
    version_name = "1.0.0",
)

# What the release build holds: the app's entry points under their own names and the rest renamed or
# removed by R8, the resources shrunk, the AOT library for each of the three ABIs of a stock release
# build and no kernel, the baseline profile.
flutter_android_apk_test(
    name = "app_release_test",
    absent_classes = [
        # Renamed (a plugin is kept, not its name) or removed (nothing reads it).
        "Lio/flutter/plugins/urllauncher/UrlLauncherPlugin;",
        "Lio/flutter/plugins/urllauncher/BuildConfig;",
        "Landroidx/browser/R$id;",
    ],
    absent_entries = [
        "assets/flutter_assets/kernel_blob.bin",
        "lib/x86/**",
        "META-INF/*.kotlin_module",
    ],
    app = "app_release",
    classes = [
        "Ldev/rdf/counter/MainActivity;",
        "Lio/flutter/plugins/GeneratedPluginRegistrant;",
        # Kept by name: package:jni looks its classes up from native code.
        "Lcom/github/dart_lang/jni/JniPlugin;",
        "Lj$/time/Instant;",
    ],
    entries = [
        "lib/armeabi-v7a/libapp.so",
        "lib/armeabi-v7a/libflutter.so",
        "lib/arm64-v8a/libapp.so",
        "lib/arm64-v8a/libflutter.so",
        "lib/x86_64/libapp.so",
        "lib/x86_64/libflutter.so",
        "assets/dexopt/baseline.prof",
        "assets/dexopt/baseline.profm",
        "assets/flutter_assets/AssetManifest.bin",
        "META-INF/com/android/build/gradle/app-metadata.properties",
    ],
    version_code = 1,
    version_name = "1.0.0",
)

# `split_per_abi`: one ABI's libraries, and Flutter's version code for the ABI.
flutter_android_apk_test(
    name = "app_release_armeabi_v7a_test",
    abi = "armeabi-v7a",
    absent_entries = [
        "lib/arm64-v8a/**",
        "lib/x86_64/**",
    ],
    app = "app_release",
    entries = [
        "lib/armeabi-v7a/libapp.so",
        "lib/armeabi-v7a/libdartjni.so",
        "lib/armeabi-v7a/libflutter.so",
    ],
    version_code = 1001,
    version_name = "1.0.0",
)

flutter_android_apk_test(
    name = "app_release_x86_64_test",
    abi = "x86_64",
    absent_entries = ["lib/arm64-v8a/**"],
    app = "app_release",
    entries = [
        "lib/x86_64/libapp.so",
        "lib/x86_64/libflutter.so",
    ],
    version_code = 4001,
    version_name = "1.0.0",
)

# The profile build: the AOT library, the profile engine, code neither shrunk nor renamed.
flutter_android_apk_test(
    name = "app_profile_test",
    absent_entries = ["assets/flutter_assets/kernel_blob.bin"],
    app = "app_profile",
    classes = [
        "Lio/flutter/plugins/urllauncher/UrlLauncherPlugin;",
        "Lio/flutter/plugins/urllauncher/BuildConfig;",
    ],
    entries = [
        "lib/armeabi-v7a/libapp.so",
        "lib/arm64-v8a/libapp.so",
        "lib/x86_64/libapp.so",
    ],
    version_code = 1,
    version_name = "1.0.0",
)

# The app bundle of the release build: the code and the Dart program in the base module, the baseline
# profile and the mapping file as metadata, signed with the debug key as the stock build signs it.
flutter_android_bundle_test(
    name = "app_release_bundle_test",
    absent_entries = [
        "base/assets/flutter_assets/kernel_blob.bin",
        "base/assets/dexopt/**",
    ],
    app = "app_release",
    entries = [
        "base/dex/classes2.dex",
        "base/lib/armeabi-v7a/libapp.so",
        "base/lib/arm64-v8a/libapp.so",
        "base/lib/x86_64/libflutter.so",
        "base/assets/flutter_assets/AssetManifest.bin",
        "base/root/META-INF/com/android/build/gradle/app-metadata.properties",
        "BUNDLE-METADATA/com.android.tools.build.obfuscation/proguard.map",
        "BUNDLE-METADATA/com.android.tools.build.profiles/baseline.prof",
        "BUNDLE-METADATA/com.android.tools/r8.json",
    ],
)
