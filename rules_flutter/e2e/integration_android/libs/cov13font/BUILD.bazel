load("@rules_flutter//flutter:defs.bzl", "flutter_library")

# The package-provided font family the Android integration test renders,
# declared in this package's pubspec. The bytes are the same glyphless fixture
# `//e2e/hello_world` uses, so the test asserts on the resolved family and the
# bundled asset, not on glyph shapes.
flutter_library(
    name = "cov13font",
    package_name = "cov13font",
    srcs = ["lib/cov13font.dart"],
    data = [
        "fonts/Cov13Sans-Regular.ttf",
        "pubspec.yaml",
    ],
    visibility = ["//visibility:public"],
)
