    "deps__google_mlkit_commons",
    "deps__google_sign_in_ios",
    "deps__image_picker_ios",
    "deps__permission_handler_apple",
    "deps__sentry_flutter",
    "deps__stripe_ios",
    "deps__url_launcher_ios",
    "deps__webview_flutter_wkwebview",
    "deps_pods",
    "deps_pods__cloud_firestore",
    "deps_pods__firebase_auth",
    "deps_pods__firebase_core",
    "deps_pods__firebase_messaging",
    "deps_pods__flutter_inappwebview_ios",
    "deps_pods__google_maps_flutter_ios",
    "deps_pods__google_mlkit_commons",
    "deps_pods__google_sign_in_ios",
    "deps_pods__image_picker_ios",
    "deps_pods__permission_handler_apple",
