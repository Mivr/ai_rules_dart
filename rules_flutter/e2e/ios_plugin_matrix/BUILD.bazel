# The matrix workspace has no product targets. What each pinned plugin's spoke
# does on Linux (queries that pass, refusals where an Apple build reaches
# them) is asserted by e2e.yaml; the macOS leg builds the spoke device
# libraries with run_matrix.py and run_pods_matrix.py, whose self-tests run
# here. The lock is exported so `flutter.pub` can read it, and the build test
# keeps `bazel test //...` meaningful in this workspace.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "Podfile.lock",
    "pubspec.lock",
])

filegroup(
    name = "mapped_apple_deps",
    visibility = ["//visibility:public"],
)

build_test(
    name = "workspace_test",
    targets = [
        "//:Podfile.lock",
        "//:pubspec.lock",
    ],
)

sh_test(
    name = "run_matrix_test",
    size = "small",
    srcs = ["run_matrix.py"],
    args = ["--self-test"],
)

sh_test(
    name = "run_pods_matrix_test",
    size = "small",
    srcs = ["run_pods_matrix.py"],
    args = ["--self-test"],
)

test_suite(
    name = "self_test",
    tests = [
        ":run_matrix_test",
        ":run_pods_matrix_test",
    ],
)

test_suite(
    name = "run_pods_matrix_self_test",
    tests = [":run_pods_matrix_test"],
)
