# The wrong-library stub: provides a minimal BigInt module whose APIs return
# deliberately wrong values, so `:plugin_pod_wrong_test` fails its runtime
# assertion and proves `ios_pod_deps` controls what `pod_bigint_plugin` links.
swift_library(
    name = "wrong_bigint_stub",
    srcs = ["wrong_bigint_stub.swift"],
    module_name = "BigInt",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The product `deps_mapped` points at: a Bazel-built Swift library group over
# the translated BigInt product. The mapped hub carries no pin, checksum or
# resolved file, so the plugin's `BigInt` dependency reaches this target.
swift_library_group(
    name = "bigint_product",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@deps__swiftpm-bigint//:BigInt"],
)

# The generated localizations `:app_test` compiles into the app and renders
# under `Locale('es')`, so an iOS-only regression in gen-l10n output or in the
# `output_class` / `nullable_getter` options fails the simulator run.
flutter_gen_l10n(
    name = "app_l10n",
    arbs = [
        "lib/l10n/app_en.arb",
        "lib/l10n/app_es.arb",
    ],
    nullable_getter = False,
    output_class = "Cov79Localizations",
)

