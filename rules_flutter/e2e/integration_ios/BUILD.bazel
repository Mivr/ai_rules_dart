    tags = ["manual"],
    deps = [
        "//android_only_plugin",
        "//dart_registration_plugin",
        "//ffi_plugin",
        "//ios_greeting_plugin",
        "//xcframework_plugin",
        "@deps//:flutter",
        "@deps//:flutter_localizations",
        "@deps//:flutter_test",
        "@deps//:integration_test",
        "@deps//:intl",
        "@rules_flutter//flutter:material_icons",
    ],
)

