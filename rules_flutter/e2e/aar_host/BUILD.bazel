load("@android_model//:defs.bzl", "flutter_android_app")
load("@rules_dart//dart:defs.bzl", "dart_test")
load("@rules_flutter//flutter:android.bzl", "flutter_android_aar", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application")

exports_files(["pubspec.lock"])

flutter_application(
    name = "module",
    srcs = ["lib/main.dart"],
    main = "lib/main.dart",
    deps = [
        "@deps//:flutter",
    ],
)

# The Flutter module as an AAR: the AOT library and flutter_assets.
flutter_android_aar(
    name = "module_aar",
    package_name = "com.example.module",
    android_abi = "x86_64",
    application = ":module",
)

# `bazel run //:android_pin` writes android_model.json from the host's Gradle project.
flutter_android_pin(
    name = "android_pin",
    variants = ["release"],
)

# The native host app, built from the pin, carrying the module's AAR.
flutter_android_app(
    name = "host_app",
    aars = [":module_aar"],
    variant = "release",
)

dart_test(
    name = "verify_aar_host_test",
    size = "medium",
    srcs = ["test/verify_aar_host_test.dart"],
    data = [
        ":host_app_apk",
        "@flutter_android_headless_runtime//:adb",
        "@flutter_android_headless_runtime//:all_files",
        "@flutter_android_headless_runtime//:emulator",
    ],
    env = {
        "ADB_RLOCATION": "$(rlocationpath @flutter_android_headless_runtime//:adb)",
        "EMULATOR_RLOCATION": "$(rlocationpath @flutter_android_headless_runtime//:emulator)",
        "HOST_APK_RLOCATIONS": "$(rlocationpaths :host_app_apk)",
    },
    main = "test/verify_aar_host_test.dart",
    tags = [
        "exclusive",
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@rules_dart//dart/runfiles",
    ],
)
