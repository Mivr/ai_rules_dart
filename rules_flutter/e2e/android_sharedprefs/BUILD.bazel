"""E2e: an Android app on `shared_preferences` registers its Android plugin in both registrants."""

load("@android_model//:defs.bzl", "flutter_android_apk_test", "flutter_android_app")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")
load("@rules_flutter//flutter:android.bzl", "flutter_android_bundle", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library")
load(":dart_registrant.bzl", "android_dart_registrant")

exports_files(["pubspec.lock"])

flutter_application(
    name = "app_flutter",
    package_name = "android_sharedprefs",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    deps = [
        "@deps//:flutter",
        "@deps//:shared_preferences",
    ],
)

# `bazel run //:android_pin` writes android_model.json from the app's Android project.
flutter_android_pin(
    name = "android_pin",
    variants = ["debug"],
)

# The debug app. Its Java registrant is the one the Flutter tool wrote when the model was pinned.
flutter_android_app(
    name = "app_android",
    application = ":app_flutter",
    # package:jni builds libdartjni.so with CMake in Gradle; here the Dart side builds it.
    native_built_elsewhere = [":jni"],
)

# The Android `GeneratedPluginRegistrant` and the plugin class it registers are in the APK.
flutter_android_apk_test(
    name = "app_apk_test",
    app = "app_android",
    classes = [
        "Lio/flutter/plugins/GeneratedPluginRegistrant;",
        "Lio/flutter/plugins/sharedpreferences/SharedPreferencesPlugin;",
    ],
)

# The app's Dart payload in the Android configuration, as the app above packages it.
flutter_android_bundle(
    name = "app_payload",
    application = ":app_flutter",
)

# The Android-configured Dart registrant `generate_dart_plugin_registrant` writes.
android_dart_registrant(
    name = "app_dart_registrant",
    bundle = ":app_payload",
)

build_test(
    name = "android_registrant_build_test",
    size = "small",
    targets = [":app_dart_registrant"],
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

flutter_library(
    name = "app_lib",
    package_name = "android_sharedprefs",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
        "@deps//:shared_preferences",
    ],
)

# Reads the generated Dart plugin registrant and fails unless `shared_preferences_android` is
# registered in it. (`:app_apk_test` checks the Java side in the APK.)
dart_test(
    name = "registrants_test",
    size = "small",
    data = [
        ":app_dart_registrant",
    ],
    main = "test/registrants_test.dart",
)
