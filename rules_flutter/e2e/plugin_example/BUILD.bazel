# =============================================================================
# Android build
#
# The app's Android side is its stock Android project (android/), built from
# the pinned Gradle model: `bazel run //:android_pin` writes
# android_model.json. Every Android plugin of the pubspec is one library
# target from its own Gradle project, on the Maven graph Gradle resolved.
# =============================================================================

flutter_android_pin(
    name = "android_pin",
    variants = [
        "debug",
        "release",
    ],
)

# `//:plugin_android` is the debug app as split APKs, `//:plugin_android_apk` as one APK.
flutter_android_app(
    name = "plugin_android",
    application = ":plugin_app",
    # package:jni builds libdartjni.so with CMake in Gradle; here the Dart side builds it.
    native_built_elsewhere = [":jni"],
)

# The release app: R8 over the whole program with the app's and the plugins' keep rules.
flutter_android_app(
    name = "plugin_android_release",
    abis = [
        "arm64-v8a",
        "x86_64",
    ],
    application = ":plugin_app",
    native_built_elsewhere = [":jni"],
    variant = "release",
)

