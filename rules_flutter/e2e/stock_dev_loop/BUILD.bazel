load("@android_model//:defs.bzl", "flutter_android_app")
load("@rules_flutter//flutter:android.bzl", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_gen_l10n", "flutter_test")
load(
    "@rules_flutter//flutter:linux.bzl",
    "flutter_linux_bundle",
    "flutter_linux_engine",
    "flutter_linux_registrant_gen",
    "flutter_linux_runner_lib_gen",
)

exports_files(["pubspec.lock"])

# The generated source: gen-l10n output exists only under bazel-bin, at the
# path stock `flutter gen-l10n` would write it to (lib/l10n/).
flutter_gen_l10n(
    name = "l10n",
    arbs = glob(["lib/l10n/*.arb"]),
)

flutter_application(
    name = "app_flutter",
    package_name = "counter",
    srcs = glob(
        ["lib/**/*.dart"],
        exclude = ["lib/l10n/app_localizations*.dart"],
    ) + [":l10n"],
    main = "lib/main.dart",
    pub_packages = "@deps//packages",
    deps = [
        # The debug agent (`ext.rules_flutter.*`): scripts drive the running app with it through
        # the stock tool's `app.callServiceExtension`. It registers in debug builds only; its
        # `package:flutter` is named in .bazelrc.
        "@rules_flutter//flutter/debug_agent",
        "//packages/counter_lib",
        "//packages/counter_plugin",
        "@deps//:flutter",
        "@deps//:flutter_localizations",
        "@deps//:intl",
        "@deps//:path_provider",
    ],
)

# The same test `flutter test` runs.
flutter_test(
    name = "widget_test",
    package_name = "counter",
    size = "small",
    main = "test/widget_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//packages/counter_lib",
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

# Android from the stock project in `android/`: `bazel run //:android_pin` has Gradle describe it once
# (android_model.json), and the app's own Kotlin code, its manifests, resources, version and plugins
# come from there.
flutter_android_pin(name = "android_pin")

# `:android` is the split APKs; `:android_apk` the whole APK, which is what stock
# `flutter run --use-application-binary` takes. x86_64 only, for the emulator image on this host.
flutter_android_app(
    name = "android",
    abis = ["x86_64"],
    application = ":app_flutter",
    # package:jni builds libdartjni.so with CMake in Gradle; here the Dart side builds it.
    native_built_elsewhere = [":jni"],
)

alias(
    name = "app_x64",
    actual = ":android_apk",
)

# Linux desktop bundle with the rules' own runner and sysroot. The flutter-create
# runner in `linux/` (3.47.7) includes <gdk/gdkx.h>, which needs X11 headers the
# rules' sysroot does not ship, so `flutter_linux_app` cannot build it here.
flutter_linux_engine(
    name = "linux_engine",
    target_compatible_with = ["@platforms//os:linux"],
)

flutter_linux_registrant_gen(
    name = "linux_registrant",
    application = ":app_flutter",
    target_compatible_with = ["@platforms//os:linux"],
)

flutter_linux_runner_lib_gen(
    name = "linux_runner",
    engine = ":linux_engine",
    gtk_app_id = "dev.rdf.counter",
    registrant = ":linux_registrant",
    target_compatible_with = ["@platforms//os:linux"],
    window_title = "counter",
)

flutter_linux_bundle(
    name = "app_linux",
    application = ":app_flutter",
    runner = ":linux_runner",
    target_compatible_with = ["@platforms//os:linux"],
)
