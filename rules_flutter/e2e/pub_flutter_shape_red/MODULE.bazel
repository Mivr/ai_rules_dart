"""Pubspec-shape red path: malformed pubspecs must fail the fetch.

The `bad_sdk` path package declares `environment.sdk: "3.10"` (a string
pub_semver refuses), and the `bad_sdk_type` path package declares a
non-string `environment.sdk: 3.5`. The spec fetches each spoke, expects
each fetch to fail, and checks the exact refusal. They guard the
fail-closed projection in `flutter_pub_package.bzl`: a projection that
derived a default language version for a bad constraint would bundle the
package with a green build, so only these red paths would turn red.
Malformed `flutter.assets` and font weights are no longer refused at fetch:
the Flutter tool's own asset code reads them while bundling an app.
"""

module(name = "rules_flutter_pub_shape_red")

bazel_dep(name = "ai_rules_flutter", version = "0.0.0", repo_name = "rules_flutter")
bazel_dep(name = "ai_rules_dart", version = "0.31.0", repo_name = "rules_dart")

local_path_override(
    module_name = "ai_rules_flutter",
    path = "../..",
)

local_path_override(
    module_name = "ai_rules_dart",
    path = "../../../rules_dart",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.pub(
    name = "red_deps",
    lock = "//:pubspec.lock",
)
use_repo(flutter, "red_deps")
