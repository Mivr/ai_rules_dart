# This is the target rule authors should put in their "toolchains"
# attribute in order to get a runtime for the correct platform.
# See https://docs.bazel.build/versions/main/toolchains.html#writing-rules-that-use-toolchains
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# Public aliases for the optional lazy sub-toolchain types consumed via
# `resolve_flutter_sdk_info(ctx)`.
alias(
    name = "product_tools_toolchain_type",
    actual = "//flutter/private:product_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

alias(
    name = "aot_toolchain_type",
    actual = "//flutter/private:aot_toolchain_type",
    visibility = ["//visibility:public"],
)

