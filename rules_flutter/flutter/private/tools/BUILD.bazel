# or run for several seconds get a `medium` budget; every other tool test is a
# pure, hermetic function check and stays `small`.
_MEDIUM_TESTS = [
    "android_bundle_test",
    "compile_shader_test",
    "const_finder_test",
    "flutter_integration_test_ios_test",
    "flutter_integration_test_runner_test",
    "flutter_test_runner_test",
    "generate_asset_manifest_test",
    "kernel_filter_test",
    "macho_edit_test",
    "macho_section_type_test",
    "run_home_test",
    "xtool_pack_test",
]

[dart_test(
    name = name,
    size = "medium" if name in _MEDIUM_TESTS else "small",
    srcs = [tool] + _TOOL_SRCS.get(tool, []),
    data = _TEST_DATA.get(name, []),
    env = _TEST_ENV.get(name, {}),
    main = "test/%s.dart" % name,
    target_compatible_with = HOST_COMPATIBLE,
    deps = ["@dev_tool_deps//:test"] + extra_deps,
) for name, (tool, extra_deps) in _UNIT_TESTS.items()]

# Pins the bytes `android_bundle`, `kernel_filter` and `macho_edit` write as
# native executables to what their kernel builds wrote for the same input.
dart_test(
    name = "native_exe_output_test",
    size = "medium",
    srcs = ["sha256.dart"],
    data = [
        ":android_bundle",
        ":kernel_filter",
        ":macho_edit",
    ],
    env = {
        "ANDROID_BUNDLE": "$(rlocationpath :android_bundle)",
        "KERNEL_FILTER": "$(rlocationpath :kernel_filter)",
        "MACHO_EDIT": "$(rlocationpath :macho_edit)",
    },
    main = "test/native_exe_output_test.dart",
    target_compatible_with = HOST_COMPATIBLE,
    deps = ["@dev_tool_deps//:test"],
)

