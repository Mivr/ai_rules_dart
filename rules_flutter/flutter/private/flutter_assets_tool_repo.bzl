"""The repository holding the source closure the asset tool is built from.

`flutter_assets_tool_repo` stages, for one Flutter version:

- `packages/flutter_tools/lib/`, copied out of the release's one shared source
  extraction (`flutter_sdk_source_repo`, pinned by `source_sha256`), or out of
  a local SDK;
- the framework's own shaders, `packages/flutter/lib/src/*/shaders/*.frag`,
  which the tool bundles into every app;
- every hosted package the tool's import closure reaches, each from its
  pinned pub.dev archive (`flutter_assets_tool_versions.bzl`).

Its `BUILD.bazel` names the closure as one `flutter_assets_tool_sources`
target, which the engine repository's `flutter_assets_tool` compiles with the
Dart SDK bundled in that Flutter release.
"""

load("//flutter/private:download.bzl", "pinned_download_and_extract")
load("//flutter/private:flutter_assets_tool_versions.bzl", "FLUTTER_ASSETS_TOOL_SOURCES")
load("//flutter/private:flutter_sky_engine_repo.bzl", "list_local_files")
load("//flutter/private:local_sdk.bzl", "read_local_sdk_version", "resolve_local_sdk_root")
load("//flutter/private:repo_metadata.bzl", "download_mode_metadata")

visibility(["//flutter/..."])

# What the tool reads of the Flutter source tree, beside its own `lib/`.
_FRAMEWORK_SHADER_DIRS = [
    "packages/flutter/lib/src/material/shaders",
    "packages/flutter/lib/src/widgets/shaders",
]

def _copy_tree(repository_ctx, source_root, rel, what):
    """Copies the files under `source_root/rel` to `rel`, as repo-owned files."""
    source = source_root.get_child(rel)
    if not source.exists:
        fail("{}: the Flutter source has no {} ({})".format(repository_ctx.name, rel, what))
    for file in list_local_files(source, what, str(source)):
        repository_ctx.file(rel + "/" + file, repository_ctx.read(source.get_child(file)), executable = False)

def _flutter_assets_tool_repo_impl(repository_ctx):
    version = repository_ctx.attr.flutter_version
    if repository_ctx.attr.local_path:
        source_root = resolve_local_sdk_root(repository_ctx, repository_ctx.attr.local_path)
        version = read_local_sdk_version(repository_ctx, source_root).flutter_version
        repository_ctx.watch_tree(source_root.get_child("packages/flutter_tools/lib"))
    else:
        source_root = repository_ctx.path(repository_ctx.attr.sdk_source).dirname
    pin = FLUTTER_ASSETS_TOOL_SOURCES.get(version)
    if pin == None:
        # A BUILD file that fails only when the tool is built, so a workspace
        # that never bundles assets still loads.
        repository_ctx.file("BUILD.bazel", """\
# Generated by rules_flutter's flutter_assets_tool_repo.bzl
load("@rules_flutter//flutter:toolchain.bzl", "flutter_assets_tool_sources")

flutter_assets_tool_sources(
    name = "sources",
    unsupported_version = {version},
    visibility = ["//visibility:public"],
)
""".format(version = repr(version)))
        return download_mode_metadata(repository_ctx)

    _copy_tree(repository_ctx, source_root, "packages/flutter_tools/lib", "the flutter_tools sources")
    for rel in _FRAMEWORK_SHADER_DIRS:
        _copy_tree(repository_ctx, source_root, rel, "the framework shaders")
    packages = {"flutter_tools": "packages/flutter_tools|" + pin.flutter_tools_language_version}
    for name, package in pin.packages.items():
        pinned_download_and_extract(
            repository_ctx,
            url = "https://pub.dev/api/archives/%s-%s.tar.gz" % (name, package.version),
            sha256 = package.sha256,
            output = "pub/" + name,
        )

        # Only `lib/` is compiled; the rest of the archive is not an input.
        for entry in repository_ctx.path("pub/" + name).readdir():
            if entry.basename != "lib":
                repository_ctx.delete(entry)
        packages[name] = "pub/%s|%s" % (name, package.language_version)

    repository_ctx.file("BUILD.bazel", """\
# Generated by rules_flutter's flutter_assets_tool_repo.bzl
load("@rules_flutter//flutter:toolchain.bzl", "flutter_assets_tool_sources")

flutter_assets_tool_sources(
    name = "sources",
    srcs = glob(["packages/flutter_tools/lib/**/*.dart", "pub/*/lib/**/*.dart"]),
    framework_shaders = glob(["packages/flutter/lib/src/*/shaders/*.frag"]),
    packages = {packages},
    service_worker = "packages/flutter_tools/lib/src/web/file_generators/js/flutter_service_worker.js",
    visibility = ["//visibility:public"],
)
""".format(packages = repr(packages)))
    return download_mode_metadata(repository_ctx)

flutter_assets_tool_repo = repository_rule(
    implementation = _flutter_assets_tool_repo_impl,
    doc = "Stages the pinned source closure the asset tool of one Flutter version is built from.",
    attrs = {
        "flutter_version": attr.string(
            doc = "The Flutter version; a key of `FLUTTER_ASSETS_TOOL_SOURCES`. Empty with `local_path`.",
            default = "",
        ),
        "sdk_source": attr.label(
            doc = "The `flutter_sdk_source_repo` extraction of this Flutter version (its `BUILD.bazel`). Unused with `local_path`.",
            allow_single_file = True,
        ),
        "local_path": attr.string(
            doc = "A pre-extracted Flutter SDK to take `flutter_tools` from instead of the source tarball.",
            default = "",
        ),
    },
)
