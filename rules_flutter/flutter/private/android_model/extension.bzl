"""Repositories from the pinned Gradle model (`android_model.json`).

    android_model = use_extension("@rules_flutter//flutter:android.bzl", "android_model")
    android_model.pin(model = "//:android_model.json")
    use_repo(android_model, "android_model")
    register_toolchains("@android_model//:kotlin_toolchain")

The pin file is written by Gradle (`bazel run //:android_pin`, see `flutter_android_pin`) and read here
with `json.decode`. No Gradle file is read by the rules. One repository is made per Maven artifact
(fetched by the sha256 the pin records; an AAR is unpacked at fetch time) and one hub per pin, which
holds the plugin sources (the pub archives, by the hash pub recorded) and the generated targets.
"""

load("@rules_dart//dart/pub:yaml.bzl", "yaml_to_json")
load("//flutter/private:download.bzl", "pinned_download", "pinned_download_and_extract")
load(":names.bzl", "SCHEMA", "artifact_repo")

# Without a usable pin the hub still loads, so that `bazel run //:android_pin` can run in the package
# that calls `flutter_android_app`; the app's targets fail when they are built, with the reason.
_STUB = """# Generated by rules_flutter: {reason}
load("@rules_flutter//flutter/private/android_model:rules.bzl", "rdf_unsupported")

def flutter_android_app(name, visibility = None, **kwargs):
    for target in (name, name + "_apk", name + "_install"):
        rdf_unsupported(name = target, message = {message}, visibility = visibility)

def flutter_android_apk_test(name, **kwargs):
    rdf_unsupported(name = name, message = {message}, testonly = True)
"""

def _shown(label):
    """A label as a user writes it."""
    text = str(label)
    return text[2:] if text.startswith("@@//") else text

def _maven_artifact_impl(ctx):
    f = ctx.attr.file
    if f.endswith(".aar"):
        pinned_download_and_extract(ctx, url = ctx.attr.urls, sha256 = ctx.attr.sha256, output = "aar", type = "zip")
        jars = (["aar/classes.jar"] if ctx.attr.aar_classes else []) + ["aar/" + j for j in ctx.attr.aar_libs]

        # The symbol list is optional in an AAR; the rules read it by label, so it always exists here.
        if not ctx.path("aar/R.txt").exists:
            ctx.file("aar/R.txt", "")
        ctx.file("BUILD.bazel", """package(default_visibility = ["//visibility:public"])
filegroup(name = "jar", srcs = {jars})
filegroup(name = "res", srcs = glob(["aar/res/**"], allow_empty = True))
filegroup(name = "assets", srcs = glob(["aar/assets/**"], allow_empty = True))
filegroup(name = "native_libs", srcs = glob(["aar/jni/**/*.so"], allow_empty = True))
exports_files(glob(["aar/*"], exclude_directories = 1))
""".format(jars = repr(jars)))
    else:
        pinned_download(ctx, url = ctx.attr.urls, sha256 = ctx.attr.sha256, output = "file/" + f, executable = False)
        extra = ""
        if ctx.attr.extract:
            ctx.extract("file/" + f, output = "x", type = "zip")
            extra = """filegroup(name = "native_libs", srcs = glob(["x/lib/**/*.so"], allow_empty = True))
exports_files({exe})
""".format(exe = repr(["x/" + e for e in ctx.attr.executables + ctx.attr.exports]))
            if "windows" not in ctx.os.name.lower():
                for e in ctx.attr.executables:
                    ctx.execute(["chmod", "+x", "x/" + e])
        ctx.file("BUILD.bazel", """package(default_visibility = ["//visibility:public"])
filegroup(name = "jar", srcs = ["file/{f}"])
{extra}""".format(f = f, extra = extra))

maven_artifact = repository_rule(
    doc = "One Maven artifact of the pin, by its sha256.",
    implementation = _maven_artifact_impl,
    attrs = {
        "aar_classes": attr.bool(),
        "aar_libs": attr.string_list(),
        "executables": attr.string_list(),
        "exports": attr.string_list(),
        "extract": attr.bool(),
        "file": attr.string(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "urls": attr.string_list(mandatory = True),
    },
)

def _host(os):
    name = os.name.lower()
    arch = os.arch.lower()
    if "windows" in name:
        return struct(os = "windows", ndk = "windows-x86_64", exe = ".exe")
    if "mac" in name or "darwin" in name:
        # The NDK ships one universal host directory on macOS.
        return struct(os = "osx", ndk = "darwin-x86_64", exe = "")
    if arch not in ("amd64", "x86_64"):
        fail("android_model: the Android SDK has no build tools for Linux on %s" % arch)
    return struct(os = "linux", ndk = "linux-x86_64", exe = "")

def _pub_source_dirs(model):
    """Per pub package: the directories (relative to the package) the model reads sources from."""
    dirs = {}

    def add(rooted):
        if not rooted.startswith("pub:hosted/"):
            return
        parts = rooted[len("pub:hosted/"):].split("/", 2)
        dirs.setdefault(parts[1], {})[parts[2] if len(parts) > 2 else ""] = True

    for p in model["projects"].values():
        add(p["dir"])
        for v in p["variants"].values():
            for paths in v["sources"].values():
                for d in paths:
                    add(d)
    return dirs

def _drop_build_files(ctx, root):
    """Removes BUILD files under `root`, so that the hub's globs see the whole directory."""
    todo = [ctx.path(root)]
    for _ in range(100000):
        if not todo:
            break
        d = todo.pop()
        if not d.exists or not d.is_dir:
            continue
        for child in d.readdir():
            if child.is_dir:
                todo.append(child)
            elif child.basename in ("BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel", "MODULE.bazel", "REPO.bazel"):
                ctx.delete(child)

def _pubspec_version(ctx):
    """The `version` of the app's pubspec.yaml, or None."""
    if not ctx.attr.pubspec:
        return None
    path = ctx.path(ctx.attr.pubspec)
    if not path.exists:
        return None
    ctx.watch(path)
    version = yaml_to_json(ctx, [path], [_shown(ctx.attr.pubspec)])[0].get("version")
    return str(version) if version != None else None

def _stub(ctx, reason, message):
    ctx.file("BUILD.bazel", """# Generated by rules_flutter: %s
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain")

# The toolchain MODULE.bazel registers must exist before the first pin.
define_kt_toolchain(name = "kotlin_toolchain", experimental_use_abi_jars = True)
""" % reason)
    ctx.file("defs.bzl", _STUB.format(reason = reason, message = repr(message)))

def _hub_impl(ctx):
    pin = "bazel run //%s:%s" % (ctx.attr.model.package, ctx.attr.pin_target)
    model_path = ctx.path(ctx.attr.model)
    ctx.watch(model_path)
    text = ctx.read(model_path) if model_path.exists else ""
    model = json.decode(text) if text.strip() else {}
    if not model:
        _stub(ctx, "no pin", "%s does not exist or is empty. Write it with Gradle: `%s`, and check it in." % (_shown(ctx.attr.model), pin))
        return
    if model.get("schema") != SCHEMA:
        _stub(ctx, "old pin", "%s has schema %s and these rules read schema %s. Pin again: `%s`." % (_shown(ctx.attr.model), model.get("schema"), SCHEMA, pin))
        return

    sdk = ctx.getenv("ANDROID_HOME") or ctx.getenv("ANDROID_SDK_ROOT")
    if not sdk:
        fail("android_model: ANDROID_HOME is not set. The build takes android.jar and the NDK's llvm-strip from the Android SDK (pass --repo_env=ANDROID_HOME=<sdk>).")
    host = _host(ctx.os)
    missing = []
    ndks = {}
    for p in model["projects"].values():
        if not ctx.path("%s/platforms/%s/android.jar" % (sdk, p["compile_sdk"])).exists:
            missing.append("platforms;" + p["compile_sdk"])
        if p["type"] == "application":
            ndks[p["ndk_version"]] = True
    for ndk in ndks:
        if not ctx.path("%s/ndk/%s/toolchains/llvm/prebuilt/%s/bin/llvm-strip%s" % (sdk, ndk, host.ndk, host.exe)).exists:
            missing.append("ndk;" + ndk)
    if missing:
        fail("android_model: %s lacks %s. Install with: sdkmanager %s" % (sdk, ", ".join(sorted({m: 1 for m in missing})), " ".join(['"%s"' % m for m in sorted({m: 1 for m in missing})])))
    ctx.symlink(sdk + "/platforms", "sdk/platforms")
    ctx.symlink(sdk + "/ndk", "sdk/ndk")

    # Plugin sources: the pub archives, by the hash pub recorded in its cache at pin time.
    for nv, dirs in _pub_source_dirs(model).items():
        rec = model["pub_packages"][nv]
        root = "pub/hosted/%s/%s" % (rec["host"].replace("/", "%47"), nv)
        host_url = rec["host"] if "://" in rec["host"] else "https://" + rec["host"]
        pinned_download_and_extract(
            ctx,
            url = "%s/api/archives/%s.tar.gz" % (host_url.rstrip("/"), nv),
            sha256 = rec["sha256"],
            output = root,
            type = "tar.gz",
        )
        for d in dirs:
            _drop_build_files(ctx, root + "/" + d if d else root)

    # Projects of the Bazel workspace other than the app (a library module of the app, a plugin
    # under development): the hub links their directories, so that they build like any plugin and
    # an edit there is seen.
    app_dir = ctx.attr.model.package
    for p in model["projects"].values():
        root, _, rel = p["dir"].partition(":")
        if p["type"] == "application" or root not in ("app", "ws"):
            continue
        if root == "app" and app_dir:
            rel = app_dir + "/" + rel
        if not ctx.path("ws/" + rel).exists:
            ctx.symlink(ctx.path(str(ctx.workspace_root) + "/" + rel), "ws/" + rel)

    info = {
        "app_dir": app_dir,
        "exe": host.exe,
        "host_os": host.os,
        "model_label": _shown(ctx.attr.model),
        "ndk_host": host.ndk,
        "pin_command": pin,
        "pubspec_version": _pubspec_version(ctx),
    }
    ctx.file("model.bzl", "MODEL = " + repr(model) + "\nINFO = " + repr(info) + "\n")
    ctx.file("BUILD.bazel", """load("@rules_flutter//flutter/private/android_model:targets.bzl", "android_model_hub_targets")
load(":model.bzl", "INFO", "MODEL")

package(default_visibility = ["//visibility:public"])

android_model_hub_targets(name = "hub", model = MODEL, info = INFO)
""")
    ctx.file("defs.bzl", """load("@rules_flutter//flutter/private/android_model:targets.bzl", "android_model_app")
load("@rules_flutter//flutter/private/android_model/testing:apk_test.bzl", "android_apk_test")
load(":model.bzl", "INFO", "MODEL")

_HUB = str(Label("//:BUILD.bazel")).removesuffix("BUILD.bazel")

def flutter_android_app(name, **kwargs):
    android_model_app(name = name, model = MODEL, info = INFO, hub = _HUB, **kwargs)

def flutter_android_apk_test(name, **kwargs):
    android_apk_test(name = name, hub = _HUB, **kwargs)
""")

android_model_hub = repository_rule(
    doc = "The targets of one pin: plugin projects, Maven imports, AGP's tools, and the app macro.",
    implementation = _hub_impl,
    attrs = {
        "model": attr.label(mandatory = True),
        "pin_target": attr.string(mandatory = True),
        "pubspec": attr.label(),
    },
    environ = ["ANDROID_HOME", "ANDROID_SDK_ROOT"],
)

def _android_model_impl(mctx):
    artifacts = {}
    for mod in mctx.modules:
        for pin in mod.tags.pin:
            path = mctx.path(pin.model)
            mctx.watch(path)
            text = mctx.read(path) if path.exists else ""
            model = json.decode(text) if text.strip() else {}
            if model.get("schema") == SCHEMA:
                for key, a in model["artifacts"].items():
                    known = artifacts.get(key)
                    if known and known["sha256"] != a["sha256"]:
                        fail("android_model: %s has the sha256 %s in one pin and %s in another" % (key, known["sha256"], a["sha256"]))
                    artifacts[key] = a
            android_model_hub(
                name = pin.name,
                model = pin.model,
                pin_target = pin.pin_target,
                pubspec = pin.pubspec or pin.model.same_package_label("pubspec.yaml"),
            )
    for key, a in artifacts.items():
        aar = a.get("aar")
        is_aapt2 = a["coordinate"].startswith("com.android.tools.build:aapt2:")
        is_desugar_config = a["coordinate"].startswith("com.android.tools:desugar_jdk_libs_configuration:")
        maven_artifact(
            name = artifact_repo(key),
            urls = a["urls"],
            sha256 = a["sha256"],
            file = key.rsplit("/", 1)[1],
            aar_classes = bool(aar and aar["classes"]),
            aar_libs = aar["libs"] if aar else [],
            extract = bool(a.get("native_libs")) or is_aapt2 or is_desugar_config,
            executables = ["aapt2"] if is_aapt2 else [],
            exports = (["aapt2.exe"] if is_aapt2 else []) + (["META-INF/desugar/d8/desugar.json"] if is_desugar_config else []),
        )
    return mctx.extension_metadata(reproducible = True)

android_model = module_extension(
    doc = "Builds a Flutter app's Android side from a pin file that Gradle wrote.",
    implementation = _android_model_impl,
    tag_classes = {
        "pin": tag_class(
            doc = "One app's pin file. The repository `name` holds `defs.bzl` with `flutter_android_app`.",
            attrs = {
                "model": attr.label(mandatory = True, doc = "The pin file, written by `bazel run //:android_pin` and checked in."),
                "name": attr.string(default = "android_model"),
                "pin_target": attr.string(default = "android_pin", doc = "Name of the `flutter_android_pin` target in the model's package; error messages name it."),
                "pubspec": attr.label(doc = "The app's pubspec.yaml; by default the one beside the model."),
            },
        ),
    },
)
