load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")
load(":repo_name.bzl", "RULES_FLUTTER_REPO")

# flutter_dev: Bazel builds the app, the stock `flutter` tool runs it (README.md).
# It replaces `//tools/dev_tool:flutter_bazel` once that is deleted.

# The canonical name of this repository, by which the tool names the rules' aspect.
write_file(
    name = "repo_name",
    out = "lib/src/repo_name.dart",
    content = [
        "/// The canonical name of the repository of the rules (generated by the BUILD file).",
        "const String rulesFlutterRepo = '%s';" % RULES_FLUTTER_REPO,
        "",
    ],
)

_SRCS = glob(["lib/**/*.dart"]) + [":repo_name"]

dart_library(
    name = "lib",
    package_name = "flutter_dev",
    srcs = _SRCS,
    visibility = ["//visibility:private"],
)

dart_binary(
    name = "flutter_dev",
    package_name = "flutter_dev",
    srcs = _SRCS,
    compile_mode = "exe",
    main = "bin/flutter_dev.dart",
    visibility = ["//visibility:public"],
)

_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

[dart_test(
    name = name,
    size = "small",
    main = "test/%s.dart" % name,
    # It runs fake `bazel` and `flutter` executables, which it writes as shell scripts.
    target_compatible_with = _NOT_WINDOWS if name == "flutter_dev_test" else [],
    deps = [
        ":lib",
        "@tool_deps//:test",
    ],
) for name in [
    "build_events_test",
    "flutter_dev_test",
    "machine_proxy_test",
    "options_test",
    "project_files_test",
    "stock_tool_test",
]]
