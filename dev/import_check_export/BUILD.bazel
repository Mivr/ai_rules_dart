load(":defs.bzl", "outside_exe")

package(default_visibility = ["//visibility:private"])

# Built by `//dart/tests:import_check_export_test`. Imports only `package:dep`, which its `deps` provide: the check passes.
outside_exe(
    name = "clean",
    main = "clean/lib/main.dart",
    deps = ["//import_check_export/dep"],
)

# Imports `package:hidden`, which its `deps` do not provide: building it fails.
outside_exe(
    name = "bad",
    main = "bad/lib/main.dart",
    tags = ["manual"],
    deps = ["//import_check_export/dep"],
)

# Its own `main` is clean, but its dependency `//import_check_export/dep_bad` imports `package:hidden`, which that
# dependency's `deps` do not provide: building it fails only through `dart_import_check_aspect` on `deps`.
outside_exe(
    name = "bad_dep",
    main = "bad_dep/lib/main.dart",
    tags = ["manual"],
    deps = ["//import_check_export/dep_bad"],
)
