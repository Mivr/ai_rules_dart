load("@rules_dart//dart:defs.bzl", "dart_library")

# Its own source imports `package:hidden`, which its `deps` do not provide.
dart_library(
    name = "dep_bad",
    package_name = "dep_bad",
    srcs = ["lib/dep_bad.dart"],
    visibility = ["//import_check_export:__pkg__"],
)

# The entrypoint of `//import_check_export:bad_dep`, which is clean itself: it imports only `package:dep_bad`.
exports_files(
    ["bin/main.dart"],
    visibility = ["//import_check_export:__pkg__"],
)
