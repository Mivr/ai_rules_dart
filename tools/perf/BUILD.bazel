load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")

dart_library(
    name = "perf",
    package_name = "perf",
    srcs = glob(["lib/**/*.dart"]),
    visibility = ["//visibility:public"],
    deps = [
        "@rules_dart//dart/runfiles",
    ],
)

dart_binary(
    name = "generate",
    main = "bin/generate.dart",
    visibility = ["//visibility:public"],
    deps = [
        ":perf",
    ],
)

