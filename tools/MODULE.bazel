module(name = "rules_dart_tools")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_multitool", version = "1.11.1")

bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2", dev_dependency = True)

local_path_override(
    module_name = "ai_rules_dart",
    path = "..",
)

multitool = use_extension(
    "@rules_multitool//multitool:extension.bzl",
    "multitool",
)
multitool.hub(lockfile = "@rules_dart//:multitool.lock.json")
use_repo(multitool, "multitool")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Dev-only pub deps for the tools' own `dart_test` targets (`package:test`) and
# the `package:yaml` parser the e2e spec and coverage tools share. Pinned by
# //e2e_runner:pubspec.lock; resolved into @pub_deps so a `dart_test` here can
# depend on `test` and the binaries can depend on `yaml`.
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    # Isolated: the root module's `ext_pub_deps` pins `analyzer` and friends at
    # older versions than a fresh `test` resolution would choose; keeping this
    # hub out of the shared version resolution stops those upgrades.
    isolated = True,
    lock = "//e2e_runner:pubspec.lock",
)
use_repo(pub, "pub_deps")
