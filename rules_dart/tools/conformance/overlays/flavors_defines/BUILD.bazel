load("@android_model//:defs.bzl", "flutter_android_app")
load("@rules_flutter//flutter:android.bzl", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library", "flutter_test")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")

exports_files(["pubspec.lock"])

DEPS = [
    "@deps//:cupertino_icons",
    "@deps//:flutter",
    "@deps//:flutter_localizations",
    "@deps//:intl",
    "@deps//:path_provider",
    "@deps//:shared_preferences",
    "@deps//:url_launcher",
]

# Declared in pubspec.yaml and imported by no Dart file: the app carries them
# as plugins, the library does not.
PLUGINS = [
    "@deps//:firebase_core",
    "@deps//:firebase_messaging",
]

# The files pubspec.yaml names: what the asset bundle holds.
PUBSPEC_SRCS = glob(["assets/**"])

DEFINES = [
    "FLAVOR=prod",
    "API_URL=https://api.example.invalid",
    "RETRIES=5",
]

# All of `lib/`: `:app`, `:web` and the test take `lib/main.dart` from here.
flutter_library(
    name = "lib",
    package_name = "flavors_defines",
    srcs = glob(["lib/**/*.dart"]),
    deps = DEPS,
)

flutter_web_app(
    name = "web",
    package_name = "flavors_defines",
    compiler = "dart2js",
    defines = DEFINES,
    pubspec_srcs = PUBSPEC_SRCS,
    deps = [":lib"] + PLUGINS,
)

flutter_application(
    name = "app",
    package_name = "flavors_defines",
    defines = DEFINES,
    flavor = "dev",
    main = "lib/main.dart",
    pubspec_srcs = PUBSPEC_SRCS,
    deps = [":lib"] + PLUGINS,
)

flutter_android_pin(
    name = "android_pin",
    variants = ["devDebug"],
)

# `:android` is the split APKs of the dev flavor; the whole APK is what stock builds.
flutter_android_app(
    name = "android",
    application = ":app",
    # package:jni builds libdartjni.so with CMake in Gradle; here the Dart side builds it.
    native_built_elsewhere = [":jni"],
    variant = "devDebug",
)

alias(
    name = "apk",
    actual = ":android_apk",
)

# The test imports `package:flavors_defines/main.dart` through the library.
flutter_test(
    name = "widget_test",
    package_name = "flavors_defines",
    main = "test/widget_test.dart",
    pubspec = "pubspec.yaml",
    pubspec_srcs = PUBSPEC_SRCS,
    deps = [
        ":lib",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:shared_preferences",
    ],
)

flutter_linux_app(
    name = "linux",
    application = ":app",
    gtk_app_id = "dev.rdf.flavors_defines",
)
