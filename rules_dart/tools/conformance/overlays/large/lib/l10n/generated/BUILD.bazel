load("@rules_flutter//flutter:defs.bzl", "flutter_gen_l10n")

# `generate: true` and `l10n.yaml`: the rules do not read l10n.yaml, so its
# settings are restated here and the output lands where it names.
flutter_gen_l10n(
    name = "l10n",
    arbs = ["//lib/l10n:arbs"],
    nullable_getter = False,
    preferred_supported_locales = ["en"],
    visibility = ["//visibility:public"],
)
