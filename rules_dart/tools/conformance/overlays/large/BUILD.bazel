load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library", "flutter_test")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")

exports_files(["pubspec.lock"])

DEPS = ["@deps//:" + d for d in [
    "app_links",
    "carousel_slider",
    "clock",
    "collection",
    "connectivity_plus",
    "cupertino_icons",
    "drift",
    "drift_sqlite_async",
    "dynamic_color",
    "equatable",
    "extended_image",
    "fl_chart",
    "flex_color_scheme",
    "flutter",
    "flutter_local_notifications",
    "flutter_localizations",
    "flutter_riverpod",
    "flutter_secure_storage",
    "flutter_secure_storage_darwin",
    "flutter_staggered_grid_view",
    "flutter_svg",
    "flutter_timezone",
    "flutter_typeahead",
    "flutter_widget_from_html_core",
    "flutter_zxing",
    "font_awesome_flutter",
    "freezed_annotation",
    "health_bridge",
    "http",
    "image_picker",
    "intl",
    "json_annotation",
    "logging",
    "markdown",
    "material_ui",
    "multi_select_flutter",
    "package_info_plus",
    "path",
    "path_provider",
    "powersync",
    "riverpod_annotation",
    "shared_preferences",
    "state_notifier",
    "stream_transform",
    "table_calendar",
    "timezone",
    "url_launcher",
    "version",
    "video_player",
]]

TEST_DEPS = ["@deps//:" + d for d in [
    "connectivity_plus_platform_interface",
    "fake_async",
    "flutter_test",
    "image",
    "mockito",
    "network_image_mock",
    "plugin_platform_interface",
    "shared_preferences_platform_interface",
    "url_launcher_platform_interface",
    "xml",
]]

# The files pubspec.yaml names: what the asset bundle holds.
PUBSPEC_SRCS = glob(["assets/**"])

flutter_library(
    name = "wger",
    package_name = "wger",
    # pubspec.yaml: `sdk: '>=3.10.0 <4.0.0'`. Stock reads the language version
    # from there; the rules take it here, and default to the SDK's own.
    language_version = "3.10",
    # `lib/main.dart` is the entry point of `:app` and `:web`, and one source
    # belongs to one target.
    srcs = glob(["lib/**/*.dart"], exclude = ["lib/main.dart"]),
    deps = DEPS,
)

flutter_web_app(
    name = "web",
    package_name = "wger",
    compiler = "dart2js",
    pubspec_srcs = PUBSPEC_SRCS,
    # `lib/main.dart` is the web app's own entry point, so the packages it
    # imports are its direct deps.
    deps = [":wger"] + ["@deps//:" + d for d in [
        "dynamic_color",
        "extended_image",
        "flutter",
        "flutter_riverpod",
        "logging",
        "material_ui",
        "timezone",
    ]],
)

[
    flutter_test(
        name = test[len("test/"):-len(".dart")],
        package_name = "wger",
        size = "medium",
        srcs = glob(["test/**/*.dart", "test_data/**/*.dart"], exclude = ["test/**/*_test.dart"]),
        main = test,
        pubspec = "pubspec.yaml",
        pubspec_srcs = PUBSPEC_SRCS,
        deps = [":wger"] + DEPS + TEST_DEPS,
    )
    for test in glob(["test/**/*_test.dart"])
]

flutter_application(
    name = "app",
    package_name = "wger",
    main = "lib/main.dart",
    pubspec_srcs = PUBSPEC_SRCS,
    # `lib/main.dart` imports these packages itself, so they are direct deps.
    deps = [":wger"] + ["@deps//:" + d for d in [
        "dynamic_color",
        "extended_image",
        "flutter",
        "flutter_riverpod",
        "logging",
        "material_ui",
        "timezone",
    ]],
)

flutter_linux_app(
    name = "linux",
    application = ":app",
    gtk_app_id = "de.wger.flutter",
)
