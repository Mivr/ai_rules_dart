load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_font_family", "flutter_gen_l10n", "flutter_library", "flutter_test")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")

exports_files(["pubspec.lock"])

DEPS = ["@deps//:" + d for d in [
    "app_links",
    "carousel_slider",
    "clock",
    "collection",
    "connectivity_plus",
    "cupertino_icons",
    "drift",
    "drift_sqlite_async",
    "dynamic_color",
    "equatable",
    "extended_image",
    "fl_chart",
    "flex_color_scheme",
    "flutter",
    "flutter_local_notifications",
    "flutter_localizations",
    "flutter_riverpod",
    "flutter_secure_storage",
    "flutter_secure_storage_darwin",
    "flutter_staggered_grid_view",
    "flutter_svg",
    "flutter_timezone",
    "flutter_typeahead",
    "flutter_widget_from_html_core",
    "flutter_zxing",
    "font_awesome_flutter",
    "freezed_annotation",
    "health_bridge",
    "http",
    "image_picker",
    "intl",
    "json_annotation",
    "logging",
    "markdown",
    "material_ui",
    "multi_select_flutter",
    "package_info_plus",
    "path",
    "path_provider",
    "powersync",
    "riverpod_annotation",
    "shared_preferences",
    "state_notifier",
    "stream_transform",
    "table_calendar",
    "timezone",
    "url_launcher",
    "version",
    "video_player",
]] + ["@rules_flutter//flutter:material_icons"]

TEST_DEPS = ["@deps//:" + d for d in [
    "connectivity_plus_platform_interface",
    "fake_async",
    "flutter_test",
    "image",
    "mockito",
    "network_image_mock",
    "plugin_platform_interface",
    "shared_preferences_platform_interface",
    "url_launcher_platform_interface",
    "xml",
]]

ASSETS = glob(
    ["assets/animations/*", "assets/images/*", "assets/images/muscles/*", "assets/images/muscles/main/*", "assets/images/muscles/secondary/*", "assets/icons/*"],
    exclude_directories = 1,
)

flutter_font_family(
    name = "roboto_condensed",
    family = "RobotoCondensed",
    fonts = [{"asset": "assets/fonts/RobotoCondensed-VariableFont_wght.ttf"}],
)

# `generate: true` and `l10n.yaml`: the rules do not read l10n.yaml, so its
# settings are restated here. `flutter_gen_l10n` writes its output beside its
# arb files, and l10n.yaml names `output-dir: lib/l10n/generated`, so the arb
# files are copied there first. No BUILD file sits inside `lib/`: one would
# make its directory a Bazel package of its own and hide its Dart files from
# the glob below.
ARBS = [
    "app_am.arb",
    "app_ar.arb",
    "app_ca.arb",
    "app_cs.arb",
    "app_de.arb",
    "app_el.arb",
    "app_en.arb",
    "app_es.arb",
    "app_fa.arb",
    "app_fil.arb",
    "app_fr.arb",
    "app_gl.arb",
    "app_he.arb",
    "app_hi.arb",
    "app_hr.arb",
    "app_hu.arb",
    "app_id.arb",
    "app_it.arb",
    "app_ja.arb",
    "app_km.arb",
    "app_ko.arb",
    "app_mk.arb",
    "app_nb.arb",
    "app_nl.arb",
    "app_pl.arb",
    "app_pt.arb",
    "app_pt_BR.arb",
    "app_pt_PT.arb",
    "app_ro.arb",
    "app_ru.arb",
    "app_sk.arb",
    "app_sl.arb",
    "app_sn.arb",
    "app_sv.arb",
    "app_ta.arb",
    "app_th.arb",
    "app_tr.arb",
    "app_uk.arb",
    "app_ur.arb",
    "app_zh.arb",
    "app_zh_Hant.arb",
]

[
    copy_file(
        name = "arb_" + arb[:-len(".arb")],
        src = "lib/l10n/" + arb,
        out = "lib/l10n/generated/" + arb,
    )
    for arb in ARBS
]

flutter_gen_l10n(
    name = "l10n",
    arbs = ["lib/l10n/generated/" + arb for arb in ARBS],
    nullable_getter = False,
    preferred_supported_locales = ["en"],
)

flutter_library(
    name = "wger",
    package_name = "wger",
    # pubspec.yaml: `sdk: '>=3.10.0 <4.0.0'`. Stock reads the language version
    # from there; the rules take it here, and default to the SDK's own.
    language_version = "3.10",
    # A stock run leaves its own output in lib/l10n/generated/; `:l10n` replaces it.
    srcs = glob(["lib/**/*.dart"], exclude = ["lib/l10n/generated/**"]) + [":l10n"],
    assets = ASSETS,
    fonts = [":roboto_condensed"],
    deps = DEPS,
)

flutter_web_app(
    name = "web",
    package_name = "wger",
    app_name = "wger",
    compiler = "dart2js",
    # `lib/main.dart` is the web app's own entry point, so the packages it
    # imports are its direct deps.
    deps = [":wger"] + ["@deps//:" + d for d in [
        "dynamic_color",
        "extended_image",
        "flutter",
        "flutter_riverpod",
        "logging",
        "material_ui",
        "timezone",
    ]],
)

[
    flutter_test(
        name = test[len("test/"):-len(".dart")],
        package_name = "wger",
        size = "medium",
        srcs = glob(["test/**/*.dart", "test_data/**/*.dart"], exclude = ["test/**/*_test.dart"]),
        main = test,
        deps = [":wger"] + DEPS + TEST_DEPS,
    )
    for test in glob(["test/**/*_test.dart"])
]

flutter_application(
    name = "app",
    package_name = "wger",
    main = "lib/main.dart",
    # `lib/main.dart` imports these packages itself, so they are direct deps.
    deps = [":wger"] + ["@deps//:" + d for d in [
        "dynamic_color",
        "extended_image",
        "flutter",
        "flutter_riverpod",
        "logging",
        "material_ui",
        "timezone",
    ]],
)

flutter_linux_app(
    name = "linux",
    application = ":app",
    gtk_app_id = "de.wger.flutter",
)
