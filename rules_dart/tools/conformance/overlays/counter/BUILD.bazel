load("@android_model//:defs.bzl", "flutter_android_app")
load("@rules_flutter//flutter:android.bzl", "flutter_android_pin")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_test")
load("@rules_flutter//flutter:linux.bzl", "flutter_linux_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")

exports_files(["pubspec.lock"])

DEPS = [
    "@deps//:cupertino_icons",
    "@deps//:flutter",
    "@rules_flutter//flutter:material_icons",
]

flutter_web_app(
    name = "web",
    package_name = "counter",
    app_name = "counter",
    compiler = "dart2js",
    deps = DEPS,
)

flutter_test(
    name = "widget_test",
    package_name = "counter",
    srcs = glob(["lib/**/*.dart"]),
    main = "test/widget_test.dart",
    deps = DEPS + ["@deps//:flutter_test"],
)

flutter_application(
    name = "app",
    package_name = "counter",
    main = "lib/main.dart",
    deps = DEPS,
)

flutter_android_pin(name = "android_pin")

# `:android` is the split APKs; the whole APK is what stock builds.
flutter_android_app(
    name = "android",
    application = ":app",
)

alias(
    name = "apk",
    actual = ":android_apk",
)

flutter_linux_app(
    name = "linux",
    application = ":app",
    gtk_app_id = "dev.rdf.counter",
)
