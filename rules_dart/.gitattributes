* text=auto eol=lf

# Digest fixtures hash exact bytes: never normalize them.
e2e/digest_mismatch/fixture.bin -text

#################################
# Configuration for 'git archive'
# See https://git-scm.com/docs/git-archive#ATTRIBUTES

# `release_prep.sh` archives this directory alone (`git archive <tag>` run in rules_dart/),
# so every pattern here is relative to rules_dart/ and anchored with a leading
# `/`: without one, `git archive` matches the basename at any depth.

# Don't include examples in the distribution artifact, to reduce size.
examples export-ignore

# Development files: editor and agent settings, CI, the development docs.
/.claude/ export-ignore
/.devcontainer/ export-ignore
/.github/ export-ignore
/.gitattributes export-ignore
/ai-docs/ export-ignore

# The e2e workspaces are checked out only for development. The archive keeps
# `e2e/smoke`, which the registry entry (`.bcr/rules_dart/presubmit.yml` at the
# repository root) names as its test module, and it names every other
# workspace through the wildcard, so a new one is left out without a line here.
/e2e/* export-ignore
/e2e/smoke -export-ignore

# Dev-only analysis tests load `@rules_testing`, a dev dependency: keep them out
# of release archives so `@rules_dart//...` loads for every consumer.
/dart/tests/ export-ignore

# The Starlark unit tests of the pub rules load `//dart/tests:small_suite.bzl`,
# which the line above removes.
/dart/pub/tests/ export-ignore

# Dev-only fixture package for the exported import check's test.
/dev/ export-ignore

# Stamps the archive marker `//:analysis_config` reads to drop the options
# packages that /dart/tests/ no longer provides.
/BUILD.bazel export-subst

# Occasionally there's a need to "stamp" the release version into a file
# See https://blog.aspect.build/releasing-bazel-rulesets-rust for details if you need this.
# dart/version.bzl export-subst

# The prebuilt-tools table of a release is written into the archive by
# release_prep.sh, after `git archive`; the checkout's empty one
# stays out, so the archive holds one.
/dart/private/prebuilt_tools.json export-ignore
