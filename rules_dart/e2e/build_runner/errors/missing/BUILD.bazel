load("@rules_dart//dart:defs.bzl", "dart_build_runner")

# A declared output no builder writes: stock writes no file there, so the
# action fails rather than ship an empty file.
dart_build_runner(
    name = "gen",
    outs = ["lib/plain.g.dart"],
    runner = "@pub_deps//build_runner",
    tags = ["manual"],
    deps = ["@pub_deps//:json_annotation"],
)
