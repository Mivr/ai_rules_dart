load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")
load("//:reference.bzl", "stock_reference_test")

OUTS = ["lib/providers.g.dart"]

dart_build_runner(
    name = "gen",
    outs = OUTS,
    runner = "@pub_deps//build_runner",
    deps = ["@pub_deps//:riverpod", "@pub_deps//:riverpod_annotation"],
)

dart_library(
    name = "riverpod_pkg",
    srcs = glob(["lib/**/*.dart"], exclude = OUTS) + [":" + o for o in OUTS if o.startswith("lib/")],
    package_name = "riverpod_pkg",
    language_version = "3.13",
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:riverpod", "@pub_deps//:riverpod_annotation"],
)

stock_reference_test(
    name = "stock_test",
    outs = OUTS,
    package = "riverpod_pkg",
)
