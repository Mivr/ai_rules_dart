load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata", "dart_test")

# A dart_library that re-exports a Bazel-generated standalone library.

dart_package_metadata(
    name = "pkg",
    package_name = "reexport_fixture",
    language_version = "3.11",
)

run_binary(
    name = "api_gen",
    srcs = ["lib/api.dart"],
    outs = ["lib/api.g.dart"],
    args = [
        "--input",
        "$(execpath lib/api.dart)",
        "--output",
        "$(execpath lib/api.g.dart)",
    ],
    tool = "//tools:lib_gen",
)

dart_library(
    name = "reexport_fixture",
    srcs = [
        "lib/api.dart",
        ":api_gen",
    ],
    package = ":pkg",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "api_test",
    size = "small",
    main = "test/api_test.dart",
    deps = [
        ":reexport_fixture",
        "@pub_deps//:test",
    ],
)
