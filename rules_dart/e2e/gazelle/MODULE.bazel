module(name = "gazelle_e2e")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "gazelle", version = "0.54.0")

# Building the Go binaries here goes through the C++ toolchain, which on macOS
# is apple_support's. 2.9.0 builds that toolchain's helper tools for macOS 11,
# the oldest Xcode 27's libc++ accepts without a warning.
bazel_dep(name = "apple_support", version = "2.10.1")

# The SQLite amalgamation drift's sqlite3 compiles in its build hook (source
# mode, `hooks: user_defines:` in app/pubspec.yaml) instead of downloading a
# prebuilt library, which the sandbox refuses.
bazel_dep(name = "sqlite3", version = "3.53.4")

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

local_path_override(
    module_name = "ai_rules_dart",
    path = "../..",
)

cc_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(cc_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    dev_dependency = True,
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# The lock of app/, a stock Dart package whose BUILD file Gazelle writes. Its
# hub carries the builder facts Gazelle reads (`build_runner/builders.json`).
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    # The user define in app/pubspec.yaml names this file; the hook reads it.
    hook_data = {"@sqlite3//:sqlite3.c": "sqlite3"},
    lock = "//app:pubspec.lock",
)
use_repo(pub, "pub_deps")
