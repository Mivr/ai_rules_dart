load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_library", "dart_test")

exports_files([
    "pubspec.lock",
    "pubspec.yaml",
])

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# The workspace root is a package as well as the lock's home: a `dart_library`
# named after it, depending on the members it imports by label.
dart_library(
    name = "pub_workspace_root",
    srcs = glob(["lib/**/*.dart"]),
    deps = ["//c"],
)

dart_test(
    name = "root_test",
    size = "small",
    main = "test/root_test.dart",
    deps = [":pub_workspace_root"],
)
