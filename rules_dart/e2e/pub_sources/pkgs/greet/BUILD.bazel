load("@rules_dart//dart:defs.bzl", "dart_library")

# A path package is source in this module: a `dart_library` named after the
# package, which the hub's `@pub_deps//:greet` aliases.
dart_library(
    name = "greet",
    srcs = glob(["lib/**/*.dart"]),
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:path"],
)
