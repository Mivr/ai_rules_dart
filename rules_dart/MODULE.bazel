"Bazel dependencies"

# NOTE: The version field is intentionally omitted. Leaving it unset (the
# default "") prevents issues when the module is used via non-registry
# overrides (e.g. https://github.com/bazel-contrib/rules_go/issues/4380).
# The publish-to-bcr GitHub Action patches in the release version when
# submitting to the Bazel Central Registry.
#
# NOTE: compatibility_level is omitted (defaults to 0). Bumping it is very
# disruptive — as soon as a module is requested at two different compatibility
# levels in the dependency tree, users see an error. Only bump it when the
# breaking change affects most use cases and isn't easy to work around, and
# in the same commit that introduces the incompatible change.
module(
    name = "ai_rules_dart",
    bazel_compatibility = [">=9.0.0"],
    repo_name = "rules_dart",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "platforms", version = "1.1.0")

# The Gazelle plugin at //gazelle/dart is a go_library, so its BUILD file
# loads @io_bazel_rules_go//go:def.bzl. In bzlmod, BUILD files are evaluated
# in the context of their owning module — so rules_go must be a regular (not
# dev) dependency for the plugin to be loadable from downstream modules.
# The Go SDK and toolchain are only fetched if a target in //gazelle/... is
# actually built; they are not downloaded for normal Dart-only usage.
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.64.2", repo_name = "io_bazel_rules_go")

# A package's build hook gets the C toolchain Bazel resolves for the target,
# and `dart_code_asset` binds a `cc_shared_library`: both load @rules_cc.
bazel_dep(name = "rules_cc", version = "0.2.26")

# On Apple OSes, where build hooks do not run yet, //dart/ext/sqlite3 and
# //dart/ext/webcrypto replace those packages' hooks
# (`//dart/private:apple_hook_replacements.bzl`). Regular deps so the
# replacements resolve from downstream modules; fetched only when built.
# Go when build hooks are proven on macOS CI.
bazel_dep(name = "sqlite3", version = "3.53.4")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "webcrypto_pub_archive",
    build_file = "//dart/ext/webcrypto:webcrypto.BUILD",
    sha256 = "9885ed99a846191542dd6ca820c83a098117df56be57453832233a3fef68f3f2",
    urls = ["https://pub.dev/api/archives/webcrypto-0.6.1.tar.gz"],
)

# On macOS, rules_cc leaves C++ to apple_support's toolchain. 2.9.0 builds that
# toolchain's helper tools for macOS 11, the oldest Xcode 27's libc++ accepts
# without a warning. Dev-only: the C++ toolchain is the consuming module's call.
bazel_dep(name = "apple_support", version = "2.10.1", dev_dependency = True)

# On Linux, register a hermetic Zig-backed C/C++ toolchain for rules_dart's own
# native targets and tests so builds do not probe the host via local_config_cc.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

# The buildifier release the `keith/pre-commit-buildifier` hook in
# `.pre-commit-config.yaml` runs (prek is the only buildifier entry point).
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# The direct analysis tests under //dart/tests load
# `@rules_testing//lib:analysis_test.bzl`. Dev-only: `/dart/tests/` is
# `export-ignore`d in .gitattributes, so release archives carry none of those
# packages and published consumers never load `@rules_testing` or pull it (and
# its `rules_license` 0.0.4) into their module graphs.
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

cc_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(cc_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    dev_dependency = True,
)

dart = use_extension("//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")

# Besides the scanner, the pinned `yaml2json` the pub rules read pubspec files with
# (`dart_yaml2json`), the hub naming each pinned SDK version's module compiler
# sources (`dart_module_compiler`, which `//dart:toolchain.bzl` resolves
# through this module's own mapping) and the toolchains, the host SDK
# repositories for every
# platform the pub archive scanner supports: the scanner repository compiles
# its executable from the default toolchain's host SDK, resolved through this
# module's own mapping (`Label("@dart_<platform>//:...")` in
# `//dart/pub/private:pub_scanner_repo.bzl`), so no caller or consumer mapping
# and no hand-built canonical name is ever involved. This module's own
# non-dev `dart.toolchain` tag above guarantees the `dart` registration — and
# with it every one of these repositories — exists in every build.
use_repo(
    dart,
    "dart_linux-arm64",
    "dart_linux-x64",
    "dart_macos-arm64",
    "dart_macos-x64",
    "dart_module_compiler",
    "dart_pub_scanner",
    "dart_toolchains",
    "dart_windows-x64",
    "dart_yaml2json",
)

register_toolchains("@dart_toolchains//:all")

# Runs the pubspec reader over fixed documents with the pinned `yaml2json`, for the
# behaviour tests in `//dart/pub/tests:yaml2json_test.bzl`.
yaml2json_probe = use_repo_rule("//dart/pub/tests:yaml2json_probe.bzl", "yaml2json_probe")

yaml2json_probe(
    name = "yaml2json_probe",
    dev_dependency = True,
)

# Copies files into one directory for `dart_source_set` and the staging rules.
register_toolchains("//dart:copy_toolchain")

# Pub deps for rules_dart's own tools, tests and lints, pinned by
# //dart/ext:pubspec.lock and resolved into @ext_pub_deps.
pub = use_extension("//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "ext_pub_deps",
    # Isolated so a consumer's lock never meets this one: it stays out of the
    # global version resolution and cannot conflict with a consumer's pins.
    isolated = True,
    lock = "//dart/ext:pubspec.lock",
    # Planned ahead of time, so no module that depends on rules_dart asks a
    # server about these packages. `//dart/pub/plan:plan_test` checks it
    # against the lock; regenerate it with
    # `bazel run //dart/pub/plan -- write --lock dart/ext/pubspec.lock --out dart/ext/pub_plan.json`.
    plan = "//dart/ext:pub_plan.json",
)

# The hook runner's own packages (`//dart/private/tools/hook_runner`): the
# `package:hooks_runner` version the SDK's `dart build` and `flutter build`
# run, with the versions it was released against. Isolated, so a consumer's
# lock never meets it: the runner belongs to the SDK, a hook's own `hooks` and
# `code_assets` to the consumer's lock. Regenerate the plan with
# `bazel run //dart/pub/plan -- write --lock dart/private/tools/hook_runner/pubspec.lock --out dart/private/tools/hook_runner/pub_plan.json`.
pub.from_lock(
    name = "rules_dart_hook_runner_deps",
    isolated = True,
    lock = "//dart/private/tools/hook_runner:pubspec.lock",
    plan = "//dart/private/tools/hook_runner:pub_plan.json",
)
use_repo(pub, "dart_projects", "ext_pub_deps", "rules_dart_hook_runner_deps")

# A project of rules_dart's own index, whose targets the macros' defaults are
# tested on (`//dart/tests/project_fixture`). Its lock names no package.
pub_dev = use_extension("//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub_dev.from_lock(
    name = "rules_dart_project_fixture_deps",
    isolated = True,
    lock = "//dart/tests/project_fixture:pubspec.lock",
)
use_repo(pub_dev, "rules_dart_project_fixture_deps")
