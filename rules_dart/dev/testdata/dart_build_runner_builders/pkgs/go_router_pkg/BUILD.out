load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_library(
    name = "go_router_pkg",
    package_name = "go_router_pkg",
    srcs = [
        "lib/routes.dart",
        "lib/routes_a.dart",
        ":lib/routes.g.dart",
        ":lib/routes_a.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:flutter",
        "@pub_deps//:go_router",
    ],
)

dart_build_runner(
    name = "gen",
    outs = [
        "lib/routes.g.dart",
        "lib/routes_a.g.dart",
    ],
    runner = "@pub_deps//build_runner",
    deps = [
        "@pub_deps//:flutter",
        "@pub_deps//:go_router",
    ],
)
