load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_library(
    name = "built_value_pkg",
    package_name = "built_value_pkg",
    srcs = [
        "lib/src/book.dart",
        "lib/src/serializers.dart",
        "lib/src/shelf.dart",
        ":lib/src/book.g.dart",
        ":lib/src/serializers.g.dart",
        ":lib/src/shelf.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:built_collection",
        "@pub_deps//:built_value",
    ],
)

dart_build_runner(
    name = "gen",
    outs = [
        "lib/src/book.g.dart",
        "lib/src/serializers.g.dart",
        "lib/src/shelf.g.dart",
    ],
    runner = "@pub_deps//build_runner",
    deps = [
        "@pub_deps//:built_collection",
        "@pub_deps//:built_value",
    ],
)
