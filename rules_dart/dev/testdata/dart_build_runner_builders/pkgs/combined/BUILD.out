load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library", "dart_test")

dart_library(
    name = "combined",
    package_name = "combined",
    srcs = [
        "lib/src/api.dart",
        "lib/src/di.dart",
        "lib/src/models.dart",
        "lib/src/store.dart",
        ":lib/src/api.g.dart",
        ":lib/src/di.config.dart",
        ":lib/src/models.freezed.dart",
        ":lib/src/models.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:dio",
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:get_it",
        "@pub_deps//:injectable",
        "@pub_deps//:json_annotation",
        "@pub_deps//:retrofit",
        "@pub_deps//:riverpod",
        "@pub_deps//:riverpod_annotation",
    ],
)

dart_test(
    name = "store_test",
    srcs = [":test/store_test.mocks.dart"],
    main = "test/store_test.dart",
    deps = [
        ":combined",
        "@pub_deps//:mockito",
        "@pub_deps//:test",
    ],
)

dart_build_runner(
    name = "gen",
    outs = [
        "lib/src/api.g.dart",
        "lib/src/di.config.dart",
        "lib/src/models.freezed.dart",
        "lib/src/models.g.dart",
        "test/store_test.mocks.dart",
    ],
    runner = "@pub_deps//build_runner",
    deps = [
        "@pub_deps//:dio",
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:get_it",
        "@pub_deps//:injectable",
        "@pub_deps//:json_annotation",
        "@pub_deps//:mockito",
        "@pub_deps//:retrofit",
        "@pub_deps//:riverpod",
        "@pub_deps//:riverpod_annotation",
        "@pub_deps//:test",
    ],
)
