load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_library(
    name = "retrofit_pkg",
    package_name = "retrofit_pkg",
    srcs = [
        "lib/api.dart",
        ":lib/api.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:dio",
        "@pub_deps//:json_annotation",
        "@pub_deps//:retrofit",
    ],
)

dart_build_runner(
    name = "gen",
    outs = ["lib/api.g.dart"],
    runner = "@pub_deps//build_runner",
    deps = [
        "@pub_deps//:dio",
        "@pub_deps//:json_annotation",
        "@pub_deps//:retrofit",
    ],
)
