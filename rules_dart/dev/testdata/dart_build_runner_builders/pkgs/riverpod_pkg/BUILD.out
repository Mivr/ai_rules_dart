load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_library(
    name = "riverpod_pkg",
    package_name = "riverpod_pkg",
    srcs = [
        "lib/providers.dart",
        ":lib/providers.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@pub_deps//:riverpod",
        "@pub_deps//:riverpod_annotation",
    ],
)

dart_build_runner(
    name = "gen",
    outs = ["lib/providers.g.dart"],
    runner = "@pub_deps//build_runner",
    deps = [
        "@pub_deps//:riverpod",
        "@pub_deps//:riverpod_annotation",
    ],
)
