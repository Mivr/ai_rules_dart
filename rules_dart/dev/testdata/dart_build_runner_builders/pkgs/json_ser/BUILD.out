load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_library(
    name = "json_ser",
    package_name = "json_ser",
    srcs = [
        "lib/json_ser.dart",
        "lib/other/not_generated.dart",
        "lib/src/address.dart",
        "lib/src/user.dart",
        ":lib/src/address.g.dart",
        ":lib/src/user.g.dart",
    ],
    visibility = ["//visibility:public"],
    deps = ["@pub_deps//:json_annotation"],
)

dart_build_runner(
    name = "gen",
    outs = [
        "lib/src/address.g.dart",
        "lib/src/user.g.dart",
    ],
    runner = "@pub_deps//build_runner",
    deps = ["@pub_deps//:json_annotation"],
)
