load("@rules_dart//dart:defs.bzl", "dart_build_runner", "dart_library")

dart_build_runner(
    name = "codegen",
    outs = ["lib/stale.g.dart"],
    runner = "@pub_deps//build_runner",
)

dart_library(
    name = "renamed",
    package_name = "renamed",
    srcs = [
        "lib/stale.dart",
        ":lib/stale.g.dart",
    ],
    visibility = ["//visibility:public"],
)
