# `//dart:refused_dart_libraries`: the check actions of an executable and of a
# source-set library carry `--refused-library` only when the setting is set, and
# a malformed entry fails analysis.
# A binary that compiles from sources (`modular_kernel = False`) checks its
# closure with `DartImportCheck` actions; a modular one checks inside its modules.
dart_binary(
    name = "refused_subject",
    main = "bin/refused_main.dart",
    modular_kernel = False,
    tags = ["manual"],
)

# A library checks its imports inside its module compile.
dart_library(
    name = "refused_library_subject",
    srcs = ["lib/direct_model.dart"],
    tags = ["manual"],
)

[
    (
        layering_refused_test(
            name = "refused_default_%s_test" % kind,
            size = "small",
            target_under_test = ":refused_%s" % subject,
        ),
        layering_refused_set_test(
            name = "refused_set_%s_test" % kind,
            size = "small",
            expect_refused = ["dart:mirrors"],
            target_under_test = ":refused_%s" % subject,
        ),
    )
    for kind, subject in {
        "executable": "subject",
        "library": "library_subject",
    }.items()
]

layering_refused_bad_test(
    name = "refused_bad_entry_test",
    size = "small",
    target_under_test = ":refused_subject",
)

