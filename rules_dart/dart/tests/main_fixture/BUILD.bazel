load("//dart:defs.bzl", "dart_library", "dart_test")

# A library with a `main` of its own. Its kernel is linked into the test that imports
# it, so the link must start the test's `main`, not this one. See `main_test.dart`.
dart_library(
    name = "cli",
    package_name = "main_fixture",
    srcs = ["lib/cli.dart"],
    language_version = "3.11",
)

dart_test(
    name = "main_test",
    size = "small",
    main = "main_test.dart",
    deps = [
        ":cli",
        "@ext_pub_deps//:test",
    ],
)

# Two tests whose names differ only in their directory share a basename. Each
# file of an entry module is declared beside its module, so no two actions
# write one file and both build and run.
[
    dart_test(
        name = "same_basename/%s/main_test" % directory,
        size = "small",
        main = "main_test.dart",
        deps = [
            ":cli",
            "@ext_pub_deps//:test",
        ],
    )
    for directory in [
        "one",
        "two",
    ]
]
