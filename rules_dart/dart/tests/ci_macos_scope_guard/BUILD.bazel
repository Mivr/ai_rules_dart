load("//dart:defs.bzl", "dart_test")

# Pins which folders full.yaml's macOS job runs, and that every folder it
# dropped still runs on Linux in ci.yaml. Unsandboxed over the live tree, like
# `//dart/tests/ci_disk_guard:ci_disk_guard_test`.
dart_test(
    name = "ci_macos_scope_guard_test",
    size = "small",
    args = [
        "$(rlocationpath :ci_macos_scope_guard_test.dart)",
    ],
    data = [
        "ci_macos_scope_guard_test.dart",
    ],
    local = True,
    main = "ci_macos_scope_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
        "@ext_pub_deps//:yaml",
    ],
)
