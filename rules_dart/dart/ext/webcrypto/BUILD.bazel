load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//dart:defs.bzl", "dart_code_asset")

# package:webcrypto's library on Apple OSes, where build hooks do not run yet
# (`//dart/private:apple_hook_replacements.bzl`), built from the pub archive's
# C glue and the BoringSSL it vendors. Elsewhere the package's hook builds it
# (with CMake). Goes when build hooks are proven on macOS CI.

cc_shared_library(
    name = "libwebcrypto",
    shared_lib_name = "libwebcrypto.dylib",
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = ["@webcrypto_pub_archive//:webcrypto"],
)

dart_code_asset(
    name = "code_asset",
    # lib/src/boringssl/lookup/lookup.dart binds its `@Native` functions to
    # this id; the hook registers its library under the same name.
    asset_id = "package:webcrypto/webcrypto.dart",
    shared_library = ":libwebcrypto",
    visibility = ["//visibility:public"],
)
