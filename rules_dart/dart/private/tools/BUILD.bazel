filegroup(
    name = "module_compiler_srcs",
    srcs = [
        "lib/layering_message.dart",
        "lib/worker_protocol.dart",
        "lib/worker_serve.dart",
        "module_compiler.dart",
        "module_outline.dart",
        "package_config.dart",
    ],
    visibility = ["//visibility:public"],
)

# The compile wrapper (`app_jit_snapshot.dart`) as an AOT snapshot, run by
# `dartaotruntime` in the `exe`, `aot-snapshot` and `gen_kernel` actions of
# every `dart_binary` (see `compile_wrapper.bzl`). Run like `kernel_link`:
# compiled once, never per app. It cannot be built through its own snapshot,
# so `use_compile_wrapper = False` compiles it with the tool run from source,
# as the `jit-snapshot` mode does. Its sources stay out of every app's inputs.
dart_binary(
    name = "compile_wrapper",
    srcs = [
        "app_jit_aot_args.dart",
        "comma_patch.dart",
        "dill_reader.dart",
        "jit_lock.dart",
        "jit_policy.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    code_assets_from_deps = False,
    compile_mode = "aot-snapshot",
    main = "app_jit_snapshot.dart",
    modular_kernel = False,
    # Run by `dartaotruntime` as a raw snapshot, like `kernel_link`.
    snapshot_launcher = False,
    use_compile_wrapper = False,
    visibility = ["//dart:__subpackages__"],
)

# The launch of the compile wrapper, loaded by `dart_binary.bzl` and `dart_compile.bzl`.
bzl_library(
    name = "compile_wrapper_bzl",
    srcs = ["compile_wrapper.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//dart/private:dart_import_check"],
)

# Generates one module's `package_config.json` from its closure's records.
# It takes no `dart_library` dependency on purpose (like the module
# compiler
# above): every `dart_library` names it as an implicit exec tool, so a
# dependency would be a cycle. It reads the shared worker sources through
# no `srcs`: it imports only `dart:` libraries.
dart_binary(
    name = "package_config",
    code_assets_from_deps = False,
    compile_mode = "aot-snapshot",
    main = "package_config.dart",
    modular_kernel = False,
    # Run by `dartaotruntime` on the raw snapshot as a build-time tool, so the
    # snapshot must stay the executable rather than gaining a `bazel run`
    # launcher.
    snapshot_launcher = False,
    visibility = ["//visibility:public"],
)

# The strict-layering check (see `import_check.dart`): reads one target's
# sources and fails when one imports a package its own `deps` do not provide.
# Like `kernel_link` it takes no `dart_library` dependency, because every
# `dart_binary` and `dart_library` aspect names it as an implicit exec tool, so
# a dependency would be a cycle. It reads the shared guard through `srcs`: the
# file compiles in place, so the relative import reaches it with no package edge.
dart_binary(
    name = "import_check",
    srcs = [
        "kernel_module_import_check.dart",
        "lib/layering_message.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    code_assets_from_deps = False,
    compile_mode = "aot-snapshot",
    main = "import_check.dart",
    modular_kernel = False,
    # `dartaotruntime` runs the raw snapshot, so it must stay the executable.
    snapshot_launcher = False,
    visibility = ["//dart:__subpackages__"],
)

