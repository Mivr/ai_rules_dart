"""Repositories holding the source closure the module compiler is built from.

`module_compiler_sources_repo` fetches one SDK version's closure: the tag's
source archive reduced to the `lib/` directories of the five SDK packages the
tool imports, and the hosted packages those import, each from its pinned
archive. Every fetch goes through `pinned_download_and_extract`, so nothing is
downloaded without a checksum. `module_compiler_hub_repo` names each pinned
version's closure by an alias, so one `use_repo` covers every version and a
closure is fetched only when a toolchain of that version is used.
"""

load("//dart/private:download.bzl", "pinned_download_and_extract")
load(
    "//dart/private:module_compiler_versions.bzl",
    "MODULE_COMPILER_HOSTED_PACKAGES",
    "MODULE_COMPILER_SDK_PACKAGES",
    "MODULE_COMPILER_SOURCES",
    "module_compiler_repo_name",
)

visibility(["//dart/..."])

def _keep_only(repository_ctx, directory, names):
    """Deletes every entry of `directory` whose name is not in `names`."""
    for entry in repository_ctx.path(directory).readdir():
        if entry.basename not in names:
            repository_ctx.delete(entry)

def _sources_repo_impl(repository_ctx):
    version = repository_ctx.attr.dart_version
    pin = MODULE_COMPILER_SOURCES[version]
    pinned_download_and_extract(
        repository_ctx,
        url = "https://github.com/dart-lang/sdk/archive/refs/tags/%s.tar.gz" % version,
        sha256 = pin.sha256,
        stripPrefix = "sdk-" + version,
        output = "sdk",
    )

    # The archive is the whole SDK tree; the tool needs five `lib/` directories.
    _keep_only(repository_ctx, "sdk", ["pkg"])
    _keep_only(repository_ctx, "sdk/pkg", MODULE_COMPILER_SDK_PACKAGES)
    packages = {}
    for name in MODULE_COMPILER_SDK_PACKAGES:
        _keep_only(repository_ctx, "sdk/pkg/" + name, ["lib"])
        packages[name] = "sdk/pkg/%s|%s" % (name, pin.language_versions[name])
    for name, package in MODULE_COMPILER_HOSTED_PACKAGES.items():
        pinned_download_and_extract(
            repository_ctx,
            url = "https://pub.dev/api/archives/%s-%s.tar.gz" % (name, package.version),
            sha256 = package.sha256,
            output = "pub/" + name,
        )
        _keep_only(repository_ctx, "pub/" + name, ["lib"])
        packages[name] = "pub/%s|%s" % (name, package.language_version)
    repository_ctx.file("BUILD.bazel", """# Generated by dart/private/module_compiler_repo.bzl
load("@rules_dart//dart:toolchain.bzl", "module_compiler_sources")

module_compiler_sources(
    name = "sources",
    srcs = glob(["sdk/pkg/*/lib/**/*.dart", "pub/*/lib/**/*.dart"]),
    packages = {packages},
    revision = {revision},
    visibility = ["//visibility:public"],
)
""".format(packages = repr(packages), revision = repr(pin.revision)))
    return repository_ctx.repo_metadata(reproducible = True)

module_compiler_sources_repo = repository_rule(
    _sources_repo_impl,
    doc = "Fetches the pinned source closure the module compiler of one Dart SDK version is built from.",
    attrs = {
        "dart_version": attr.string(
            doc = "The Dart SDK version; a key of `MODULE_COMPILER_SOURCES`.",
            mandatory = True,
            values = MODULE_COMPILER_SOURCES.keys(),
        ),
    },
)

def _hub_repo_impl(repository_ctx):
    build = "# Generated by dart/private/module_compiler_repo.bzl\n"
    for version in MODULE_COMPILER_SOURCES:
        build += """
alias(
    name = {version},
    actual = "@{repo}//:sources",
    visibility = ["//visibility:public"],
)
""".format(version = repr(version), repo = module_compiler_repo_name(version))
    repository_ctx.file("BUILD.bazel", build)
    return repository_ctx.repo_metadata(reproducible = True)

module_compiler_hub_repo = repository_rule(
    _hub_repo_impl,
    doc = "Names each pinned SDK version's module compiler sources by an alias.",
)

def module_compiler_repositories():
    """Declares the hub and one sources repository per pinned SDK version."""
    for version in MODULE_COMPILER_SOURCES:
        module_compiler_sources_repo(
            name = module_compiler_repo_name(version),
            dart_version = version,
        )
    module_compiler_hub_repo(name = "dart_module_compiler")
