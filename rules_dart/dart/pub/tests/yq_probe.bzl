"""Runs `yaml_to_json` with the real `yaml2json` binary over fixed documents.

`yq_probe` writes every document of `DOCUMENTS` and `MUST_FAIL` to a file of
its own, converts them with `//dart/pub/private:yq.bzl`, and writes the
outcome to `results.bzl` (`RESULTS`), which `yq_test.bzl` checks. The
documents convert in one call, as the pub extension converts a lock's
pubspecs; each must-fail document converts in a call of its own, so each
error is that document's.
"""

load("//dart/pub/private:yq.bzl", "yaml_to_json_or_error")

visibility(["//dart/..."])

# Documents that convert, by file name. `yq_test.bzl` holds the data each
# one must decode to.
DOCUMENTS = {
    "anchors.yaml": "a: &v 1.10\nb: *v\nc: &w 0x10\nd: *w\n",
    "block_scalar.yaml": "text: |\n  line one\n  line two\nfolded: >\n  a\n  b\n",
    "bom.yaml": "\357\273\277name: bom\n",
    "comment_only.yaml": "# nothing here\n",
    "crlf.yaml": "name: crlf\r\nversion: 1.0.0\r\n",
    "empty.yaml": "",
    "flow.yaml": "{name: flow, dependencies: {a: ^1.0.0, b: any}, list: [1, two]}\n",
    "lock.yaml": (
        "# Generated by pub\n" +
        "packages:\n" +
        "  collection:\n" +
        "    dependency: \"direct main\"\n" +
        "    description:\n" +
        "      name: collection\n" +
        "      sha256: \"0123456789012345678901234567890123456789012345678901234567890123\"\n" +
        "      url: \"https://pub.dev\"\n" +
        "    source: hosted\n" +
        "    version: \"1.10.0\"\n" +
        "  local:\n" +
        "    dependency: \"direct main\"\n" +
        "    description:\n" +
        "      path: \"../local\"\n" +
        "      relative: true\n" +
        "    source: path\n" +
        "    version: \"0.0.1\"\n" +
        "sdks:\n" +
        "  dart: \">=3.0.0 <4.0.0\"\n"
    ),
    "markers.yaml": "---\nname: markers\n...\n",
    "merge_key.yaml": "base: &b {a: 1}\nother:\n  <<: *b\n  c: 2\n",
    "scalars.yaml": (
        "float: 1.10\n" +
        "hex: 0x10\n" +
        "octal: 0o17\n" +
        "word_bool: yes\n" +
        "bool: true\n" +
        "capital_bool: False\n" +
        "null_word: null\n" +
        "tilde: ~\n" +
        "empty:\n" +
        "quoted_null: \"null\"\n" +
        "digits: 1234567890123456789012345678901234567890\n" +
        "exponent: 123e45\n" +
        "date: 2024-01-01\n" +
        "infinity: .inf\n" +
        "1: number key\n"
    ),
}

# Documents `pub` refuses, by file name, with a word the error must carry.
MUST_FAIL = {
    "duplicate_key.yaml": ("name: a\nname: b\n", "repeats a key"),
    "duplicate_nested_key.yaml": ("dependencies:\n  a: any\n  a: ^1.0.0\n", "repeats a key"),
    "list_root.yaml": ("- a\n- b\n", "mapping at the top level"),
    "scalar_root.yaml": ("just text\n", "mapping at the top level"),
    "second_document.yaml": ("name: a\n---\nname: b\n", "2 YAML documents"),
    "tab_after_colon.yaml": ("environment:\n  sdk:\t^3.0.0\n", "line 2"),
    "tab_indentation.yaml": ("environment:\n\tsdk: ^3.0.0\n", "line 2"),
    "text_after_end.yaml": ("name: a\n... more\n", "line 2"),
    "text_after_quote.yaml": ("name: \"a\" b\n", "line 1"),
}

def _yq_probe_impl(rctx):
    for name, text in DOCUMENTS.items():
        rctx.file("docs/" + name, text)
    for name, case in MUST_FAIL.items():
        rctx.file("fail/" + name, case[0])
    names = sorted(DOCUMENTS.keys())

    # One call for every document, with one file named twice.
    batch = yaml_to_json_or_error(rctx, ["docs/" + n for n in names] + ["docs/" + names[0]], names + [names[0]])
    failures = {}
    for name in sorted(MUST_FAIL.keys()):
        result = yaml_to_json_or_error(rctx, ["docs/" + names[0], "fail/" + name], [names[0], name])
        failures[name] = {"data": result.data, "error": result.error}
    results = {
        "batch_error": batch.error,
        "documents": dict(zip(names + ["(again) " + names[0]], batch.data)) if batch.data != None else None,
        "failures": failures,
    }
    rctx.file("BUILD.bazel", 'exports_files(["results.bzl"])\n')
    rctx.file("results.bzl", "RESULTS = json.decode(%r)\n" % json.encode(results))

yq_probe = repository_rule(
    implementation = _yq_probe_impl,
    doc = "Converts the fixed documents with the real `yaml2json` and records what came out, for `yq_test.bzl`.",
)
