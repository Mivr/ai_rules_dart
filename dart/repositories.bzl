"""Declare runtime dependencies

These are needed for local dev, and users must install them as well.
See https://docs.bazel.build/versions/main/skylark/deploying.html#dependencies
"""

load("//dart:toolchain.bzl", _declare_dart_sdk_toolchains = "declare_dart_sdk_toolchains")
load(
    "//dart/private:toolchains_repo.bzl",
    "CROSS_TARGETS",
    "PLATFORMS",
    "TARGET_PLATFORMS",
    "resolve_cross_sdk_artifacts",
    "toolchains_repo",
)
load("//dart/private:versions.bzl", "TOOL_VERSIONS")

declare_dart_sdk_toolchains = _declare_dart_sdk_toolchains

########
# Remaining content of the file is only used to support toolchains.
########
_DOC = "Fetch the Dart SDK for a given version and platform"
_ATTRS = {
    "cross_repo_prefix": attr.string(
        doc = "Apparent repository name prefix for the `dart_cross_repositories` instances associated with this host SDK.",
        default = "",
    ),
    "dart_version": attr.string(
        doc = "The Dart SDK version to download (e.g. `3.11.0`). Must be a version listed in `versions.bzl`.",
        mandatory = True,
        values = TOOL_VERSIONS.keys(),
    ),
    "platform": attr.string(
        doc = "The host platform whose SDK this repository downloads (e.g. " +
              "`macos-arm64`, `linux-x64`). Must match a key in `PLATFORMS` — " +
              "cross-only targets have no SDK of their own, so they are not " +
              "valid here.",
        mandatory = True,
        values = PLATFORMS.keys(),
    ),
}

def _dart_sdk_repo_impl(repository_ctx):
    version = repository_ctx.attr.dart_version
    platform = repository_ctx.attr.platform

    url = "https://storage.googleapis.com/dart-archive/channels/stable/release/{version}/sdk/dartsdk-{platform}-release.zip".format(
        version = version,
        platform = platform,
    )
    sha256 = TOOL_VERSIONS[version][platform]
    repository_ctx.download_and_extract(
        url = url,
        sha256 = sha256,
        stripPrefix = "dart-sdk",
    )

    # Determine the dart binary name based on platform
    if platform.startswith("windows"):
        dart_bin = "bin/dart.exe"
    else:
        dart_bin = "bin/dart"

    cross_prefix = repository_ctx.attr.cross_repo_prefix
    if not cross_prefix:
        cross_prefix = repository_ctx.attr.name.split("+")[-1]

    # Generate cross-compilation toolchain targets for this SDK. These reuse
    # this host SDK's `dart` binary and pull the target-specific `gen_snapshot`
    # and `dartaotruntime` from the companion `dart_cross_repositories` repo.
    cross_targets = []
    for target_platform in CROSS_TARGETS.get(platform, []):
        artifacts = resolve_cross_sdk_artifacts(version, platform, target_platform)
        cross_repo = "%s_cross_%s" % (cross_prefix, target_platform)
        cross_targets.append((
            target_platform,
            TARGET_PLATFORMS[target_platform].dart_os,
            TARGET_PLATFORMS[target_platform].dart_arch,
            "@%s//:%s" % (cross_repo, artifacts.gen_snapshot_filename),
            "@%s//:%s" % (cross_repo, artifacts.dartaotruntime_filename),
        ))

    build_content = """# Generated by dart/repositories.bzl
load("@rules_dart//dart:toolchain.bzl", "declare_dart_sdk_toolchains")

exports_files([{dart_bin}], visibility = ["//visibility:public"])

declare_dart_sdk_toolchains(
    version = {version},
    dart = {dart_bin},
    cross_targets = {cross_targets},
)
""".format(
        version = repr(version),
        dart_bin = repr(dart_bin),
        cross_targets = repr(cross_targets),
    )

    repository_ctx.file("BUILD.bazel", build_content)

dart_repositories = repository_rule(
    _dart_sdk_repo_impl,
    doc = _DOC,
    attrs = _ATTRS,
)

_CROSS_DOC = "Fetch the cross-compilation SDK artifacts (gen_snapshot and dartaotruntime) for a given version, host platform, and target platform"
_CROSS_ATTRS = {
    "dart_version": attr.string(
        doc = "The Dart SDK version to download (e.g. `3.11.0`). Must be a version listed in `versions.bzl`.",
        mandatory = True,
        values = TOOL_VERSIONS.keys(),
    ),
    "host_platform": attr.string(
        doc = "The host platform where compilation runs (e.g. `linux-x64`).",
        mandatory = True,
        values = PLATFORMS.keys(),
    ),
    "target_platform": attr.string(
        doc = "The cross-compilation target platform (e.g. `linux-riscv64`).",
        mandatory = True,
        values = TARGET_PLATFORMS.keys(),
    ),
}

def _dart_cross_sdk_repo_impl(repository_ctx):
    artifacts = resolve_cross_sdk_artifacts(
        dart_version = repository_ctx.attr.dart_version,
        exec_platform = repository_ctx.attr.host_platform,
        target_platform = repository_ctx.attr.target_platform,
    )
    repository_ctx.download(
        url = artifacts.gen_snapshot_url,
        output = artifacts.gen_snapshot_filename,
        sha256 = artifacts.gen_snapshot_sha256,
        executable = True,
    )
    repository_ctx.download(
        url = artifacts.dartaotruntime_url,
        output = artifacts.dartaotruntime_filename,
        sha256 = artifacts.dartaotruntime_sha256,
        executable = True,
    )
    build_content = """# Generated by dart/repositories.bzl
exports_files(
    [
        {gen_snapshot},
        {dartaotruntime},
    ],
    visibility = ["//visibility:public"],
)
""".format(
        gen_snapshot = repr(artifacts.gen_snapshot_filename),
        dartaotruntime = repr(artifacts.dartaotruntime_filename),
    )
    repository_ctx.file("BUILD.bazel", build_content)

dart_cross_repositories = repository_rule(
    _dart_cross_sdk_repo_impl,
    doc = _CROSS_DOC,
    attrs = _CROSS_ATTRS,
)

def dart_register_toolchains(name, **kwargs):
    """Convenience macro for setting up Dart SDK repositories.

    - create a repository for each built-in platform like "dart_linux_x64"
    - create a repository for each cross-compilation (host, target) pair
    - create a repository exposing toolchains for each platform like "dart_toolchains"
    Users can avoid this macro and do these steps themselves, if they want more control.

    Args:
        name: base name for all created repos, like "dart"
        **kwargs: passed to each dart_repositories call
    """
    for platform in PLATFORMS.keys():
        host_repo_name = name + "_" + platform
        dart_repositories(
            name = host_repo_name,
            platform = platform,
            cross_repo_prefix = host_repo_name,
            **kwargs
        )
        for target_platform in CROSS_TARGETS.get(platform, []):
            dart_cross_repositories(
                name = "%s_cross_%s" % (host_repo_name, target_platform),
                host_platform = platform,
                target_platform = target_platform,
                **kwargs
            )
        for version in TOOL_VERSIONS.keys():
            ver_repo_name = "%s_%s_%s" % (name, version.replace(".", "_"), platform)
            dart_repositories(
                name = ver_repo_name,
                platform = platform,
                dart_version = version,
                cross_repo_prefix = ver_repo_name,
            )
            for target_platform in CROSS_TARGETS.get(platform, []):
                dart_cross_repositories(
                    name = "%s_cross_%s" % (ver_repo_name, target_platform),
                    host_platform = platform,
                    target_platform = target_platform,
                    dart_version = version,
                )

    toolchains_repo(
        name = name + "_toolchains",
        user_repository_name = name,
        versions = list(TOOL_VERSIONS.keys()),
    )
