# Tests (both without and with `package_name`) that do NOT stage `lib/` files
# in `srcs` and import `../lib/testpkg.dart` relatively. They stay in summary
# mode (`expect_summaries = True`) and resolve `../lib/testpkg.dart` from
# `:testpkg_lib`'s summary. Tagged `manual` because modular kernel compilation
# requires `lib/testpkg.dart` in `srcs` for relative `../lib/` imports at
# runtime; `dart_analysis_test` and the mode tests exercise their analysis.
dart_test(
    name = "testpkg_no_pkg_rel_import_test",
    size = "small",
    main = "test/testpkg_rel_test.dart",
    tags = ["manual"],
    deps = [":testpkg_lib"],
)

default_mode_test(
    name = "testpkg_no_pkg_rel_import_mode_test",
    size = "small",
    expect_summaries = True,
    target_under_test = ":testpkg_no_pkg_rel_import_test",
)

summaries_off_mode_test(
    name = "testpkg_no_pkg_rel_import_off_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_no_pkg_rel_import_test",
)

dart_analysis_test(
    name = "testpkg_no_pkg_rel_import_analysis_test",
    size = "small",
    targets = [":testpkg_no_pkg_rel_import_test"],
)

dart_test(
    name = "testpkg_rel_import_test",
    package_name = "testpkg_fixture",
    size = "small",
    language_version = "3.11",
    main = "test/testpkg_rel_test.dart",
    tags = ["manual"],
    deps = [":testpkg_lib"],
