load(
    "//dart:defs.bzl",
    "dart_analysis_test",
    "dart_binary",
    "dart_js_binary",
    "dart_library",
    "dart_test",
    "dart_wasm_binary",
)
load("//dart/tests:analyze_test.bzl", "analyzed_test")
load(
    "//dart/tests:analyzer_summary_test.bzl",
    "default_mode_test",
    "summaries_off_mode_test",
)

# A test in the same package as its library, and so covered by the library's
# summary. It stages none of the package's `lib/` files, so its analysis is in
# summary mode, and its `package:` import resolves from that summary.
dart_library(
    name = "testpkg_lib",
    package_name = "testpkg_fixture",
    srcs = ["lib/testpkg.dart"],
    language_version = "3.11",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "testpkg_test",
    package_name = "testpkg_fixture",
    size = "small",
    language_version = "3.11",
    main = "test/testpkg_test.dart",
    deps = [":testpkg_lib"],
)

default_mode_test(
    name = "testpkg_test_mode_test",
    size = "small",
    expect_summaries = True,
    target_under_test = ":testpkg_test",
)

# The same test with the `test` package among its deps. That package's own
# target is a wrapper over its library, which re-lists the same files; it must
# not split the package, or every test using `package:test` falls back to source.
dart_test(
    name = "testpkg_test_with_pkg_test",
    package_name = "testpkg_fixture",
    size = "small",
    language_version = "3.11",
    main = "test/testpkg_with_pkg_test.dart",
    deps = [
        ":testpkg_lib",
        "@ext_pub_deps//:test",
    ],
)

default_mode_test(
    name = "testpkg_test_with_pkg_mode_test",
    size = "small",
    expect_summaries = True,
    target_under_test = ":testpkg_test_with_pkg_test",
)

dart_analysis_test(
    name = "testpkg_test_analysis_test",
    size = "small",
    targets = [":testpkg_test"],
)

# A test that adds a generated `lib/` file of its own to the package its
# dependency already summarizes (`has_own_lib`). Even with no hand-written
# `lib/` source on the test, the generated `lib/` file splits the package, so
# the test falls back to source analysis rather than reading a summary that
# lacks the generated library.
genrule(
    name = "gen_extra_lib",
    outs = ["lib/extra.g.dart"],
    cmd = "echo \"String extraValue() => 'extra';\" > $@",
)

dart_test(
    name = "testpkg_gen_lib_test",
    package_name = "testpkg_fixture",
    size = "small",
    srcs = [":gen_extra_lib"],
    language_version = "3.11",
    main = "test/testpkg_gen_lib_test.dart",
    deps = [":testpkg_lib"],
)

default_mode_test(
    name = "testpkg_gen_lib_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_gen_lib_test",
)

summaries_off_mode_test(
    name = "testpkg_gen_lib_off_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_gen_lib_test",
)

dart_analysis_test(
    name = "testpkg_gen_lib_analysis_test",
    size = "small",
    targets = [":testpkg_gen_lib_test"],
)

# The same generated `lib/` source on a test that omits `package_name` (relying
# on `:testpkg_lib` to declare the package). It must also detect the staged
# `lib/` file and fall back to source analysis so summary and non-summary modes
# agree.
dart_test(
    name = "testpkg_no_pkg_gen_lib_test",
    size = "small",
    srcs = [":gen_extra_lib"],
    main = "test/testpkg_gen_lib_test.dart",
    deps = [":testpkg_lib"],
)

default_mode_test(
    name = "testpkg_no_pkg_gen_lib_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_no_pkg_gen_lib_test",
)

summaries_off_mode_test(
    name = "testpkg_no_pkg_gen_lib_off_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_no_pkg_gen_lib_test",
)

dart_analysis_test(
    name = "testpkg_no_pkg_gen_lib_analysis_test",
    size = "small",
    targets = [":testpkg_no_pkg_gen_lib_test"],
)

# Executables that omit `package_name` and list `lib/testpkg.dart` in `srcs`
# alongside a relative `../lib/testpkg.dart` import. Staging `lib/testpkg.dart`
# alongside `:testpkg_lib`'s summary would collide with the summary's
# `package:testpkg_fixture/testpkg.dart` URI (`NotPathOfUriResult`), so summary
# mode must fall back to source analysis and agree with non-summary mode.
dart_test(
    name = "testpkg_no_pkg_rel_lib_srcs_test",
    size = "small",
    srcs = [
        "lib/testpkg.dart",
        "test/testpkg_rel_test.dart",
    ],
    main = "test/testpkg_rel_test.dart",
    deps = [":testpkg_lib"],
)

default_mode_test(
    name = "testpkg_no_pkg_rel_lib_srcs_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_no_pkg_rel_lib_srcs_test",
)

summaries_off_mode_test(
    name = "testpkg_no_pkg_rel_lib_srcs_off_mode_test",
    size = "small",
    expect_summaries = False,
    target_under_test = ":testpkg_no_pkg_rel_lib_srcs_test",
)

dart_analysis_test(
    name = "testpkg_no_pkg_rel_lib_srcs_analysis_test",
    size = "small",
    targets = [":testpkg_no_pkg_rel_lib_srcs_test"],
)

dart_binary(
