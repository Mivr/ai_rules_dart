def _parse_pubspec_block_fold_test_impl(ctx):
    env = unittest.begin(ctx)

    # Block scalars fold through the public entries with their dependencies
    # and SDK constraint, as pub reads each form below (package:yaml 3.1.4
    # with the pinned SDK 3.13.5).
    pubspec = "name: foldenv\ndescription: a long description\n  continued here\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  foo: ^1.0.0\n"
    asserts.equals(env, "a long description continued here", parse_pubspec_document(pubspec)["description"])
    asserts.equals(env, ["foo"], parse_pubspec_deps(pubspec))
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(pubspec))
    asserts.equals(env, None, parse_pubspec_document_error(pubspec, "//:pubspec.yaml"))

    quoted = "name: q\ndescription: \"quoted\ncontinued\"\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  foo: ^1.0.0\n"
    asserts.equals(env, "quoted continued", parse_pubspec_document(quoted)["description"])
    asserts.equals(env, ["foo"], parse_pubspec_deps(quoted))
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(quoted))

    ranged = "name: r\nenvironment:\n  sdk: \">=3.0.0\n  <4.0.0\"\n"
    asserts.equals(env, ">=3.0.0 <4.0.0", parse_pubspec_sdk_constraint(ranged))

    typed = "name: t\nversion: 1\n  beta\n"
    asserts.equals(env, "1 beta", parse_pubspec_document(typed)["version"])

    # Text after a closing quote and a comment-ended scalar with a stray
    # continuation fail naming the package and the line, as pub rejects them.
    err = parse_pubspec_document_error("name: x\ndescription: \"oops\"\n  trailing\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 2" in err)
    err = parse_pubspec_document_error("name: x\ndescription: one\n  two # c\n  three\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 4" in err)
    return unittest.end(env)

def _parse_pubspec_literal_fold_test_impl(ctx):
    env = unittest.begin(ctx)

    # Folded (`>`) and literal (`|`) block scalars read as pub reads them
    # (package:yaml 3.1.4 with the pinned SDK 3.13.5): a break between two
    # content lines folds to one space, a break after a content line is
    # dropped when blank lines follow it, each blank line becomes one "\n",
    # leading blanks are kept, breaks around more-indented lines are kept,
    # and spaces beyond the indentation on a blank line are content.
    h = "name: x\nenvironment:\n  sdk: ^3.0.0\n"
    asserts.equals(env, "alpha\nbeta\n", parse_pubspec_document(h + "notes: >\n  alpha\n\n  beta\n")["notes"])
    asserts.equals(env, "alpha\n\nbeta\n", parse_pubspec_document(h + "notes: >\n  alpha\n\n\n  beta\n")["notes"])
    asserts.equals(env, "\nalpha\n", parse_pubspec_document(h + "notes: >\n\n  alpha\n")["notes"])
    asserts.equals(env, ["alpha\nbeta\n"], parse_pubspec_document(h + "tags:\n  - >\n    alpha\n\n    beta\n")["tags"])
    asserts.equals(env, "alpha\n \nbeta", parse_pubspec_document(h + "notes: >-\n  alpha\n   \n  beta\n")["notes"])
    asserts.equals(env, "", parse_pubspec_document(h + "notes: >\nnext: 1\n")["notes"])
    asserts.equals(env, "\n\n", parse_pubspec_document(h + "notes: >+\n\n\nnext: 1\n")["notes"])
    asserts.equals(env, "", parse_pubspec_document(h + "notes: |\n\n\nnext: 1\n")["notes"])
    asserts.equals(env, [{"k": "x y\n"}], parse_pubspec_document(h + "tags:\n  - k: >\n      x\n      y\n")["tags"])
    asserts.equals(env, [{"k": "x\n\ny\n"}], parse_pubspec_document(h + "tags:\n  - k: |\n      x\n\n      y\n")["tags"])

    # A header with text after the indicator, and a line less indented than
    # the scalar, end in failure naming the package and the line, as pub
    # rejects every one of these documents.
    for bad in [
        h + "notes: > foo\n  bar\n",
        h + "notes: >x\n  alpha\n",
        h + "notes: >\n  alpha\n beta\n",
        h + "notes: >\n    beta\n  gamma\n",
        h + "notes: >2\n x\n",
    ]:
        err = parse_pubspec_document_error(bad, "//:pubspec.yaml")
        asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err, "rejected block scalar reads an error: %r" % bad)
    return unittest.end(env)

def _parse_pubspec_more_indented_blank_test_impl(ctx):
    env = unittest.begin(ctx)

    # The break after a content line drops only when the next non-blank
    # line is a base-indented line it folds into. When a more-indented line
    # follows, the break stays and each blank line adds one "\n", as pub
    # reads each form below (package:yaml 3.1.4 with the pinned SDK 3.13.5).
    h = "name: x\nenvironment:\n  sdk: ^3.0.0\n"
    asserts.equals(env, "alpha\n\n  indented\n\nbeta\n", parse_pubspec_document(h + "notes: >\n  alpha\n\n    indented\n\n  beta\n")["notes"])
    asserts.equals(env, "a\n\n  b\nc\n", parse_pubspec_document(h + "notes: >\n  a\n\n    b\n  c\n")["notes"])
    asserts.equals(env, "a\n\n\n  b\nc\n", parse_pubspec_document(h + "notes: >\n  a\n\n\n    b\n  c\n")["notes"])
    asserts.equals(env, "a\n  b\n\nc\n", parse_pubspec_document(h + "notes: >\n  a\n    b\n\n  c\n")["notes"])
    asserts.equals(env, "a\n\n  b\n\nc\n", parse_pubspec_document(h + "notes: >\n  a\n\n    b\n\n  c\n")["notes"])
    return unittest.end(env)

def _parse_pubspec_keep_eof_test_impl(ctx):
    env = unittest.begin(ctx)

    # A keep (`+`) scalar that runs to the end of the file keeps the final
    # break and every trailing blank line, but not the file's own final
    # newline, as pub reads each form below (package:yaml 3.1.4 with the
    # pinned SDK 3.13.5).
    h = "name: x\nenvironment:\n  sdk: ^3.0.0\n"
    asserts.equals(env, "red\n\n", parse_pubspec_document(h + "summary: |+\n  red\n\n")["summary"])
    asserts.equals(env, "red\n", parse_pubspec_document(h + "summary: |+\n  red\n")["summary"])
    asserts.equals(env, "red\n\n\n", parse_pubspec_document(h + "summary: |+\n  red\n\n\n")["summary"])
    asserts.equals(env, "\n", parse_pubspec_document(h + "summary: |+\n\n")["summary"])
    asserts.equals(env, "", parse_pubspec_document(h + "summary: |+\n")["summary"])
    asserts.equals(env, "red\n\n", parse_pubspec_document(h + "summary: >+\n  red\n\n")["summary"])
    asserts.equals(env, "red\n\n", parse_pubspec_document(h + "summary: |+\n  red\n  \n")["summary"])
