def _parse_lock_unquoted_version_test_impl(ctx):
    env = unittest.begin(ctx)

    # An unquoted `1.10` is a float, not a version pub writes: it fails
    # naming the lock and the entry's line, never showing the re-spelled "1.1".
    err = pubspec_lock_error("packages:\n  p:\n    source: hosted\n    version: 1.10\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)
    asserts.true(env, "1.1" not in err)
    return unittest.end(env)

def _parse_lock_doc_end_test_impl(ctx):
    env = unittest.begin(ctx)

    # Content after a `...` line fails, naming its 1-based line.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n...\npackages:\n  b:\n    source: hosted\n    version: \"2.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 6" in err)

    # A final `...` stays allowed, as does a leading `---`.
    asserts.equals(env, None, pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n...\n", "//:pubspec.lock"))
    asserts.equals(env, None, pubspec_lock_error("---\npackages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n", "//:pubspec.lock"))
    return unittest.end(env)

def _parse_lock_second_doc_test_impl(ctx):
    env = unittest.begin(ctx)

    # A second `---` fails at the marker's line, as pub rejects the second
    # document there; content after it never reads.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n---\npackages:\n  b:\n    source: hosted\n    version: \"2.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 5" in err)

    # A bare second `---` still fails, naming the marker's own line.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n---\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 5" in err)
    return unittest.end(env)

def _parse_lock_tab_indent_test_impl(ctx):
    env = unittest.begin(ctx)

    # A tab in a content line's indentation fails, naming the line.
    err = pubspec_lock_error("packages:\n\ta:\n    source: hosted\n    version: \"1.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)

    # A tab after the indentation stays allowed.
    asserts.equals(env, None, pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version:\t\"1.0.0\"\n", "//:pubspec.lock"))
    return unittest.end(env)

def _parse_lock_quote_trailer_test_impl(ctx):
    env = unittest.begin(ctx)

    # Text after a quoted scalar's closing quote fails, naming the line.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\" junk\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 4" in err)

    # The same junk inside a flow value fails at the description's line.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\"\n    description: {url: \"https://x\" \"junk\"}\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 5" in err)

    # A trailing `#` comment after the closing quote stays allowed.
    asserts.equals(env, None, pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\" # comment\n", "//:pubspec.lock"))
    return unittest.end(env)

def _parse_lock_entry_name_test_impl(ctx):
    env = unittest.begin(ctx)

    # A name pub could never write fails, naming it.
    err = pubspec_lock_error("packages:\n  9lives:\n    source: hosted\n    version: \"1.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "9lives" in err)
    err = pubspec_lock_error("packages:\n  has-dash:\n    source: hosted\n    version: \"1.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "has-dash" in err)

    # Leading underscores and capitals stay valid.
    result = parse_pubspec_lock("packages:\n  _ok:\n    source: hosted\n    version: \"1.0.0\"\n  CamelCase:\n    source: sdk\n    version: \"0.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, "_ok" in result and "CamelCase" in result)
    return unittest.end(env)

def _parse_lock_entry_case_test_impl(ctx):
    env = unittest.begin(ctx)

    # Names equal ignoring case collide, naming both.
    err = pubspec_lock_error("packages:\n  Foo:\n    source: hosted\n    version: \"1.0.0\"\n  foo:\n    source: hosted\n    version: \"2.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "Foo" in err and "foo" in err)

    # One capitalised name alone stays valid.
    asserts.equals(env, None, pubspec_lock_error("packages:\n  Foo:\n    source: hosted\n    version: \"1.0.0\"\n", "//:pubspec.lock"))
    return unittest.end(env)

def _parse_lock_entry_source_test_impl(ctx):
    env = unittest.begin(ctx)

    # A missing `source` is an error, never only a warning.
    err = pubspec_lock_error("packages:\n  a:\n    version: \"1.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "source" in err)

    # A non-string `source` fails, naming the entry's line.
    err = pubspec_lock_error("packages:\n  a:\n    source: 3\n    version: \"1.0.0\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)

    # Hosted, git, path and sdk entries parse, including a scalar description.
    result = parse_pubspec_lock("packages:\n  h:\n    source: hosted\n    version: \"1.0.0\"\n  g:\n    source: git\n    version: \"1.0.0\"\n  p:\n    source: path\n    version: \"0.0.0\"\n  s:\n    description: flutter\n    source: sdk\n    version: \"0.0.0\"\n", "//:pubspec.lock")
    asserts.equals(env, {"name": "flutter"}, result["s"]["description"])
    asserts.equals(env, "git", result["g"]["source"])
    return unittest.end(env)

def _parse_lock_entry_version_test_impl(ctx):
    env = unittest.begin(ctx)

    # An int version fails naming the entry's line, never showing a value.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: 3\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)
    asserts.true(env, " 3" not in err)

    # A non-semantic string version fails; a missing version fails too.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "version" in err and "line 2" in err)

    # Folded continuation text is not a version either.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: \"1.0.0\n      plus junk\"\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err)

    # An overflowing float version fails as a non-string version, naming the
    # entry's line instead of crashing the evaluation.
    err = pubspec_lock_error("packages:\n  a:\n    source: hosted\n    version: 1e999\n", "//:pubspec.lock")
    asserts.true(env, err != None and "//:pubspec.lock" in err and "line 2" in err)

    # Prerelease and build versions parse as pub writes them.
    result = parse_pubspec_lock("packages:\n  a:\n    source: hosted\n    version: \"1.2.3-dev.4+5\"\n  b:\n    source: hosted\n    version: \"0.0.0\"\n", "//:pubspec.lock")
    asserts.equals(env, "1.2.3-dev.4+5", result["a"]["version"])
    asserts.equals(env, "0.0.0", result["b"]["version"])
    return unittest.end(env)

def _parse_pubspec_deps_flow_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(
        env,
        ["a", "b"],
        parse_pubspec_deps("name: x\ndependencies: {a: ^1.0.0, b: any}\n"),
    )
    asserts.equals(env, [], parse_pubspec_deps("name: x\ndependencies: []\n"))

    # A non-mapping root is an error naming the label and the line (M-12).
    err = parse_pubspec_document_error("- not a mapping\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 1" in err)
    return unittest.end(env)

def _parse_pubspec_document_test_impl(ctx):
    env = unittest.begin(ctx)

    # Compact sequences and folded scalars read through the public entry (M-12).
    asserts.equals(
        env,
        {"name": "x", "topics": ["a", "b"]},
        parse_pubspec_document("name: x\ntopics:\n- a\n- b\n"),
    )
    asserts.equals(
        env,
        parse_pubspec_document("name: x\ntopics:\n  - a\n  - b\n"),
        parse_pubspec_document("name: x\ntopics:\n- a\n- b\n"),
    )
    asserts.equals(
        env,
        "a long description continued",
        parse_pubspec_document("name: x\ndescription:\n  a long description\n  continued\n")["description"],
    )
    asserts.equals(env, {}, parse_pubspec_document(""))
    asserts.equals(env, {}, parse_pubspec_document("# only a comment\n"))

    # A byte-order mark and CRLF line ends keep working.
    asserts.equals(
        env,
        {"name": "x", "topics": ["a"]},
        parse_pubspec_document("\357\273\277name: x\r\ntopics:\r\n- a\r\n"),
    )
    asserts.equals(env, None, parse_pubspec_document_error("name: x\ntopics:\n- a\n"))
    return unittest.end(env)

def _parse_pubspec_document_error_test_impl(ctx):
    env = unittest.begin(ctx)

    # Every failure names the package (or label) and the line (M-12).
    err = parse_pubspec_document_error("name: x\na: 1\na: 2\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 3" in err)
    err = parse_pubspec_document_error("name: x\nno colon here\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 2" in err)
    err = parse_pubspec_document_error("name: x\n- stray\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 2" in err)

    # Without `name:` the message names the label.
    err = parse_pubspec_document_error("a: 1\na: 2\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 2" in err)
    err = parse_pubspec_document_error("- just\n- a\n- list\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 1" in err)

    # A second document marker and content after `...` fail naming the
    # pubspec and the line, as pub reads one document only.
    err = parse_pubspec_document_error("name: x\n---\ndependencies:\n  a: any\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 2" in err)
    err = parse_pubspec_document_error("name: x\n...\ndependencies:\n  a: any\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 3" in err)

    # A byte-order mark past the stream start fails naming the pubspec and
    # the line, as pub rejects it.
    err = parse_pubspec_document_error("name: x\ndescription: \357\273\277long\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "x" in err and "//:pubspec.yaml" in err and "line 2" in err)
    return unittest.end(env)

def _parse_pubspec_sdk_numeric_test_impl(ctx):
    env = unittest.begin(ctx)
    asserts.equals(env, "3", parse_pubspec_sdk_constraint("environment:\n  sdk: 3\n"))
    asserts.equals(env, "", parse_pubspec_sdk_constraint("environment:\n  sdk:\n"))
    asserts.equals(env, "", parse_pubspec_sdk_constraint("environment: 3\n"))
    return unittest.end(env)

def _lock_package_missing_sha256_test_impl(ctx):
    env = unittest.begin(ctx)
    parsed = parse_pubspec_lock(_SAMPLE_LOCK)
    asserts.equals(env, None, lock_package_error("collection", parsed["collection"], "//:pubspec.lock"))
    asserts.equals(env, None, lock_package_error("flutter", parsed["flutter"], "//:pubspec.lock"))
    asserts.true(env, is_valid_sha256(_COLLECTION_SHA))
    asserts.true(env, is_valid_sha256("  " + _COLLECTION_SHA + "\n"))
    asserts.false(env, is_valid_sha256(""))
    asserts.false(env, is_valid_sha256("   "))
    asserts.false(env, is_valid_sha256("abc123"))
    asserts.false(env, is_valid_sha256(_COLLECTION_SHA.upper()))
    asserts.false(env, is_valid_sha256(_COLLECTION_SHA[:63]))
    asserts.false(env, is_valid_sha256(_COLLECTION_SHA + "0"))
    asserts.false(env, is_valid_sha256("g" + _COLLECTION_SHA[1:]))

    unpinned_lock = """\
packages:
  collection:
    dependency: "direct main"
    description:
      name: collection
      url: "https://pub.dev"
    source: hosted
    version: "1.18.0"
  empty_sha:
    dependency: "direct main"
    description:
      name: empty_sha
      sha256:
      url: "https://pub.dev"
    source: hosted
    version: "2.0.0"
  whitespace_sha:
    dependency: "direct main"
    description:
      name: whitespace_sha
      sha256: "   "
      url: "https://pub.dev"
    source: hosted
    version: "1.9.0"
  short_sha:
    dependency: "direct main"
    description:
      name: short_sha
      sha256: abc123
      url: "https://pub.dev"
    source: hosted
    version: "1.0.0"
  upper_sha:
    dependency: "direct main"
    description:
      name: upper_sha
      sha256: "EE67CB0715911D28DB6BF4AF1026078BD6F0128B07A5F66FB2ED94EF6783C09A"
      url: "https://pub.dev"
    source: hosted
    version: "1.0.0"
"""
    unpinned = parse_pubspec_lock(unpinned_lock)
    asserts.equals(
        env,
        'pub package "collection" 1.18.0 in //:pubspec.lock has no sha256. Run `dart pub get` (Dart 2.19 or newer records one) and commit the lock.',
        lock_package_error("collection", unpinned["collection"], "//:pubspec.lock"),
    )
    asserts.equals(
        env,
        'pub package "empty_sha" 2.0.0 in //:pubspec.lock has no sha256. Run `dart pub get` (Dart 2.19 or newer records one) and commit the lock.',
        lock_package_error("empty_sha", unpinned["empty_sha"], "//:pubspec.lock"),
    )
    asserts.equals(
        env,
        'pub package "whitespace_sha" 1.9.0 in //:pubspec.lock has no sha256. Run `dart pub get` (Dart 2.19 or newer records one) and commit the lock.',
        lock_package_error("whitespace_sha", unpinned["whitespace_sha"], "//:pubspec.lock"),
    )
    asserts.equals(
        env,
        'pub package "short_sha" 1.0.0 in //:pubspec.lock has invalid sha256 "abc123": expected 64 lowercase hex digits.',
        lock_package_error("short_sha", unpinned["short_sha"], "//:pubspec.lock"),
    )
    asserts.equals(
        env,
        'pub package "upper_sha" 1.0.0 in //:pubspec.lock has invalid sha256 "EE67CB0715911D28DB6BF4AF1026078BD6F0128B07A5F66FB2ED94EF6783C09A": expected 64 lowercase hex digits.',
        lock_package_error("upper_sha", unpinned["upper_sha"], "//:pubspec.lock"),
    )
    asserts.equals(env, None, pub_lock_package_sha256_error("collection", "1.18.0", _COLLECTION_SHA))
    asserts.equals(env, None, pub_lock_package_sha256_error("collection", "1.18.0", "  " + _COLLECTION_SHA + "  "))
    asserts.equals(
        env,
        'pub_lock_package "collection" (1.18.0) requires a non-empty sha256.',
        pub_lock_package_sha256_error("collection", "1.18.0", ""),
    )
    asserts.equals(
        env,
        'pub_lock_package "collection" (1.18.0) requires a non-empty sha256.',
        pub_lock_package_sha256_error("collection", "1.18.0", "   "),
    )
    asserts.equals(
        env,
        'pub_lock_package "collection" (1.18.0) has invalid sha256 "abc123": expected 64 lowercase hex digits.',
        pub_lock_package_sha256_error("collection", "1.18.0", "abc123"),
    )
    asserts.equals(env, None, pub_package_sha256_error("collection", "1.18.0", _COLLECTION_SHA))
    asserts.equals(env, None, pub_package_sha256_error("collection", "1.18.0", "  " + _COLLECTION_SHA + "  "))
    asserts.equals(
        env,
        'pub_package "collection" (1.18.0) requires a non-empty sha256.',
        pub_package_sha256_error("collection", "1.18.0", ""),
    )
    asserts.equals(
        env,
        'pub_package "collection" (1.18.0) requires a non-empty sha256.',
        pub_package_sha256_error("collection", "1.18.0", "   "),
    )
    asserts.equals(
        env,
        'pub_package "collection" (1.18.0) has invalid sha256 "abc123": expected 64 lowercase hex digits.',
        pub_package_sha256_error("collection", "1.18.0", "abc123"),
    )
    return unittest.end(env)

