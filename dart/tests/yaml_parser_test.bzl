_GIT_REF = "0123456789abcdef0123456789abcdef01234567"

def _resolve_pub_packages_isolated_git_test_impl(ctx):
    env = unittest.begin(ctx)
    git_lock = parse_pubspec_lock("""\
packages:
  git_dep:
    dependency: "direct main"
    description:
      path: "pkgs/git_dep"
      ref: main
      resolved-ref: "%s"
      url: "https://example.com/repo.git"
    source: git
    version: "1.2.3"
""" % _GIT_REF)

    # A git entry in an isolated hub stays out of the global registry and is
    # pinned by the hub itself.
    res = resolve_pub_packages(
        [],
        [struct(name = "tool_deps", lock = "//:tool.lock", packages = git_lock, on_version_conflict = "error", isolated = True)],
    )
    asserts.equals(env, None, res.error)
    asserts.equals(env, 0, len(res.resolved_git))
    asserts.true(env, "tool_deps" in res.isolated_git_packages)
    git_pkg = res.isolated_git_packages["tool_deps"]["git_dep"]
    asserts.equals(env, "1.2.3", git_pkg.version)
    asserts.equals(env, "https://example.com/repo.git", git_pkg.url)
    asserts.equals(env, _GIT_REF, git_pkg.resolved_ref)
    asserts.equals(env, "pkgs/git_dep", git_pkg.path)
    asserts.true(env, "git_dep" in res.hub_packages["tool_deps"])

    # The same git package in a shared hub still joins the global registry
    # while the isolated hub keeps its own pin.
    res_both = resolve_pub_packages(
        [],
        [
            struct(name = "tool_deps", lock = "//:tool.lock", packages = git_lock, on_version_conflict = "error", isolated = True),
            struct(name = "app_deps", lock = "//:app.lock", packages = git_lock, on_version_conflict = "error", isolated = False),
        ],
    )
    asserts.equals(env, None, res_both.error)
    asserts.equals(env, _GIT_REF, res_both.resolved_git["git_dep"].resolved_ref)
    asserts.equals(env, _GIT_REF, res_both.isolated_git_packages["tool_deps"]["git_dep"].resolved_ref)
    asserts.true(env, "git_dep" in res_both.hub_packages["app_deps"])

    return unittest.end(env)

def _resolve_pub_packages_conflict_test_impl(ctx):
    env = unittest.begin(ctx)

    ext_lock = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "%s"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.1"
""" % _PATH_191_SHA)

    # 1. A lower-version lock entry with whitespace-only sha256 fails even when
    # upgraded to ext_pub_deps's higher version.
    ws_lock = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "   "
      url: "https://pub.dev"
    source: hosted
    version: "1.9.0"
""")
    res_ws = resolve_pub_packages(
        [],
        [
            struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade"),
            struct(name = "user_deps", lock = "//:pubspec.lock", packages = ws_lock, on_version_conflict = "upgrade"),
        ],
    )
    asserts.true(env, res_ws.error != None and 'pub package "path" 1.9.0 in //:pubspec.lock has no sha256.' in res_ws.error)

    # 2. A lower-version lock entry with non-64-hex sha256 fails even when
    # upgraded to ext_pub_deps's higher version.
    bad_hex_lock = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "badhex"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.0"
""")
    res_bad_hex = resolve_pub_packages(
        [],
        [
            struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade"),
            struct(name = "user_deps", lock = "//:pubspec.lock", packages = bad_hex_lock, on_version_conflict = "upgrade"),
        ],
    )
    asserts.true(env, res_bad_hex.error != None and 'pub package "path" 1.9.0 in //:pubspec.lock has invalid sha256' in res_bad_hex.error)

    # 3. Same version across two locks with different 64-hex sha256 fails.
    conflict_same_ver_lock = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "%s"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.1"
""" % _ALT_SHA)
    res_same_ver = resolve_pub_packages(
        [],
        [
            struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade"),
            struct(name = "user_deps", lock = "//:pubspec.lock", packages = conflict_same_ver_lock, on_version_conflict = "upgrade"),
        ],
    )
    asserts.true(env, res_same_ver.error != None and 'Package "path" (1.9.1) has conflicting sha256 checksums across lock files' in res_same_ver.error)

    # 4. Two lower-version locks disagreeing on sha256 for 1.9.0 fail even when
    # superseded by 1.9.1 in a third lock.
    lock_190_a = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "%s"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.0"
""" % _PATH_190_SHA)
    lock_190_b = parse_pubspec_lock("""\
packages:
  path:
    dependency: "direct main"
    description:
      name: path
      sha256: "%s"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.0"
""" % _ALT_SHA)
    res_superseded_conflict = resolve_pub_packages(
        [],
        [
            struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade"),
            struct(name = "deps_a", lock = "//:lock_a.lock", packages = lock_190_a, on_version_conflict = "upgrade"),
            struct(name = "deps_b", lock = "//:lock_b.lock", packages = lock_190_b, on_version_conflict = "upgrade"),
        ],
    )
    asserts.true(env, res_superseded_conflict.error != None and 'Package "path" (1.9.0) has conflicting sha256 checksums across lock files' in res_superseded_conflict.error)

    # 5. Conflicting sha256 between pub.package() and pub.from_lock() for the
    # same version fails.
    res_explicit_lock_conflict = resolve_pub_packages(
        [struct(name = "path", version = "1.9.1", sha256 = _ALT_SHA, deps = [])],
        [struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade")],
    )
    asserts.true(env, res_explicit_lock_conflict.error != None and 'Package "path" (1.9.1) has conflicting sha256 checksums between pub.package()' in res_explicit_lock_conflict.error)

    # 6. Duplicate pub.package() declarations where the second has whitespace or
    # conflicting sha256 fail.
    res_dup_pkg_ws = resolve_pub_packages(
        [
            struct(name = "path", version = "1.9.1", sha256 = _PATH_191_SHA, deps = []),
            struct(name = "path", version = "1.9.1", sha256 = "   ", deps = []),
        ],
        [],
    )
    asserts.equals(env, 'pub_package "path" (1.9.1) requires a non-empty sha256.', res_dup_pkg_ws.error)

    res_dup_pkg_conflict = resolve_pub_packages(
        [
            struct(name = "path", version = "1.9.1", sha256 = _PATH_191_SHA, deps = []),
            struct(name = "path", version = "1.9.1", sha256 = _ALT_SHA, deps = []),
        ],
        [],
    )
    asserts.true(env, res_dup_pkg_conflict.error != None and 'Package "path" (1.9.1) has conflicting sha256 checksums across pub.package() declarations' in res_dup_pkg_conflict.error)

    # 7. Valid upgrade across locks with valid 64-hex sha256s succeeds.
    res_ok = resolve_pub_packages(
        [],
        [
            struct(name = "ext_pub_deps", lock = "//dart/ext:pubspec.lock", packages = ext_lock, on_version_conflict = "upgrade"),
            struct(name = "deps_a", lock = "//:lock_a.lock", packages = lock_190_a, on_version_conflict = "upgrade"),
        ],
    )
    asserts.equals(env, None, res_ok.error)
    asserts.equals(env, "1.9.1", res_ok.resolved["path"].version)
    asserts.equals(env, _PATH_191_SHA, res_ok.resolved["path"].sha256)

    return unittest.end(env)

def _parse_pubspec_docmarker_test_impl(ctx):
    env = unittest.begin(ctx)

    # An indented `---` inside a `description: |` block is content: the
    # pubspec reads exactly like its marker-free twin, apart from the
    # description text, with deps and SDK constraint intact.
    bad = "name: docmark\ndescription: |\n  line one\n  ---\n  line two\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  bar:\n    path: ../stubbar\nflutter:\n  assets:\n    - assets/a.png\n"
    good = "name: docmark\ndescription: |\n  line one\n  continued\n  line two\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  bar:\n    path: ../stubbar\nflutter:\n  assets:\n    - assets/a.png\n"
    bad_doc = parse_pubspec_document(bad)
    good_doc = parse_pubspec_document(good)
    asserts.equals(env, sorted(good_doc.keys()), sorted(bad_doc.keys()))
    asserts.equals(env, ["bar"], parse_pubspec_deps(bad))
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(bad))
    asserts.equals(env, None, parse_pubspec_document_error(bad))
    asserts.true(env, "---" in bad_doc["description"])
    return unittest.end(env)

def _parse_pubspec_unsupported_test_impl(ctx):
    env = unittest.begin(ctx)

    # A flow collection that starts on its key's line folds its deeper lines
    # and reads as one value when the folded text parses, as pub reads it
    # (package:yaml 3.1.4 with the pinned SDK 3.13.5 reads ["premium",
    # "free"] below). A spanning flow that does not fold still fails naming
    # the pubspec, the line where the collection opens, and the form; see
    # the rejected span test.
    flow = "name: multiflow\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  bar:\n    path: ../stubbar\nflutter:\n  assets:\n    - path: assets/x.png\n      flavors: [premium,\n        free]\n"
    asserts.equals(env, ["premium", "free"], parse_pubspec_document(flow)["flutter"]["assets"][0]["flavors"])
    asserts.equals(env, None, parse_pubspec_document_error(flow))

    # An explicit key fails naming the pubspec, the `?` line, and the form.
    expl = "name: expl\nenvironment:\n  sdk: ^3.0.0\n? dependencies\n: {}\n"
    err = parse_pubspec_document_error(expl, "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 4" in err)
    asserts.true(env, "not supported" in err and "explicit" in err)
    return unittest.end(env)

def _parse_pubspec_folded_flow_test_impl(ctx):
    env = unittest.begin(ctx)

    # A flow collection that starts on the line after `key:` folds its deeper
    # lines with single spaces and reads as one value, as pub reads it.
    flow_key = "name: p1\nenvironment:\n  sdk: ^3.0.0\ndependencies:\n  bar:\n    path: ../stubbar\nflutter:\n  assets:\n    [a.txt,\n     b.txt]\n"
    asserts.equals(env, {"assets": ["a.txt", "b.txt"]}, parse_pubspec_document(flow_key)["flutter"])
    asserts.equals(env, ["bar"], parse_pubspec_deps(flow_key))
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(flow_key))
    asserts.equals(env, None, parse_pubspec_document_error(flow_key))

    # The same fold applies after a bare `-`: the flow is the entry's child.
    flow_dash = "name: p1\nenvironment:\n  sdk: ^3.0.0\nitems:\n  -\n    [a.txt,\n     b.txt]\n"
    asserts.equals(env, [["a.txt", "b.txt"]], parse_pubspec_document(flow_dash)["items"])
    asserts.equals(env, None, parse_pubspec_document_error(flow_dash))
    return unittest.end(env)

def _parse_pubspec_plain_question_test_impl(ctx):
    env = unittest.begin(ctx)

    # A `?` line that continues a plain scalar folds into it, as pub folds it.
    # The bare and tab-separated forms below read on main and on this head;
    # the space-separated form is covered head-only by
    # `_parse_pubspec_plain_question_space_test_impl`.
    asserts.equals(
        env,
        "some text ?\tmore text",
        parse_pubspec_document("name: p1\ndescription: some text\n  ?\tmore text\nenvironment:\n  sdk: ^3.0.0\n")["description"],
    )
    asserts.equals(
        env,
        "some text ?",
        parse_pubspec_document("name: p1\ndescription: some text\n  ?\nenvironment:\n  sdk: ^3.0.0\n")["description"],
    )
    asserts.equals(env, None, parse_pubspec_document_error("name: p1\ndescription: some text\n  ?\tmore text\nenvironment:\n  sdk: ^3.0.0\n"))
    asserts.equals(env, None, parse_pubspec_document_error("name: p1\ndescription: some text\n  ?\nenvironment:\n  sdk: ^3.0.0\n"))
    return unittest.end(env)

def _parse_pubspec_plain_question_space_test_impl(ctx):
    env = unittest.begin(ctx)

    # Head-only: a `? ` continuation folds into the scalar, as pub folds it.
    # Main stopped the scalar here and failed strict, so this form reads only
    # on this head; the oracle (package:yaml 3.1.4, `dart pub get --offline`
    # accepts the equivalent pubspec) reads "some text ? more text".
    asserts.equals(
        env,
        "some text ? more text",
        parse_pubspec_document("name: p1\ndescription: some text\n  ? more text\nenvironment:\n  sdk: ^3.0.0\n")["description"],
    )
    asserts.equals(env, None, parse_pubspec_document_error("name: p1\ndescription: some text\n  ? more text\nenvironment:\n  sdk: ^3.0.0\n"))
    return unittest.end(env)

def _parse_pubspec_flow_blank_test_impl(ctx):
    env = unittest.begin(ctx)

    # A blank line inside a folded flow is one "\n" in the scalar, as pub
    # reads it: plain, single- and double-quoted alike.
    blank = "name: p1\nenvironment:\n  sdk: ^3.0.0\ntags:\n  [alpha\n\n   beta, gamma]\n"
    asserts.equals(env, ["alpha\nbeta", "gamma"], parse_pubspec_document(blank)["tags"])
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(blank))
    asserts.equals(env, None, parse_pubspec_document_error(blank))
    asserts.equals(
        env,
        ["alpha\nbeta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  ['alpha\n\n   beta', gamma]\n")["tags"],
    )
    asserts.equals(
        env,
        ["alpha\nbeta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  [\"alpha\n\n   beta\", gamma]\n")["tags"],
    )

    # The same fold applies to a flow mapping value, after a bare `-`, and to
    # a blank line that holds only spaces.
    asserts.equals(
        env,
        {"a": "x\ny"},
        parse_pubspec_document("name: p1\nkey:\n  {a: x\n\n   y}\n")["key"],
    )
    asserts.equals(
        env,
        [["alpha\nbeta", "gamma"]],
        parse_pubspec_document("name: p1\nitems:\n  -\n    [alpha\n\n     beta, gamma]\n")["items"],
    )
    asserts.equals(
        env,
        ["alpha\nbeta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  [alpha\n   \n   beta, gamma]\n")["tags"],
    )

    # Outside quotes a blank run is one "\n"; inside quotes each blank line is
    # one "\n", as the oracle reads them.
    asserts.equals(
        env,
        ["alpha\nbeta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  [alpha\n\n\n   beta, gamma]\n")["tags"],
    )
    asserts.equals(
        env,
        ["alpha\n\nbeta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  [\"alpha\n\n\n   beta\", gamma]\n")["tags"],
    )

    # A blank or comment-only line between entries is harmless separation.
    asserts.equals(
        env,
        ["alpha", "beta"],
        parse_pubspec_document("name: p1\ntags:\n  [alpha,\n\n   beta]\n")["tags"],
    )
    asserts.equals(
        env,
        ["alpha", "beta", "gamma"],
        parse_pubspec_document("name: p1\ntags:\n  [alpha,\n# comment\n   beta, gamma]\n")["tags"],
    )
    return unittest.end(env)

def _parse_pubspec_flow_document_test_impl(ctx):
    env = unittest.begin(ctx)

    # A scalar that spans lines in a flow document folds its break to one
    # space and drops the indentation, as pub reads it.
    doc = "{name: x, environment: {sdk: ^3.0.0},\n description: one\n  two}\n"
    asserts.equals(env, "one two", parse_pubspec_document(doc)["description"])
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(doc))
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    asserts.equals(
        env,
        "one two",
        parse_pubspec_document("{description: \"one\n  two\"}\n")["description"],
    )
    asserts.equals(
        env,
        "one two",
        parse_pubspec_document("{description: 'one\n  two'}\n")["description"],
    )

    # A blank line between the lines is one "\n" outside quotes; inside
    # quotes each blank line is one "\n", as the oracle reads them.
    asserts.equals(env, "one\ntwo", parse_pubspec_document("{description: one\n\ntwo}\n")["description"])
    asserts.equals(env, "one\ntwo", parse_pubspec_document("{description: one\n\n\ntwo}\n")["description"])
    asserts.equals(env, "one\n\ntwo", parse_pubspec_document("{description: \"one\n\n\ntwo\"}\n")["description"])

    # Comment-only lines before the opening bracket are skipped, as pub
    # skips them.
    asserts.equals(env, 1, parse_pubspec_document("# c\n{a: 1,\n b: 2}\n")["a"])
    asserts.equals(env, 2, parse_pubspec_document("# c\n{a: 1,\n b: 2}\n")["b"])
    return unittest.end(env)

def _parse_pubspec_json_document_test_impl(ctx):
    env = unittest.begin(ctx)

    # A multi-line flow document whose strings stay on one line reads on main
    # and on this head: breaks fold to separation with identical values.
    doc = "{\nname: jsontest,\nenvironment: {sdk: ^3.0.0},\ndependencies: {bar: {path: ../stubbar}},\ntopics: [\"a\", \"b\"]\n}\n"
    parsed = parse_pubspec_document(doc)
    asserts.equals(env, "jsontest", parsed["name"])
    asserts.equals(env, ["a", "b"], parsed["topics"])
    asserts.equals(env, ["bar"], parse_pubspec_deps(doc))
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(doc))
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    return unittest.end(env)

def _parse_pubspec_rejected_span_test_impl(ctx):
    env = unittest.begin(ctx)

    # A spanning flow broken by a mapping entry fails naming its opening line.
    broken = "name: p1\nenvironment:\n  sdk: ^3.0.0\nkey:\n  [a,\n  b: c]\n"
    err = parse_pubspec_document_error(broken, "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 5" in err)
    asserts.true(env, "not supported" in err and "flow" in err)

    # `- key: [a,` and `- [a,` spanning lines fold and read as one value, as
    # pub reads them.
    asserts.equals(env, [{"key": ["a", "b"]}], parse_pubspec_document("name: p1\nitems:\n  - key: [a,\n    b]\n")["items"])
    asserts.equals(env, [["a", "b"]], parse_pubspec_document("name: p1\nitems:\n  - [a,\n    b]\n")["items"])

    # A `:` line that continues a plain scalar is an explicit key, which pub
    # rejects: it fails naming the line and the form.
    err = parse_pubspec_document_error("name: p1\ndescription: some text\n  : more text\nenvironment:\n  sdk: ^3.0.0\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "line 3" in err and "not supported" in err and "explicit" in err)
    err = parse_pubspec_document_error("name: p1\ndescription: some text\n  :\nenvironment:\n  sdk: ^3.0.0\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "line 3" in err and "not supported" in err and "explicit" in err)
    return unittest.end(env)

def _parse_pubspec_flow_quote_test_impl(ctx):
    env = unittest.begin(ctx)

    # A backslash at a double-quoted folded line's end continues the scalar
    # with no space, as pub reads it (package:yaml 3.1.4 with the pinned
    # SDK 3.13.5 reads "foobar" below). Elsewhere a backslash is an
    # ordinary character, as pub keeps it: in a plain or single-quoted
    # scalar the break folds to one space, while a `\` with trailing space
    # stays literal.
    bs = "name: p1\nenvironment:\n  sdk: ^3.0.0\ntags:\n  [\"foo\\\n   bar\", plain]\n"
    asserts.equals(env, ["foobar", "plain"], parse_pubspec_document(bs)["tags"])
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(bs))
    asserts.equals(env, None, parse_pubspec_document_error(bs))
    asserts.equals(env, ["foobar"], parse_pubspec_document("{\"tags\": [\"foo\\\n bar\"]}\n")["tags"])
    asserts.equals(
        env,
        ["foo\\ bar"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\\\n   bar']\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo\\ bar"],
        parse_pubspec_document("name: p1\ntags:\n  [foo\\\n   bar]\n")["tags"],
    )

    # A `#`-leading continuation line inside quotes is content, as pub
    # reads it; a ` # ` inside a quoted continuation is content too.
    asserts.equals(
        env,
        ["foo # bar baz"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\n   # bar\n   baz']\n")["tags"],
    )
    asserts.equals(env, ["foo # bar baz"], parse_pubspec_document("{tags: ['foo\n # bar\n baz']}\n")["tags"])
    asserts.equals(
        env,
        ["foo # bar"],
        parse_pubspec_document("name: p1\ntags:\n  [\"foo\n   # bar\"]\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo bar # baz"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\n   bar # baz']\n")["tags"],
    )
    asserts.equals(env, ["foo bar # baz"], parse_pubspec_document("{tags: ['foo\n bar # baz']}\n")["tags"])
    asserts.equals(
        env,
        ["foo bar # baz"],
        parse_pubspec_document("name: p1\ntags:\n  [\"foo\n   bar # baz\"]\n")["tags"],
    )

    # A comment that ends a line inside a plain scalar fails naming the
    # line: pub rejects the flow, so reading on would misread.
    err = parse_pubspec_document_error("name: p1\nenvironment:\n  sdk: ^3.0.0\ntags:\n  [foo # comment\n   bar]\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 5" in err)
    asserts.true(env, "not supported" in err and "comment" in err)

    # A `#` after a complete value still fails when the comment swallows the
    # token the flow needs (`]` above): pub rejects the flow, so reading on
    # would misread. A comment before a `,` separator reads instead; see the
    # flow comment test below.
    err = parse_pubspec_document_error("name: p1\ntags:\n  ['a' #c,\n   b]\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "line 3" in err and "not supported" in err)

    # A `%` line inside a flow fails closed, as pub rejects the directive.
    err = parse_pubspec_document_error("name: p1\ntags:\n  [a,\n   %x\n   b]\n", "//:pubspec.yaml")
    asserts.true(env, err != None and "line 4" in err and "not supported" in err)

    # Trailing space after a backslash continuation folds the break to that
    # space, and a blank line after one is one "\n", as pub reads them.
    asserts.equals(
        env,
        ["foo  bar"],
        parse_pubspec_document("name: p1\ntags:\n  [\"foo\\   \n   bar\"]\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo\\ bar"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\\   \n   bar']\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo\nbar"],
        parse_pubspec_document("name: p1\ntags:\n  [\"foo\\\n\n   bar\"]\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo\\\nbar"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\\\n\n   bar']\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo\\ bar\\ baz"],
        parse_pubspec_document("name: p1\ntags:\n  ['foo\\\n   bar\\\n   baz']\n")["tags"],
    )

    # An apostrophe inside a plain scalar never opens a quote: `[don't,
    # stop]` reads whole, as pub reads it (see the flow apostrophe test).
    asserts.equals(
        env,
        ["don't", "stop"],
        parse_pubspec_document("name: p1\ntags:\n  [don't,\n   stop]\n")["tags"],
    )

    # `---` content lines fold as pub folds them, and comments after a
    # complete value stay separation, as pub skips them.
    asserts.equals(
        env,
        ["foo --- bar"],
        parse_pubspec_document("name: p1\ntags:\n  [foo\n   ---\n   bar]\n")["tags"],
    )
    asserts.equals(
        env,
        ["a", "--- b"],
        parse_pubspec_document("name: p1\ntags:\n  [a,\n   ---\n   b]\n")["tags"],
    )
    asserts.equals(
        env,
        ["a", "b"],
        parse_pubspec_document("name: p1\ntags:\n  [a, # c\n   b]\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo", "bar"],
        parse_pubspec_document("name: p1\ntags:\n  [foo # c\n   , bar]\n")["tags"],
    )
    asserts.equals(
        env,
        ["foo"],
        parse_pubspec_document("name: p1\ntags:\n  [foo # c\n   ]\n")["tags"],
    )
    asserts.equals(env, "x", parse_pubspec_document("{name: x} # trailing\n")["name"])
    return unittest.end(env)

def _parse_pubspec_flow_comment_test_impl(ctx):
    env = unittest.begin(ctx)

    # A `#` comment after a complete flow value is separation, as pub reads
    # it (package:yaml 3.1.4 with the pinned SDK 3.13.5 reads ["red",
    # "green"] below): the comment runs to the end of the line whether the
    # value before it is quoted or plain.
    doc = "name: x\nenvironment:\n  sdk: ^3.0.0\nkeywords:\n  [\"red\" # c\n   , green]\n"
    asserts.equals(env, ["red", "green"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(doc))
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = "name: x\nenvironment:\n  sdk: ^3.0.0\nkeywords:\n  [red # c\n   , green]\n"
    asserts.equals(env, ["red", "green"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, "^3.0.0", parse_pubspec_sdk_constraint(doc))
    asserts.equals(env, None, parse_pubspec_document_error(doc))

    # The same comment on the key's own line reads too: the head line folds
    # with its deeper lines, as pub folds it.
    doc = "keywords: [\"red\" # c\n   , green]\nname: x\nenvironment:\n  sdk: ^3.0.0\n"
    asserts.equals(env, ["red", "green"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = "keywords: [red # c\n   , green]\nname: x\nenvironment:\n  sdk: ^3.0.0\n"
    asserts.equals(env, ["red", "green"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    return unittest.end(env)

def _parse_pubspec_flow_document_error_test_impl(ctx):
    env = unittest.begin(ctx)

    # A document that starts with `{` or `[` but does not parse as one
    # complete collection fails naming the pubspec and the line, as pub
    # rejects each shape below (package:yaml 3.1.4 with the pinned SDK
    # 3.13.5): the reader never reads an empty or partial document.
    cases = [
        ["{name: x\n", "line 1"],
        ["{name: x,\n environment: {sdk: ^3.0.0}\n", "line 2"],
        ["{name: x} trailing\n", "line 1"],
        ["{name: x #c}\n", "line 1"],
        ["[a, b\n", "line 1"],
        ["[\n a,\n b\n", "line 3"],
        ["[a] trailing\n", "line 1"],
        ["[\"a\" #c]\n", "line 1"],
    ]
    for case in cases:
        err = parse_pubspec_document_error(case[0], "//:pubspec.yaml")
        asserts.true(env, err != None and "//:pubspec.yaml" in err and case[1] in err)
        asserts.true(env, "not supported" in err and "flow document" in err)
    return unittest.end(env)

def _parse_pubspec_flow_apos_test_impl(ctx):
    env = unittest.begin(ctx)

    # An apostrophe inside a plain scalar never opens a quote, as pub reads
    # it (package:yaml 3.1.4 with the pinned SDK 3.13.5 reads ["don't",
    # "stop"] below): the tokenizer only opens a quote where a scalar
    # starts, on one line or across the fold.
    doc = "name: p1\ntags:\n  [don't, stop]\n"
    asserts.equals(env, ["don't", "stop"], parse_pubspec_document(doc)["tags"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = "name: p1\ntags:\n  [don't,\n   stop]\n"
    asserts.equals(env, ["don't", "stop"], parse_pubspec_document(doc)["tags"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    return unittest.end(env)

def _parse_pubspec_flow_backslash_test_impl(ctx):
    env = unittest.begin(ctx)

    # A backslash is an ordinary character outside double quotes, as pub
    # reads it (package:yaml 3.1.4 with the pinned SDK 3.13.5 reads the
    # values below): the break after one folds to one space and the next
    # line's indentation is dropped, in both flow paths.
    head = "name: x\nenvironment:\n  sdk: ^3.0.0\n"
    doc = head + "keywords:\n  ['x\\\n  y']\n"
    asserts.equals(env, ["x\\ y"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = head + "description: 'x\\\n  y'\n"
    asserts.equals(env, "x\\ y", parse_pubspec_document(doc)["description"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = head + "keywords:\n  [x\\\n  y]\n"
    asserts.equals(env, ["x\\ y"], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    doc = head + "keywords:\n  -\n    ['x\\\n    y']\n"
    asserts.equals(env, [["x\\ y"]], parse_pubspec_document(doc)["keywords"])
    asserts.equals(env, None, parse_pubspec_document_error(doc))
    return unittest.end(env)

def _trim_gzip_trailing_nulls_test_impl(ctx):
    env = unittest.begin(ctx)

    # `nested@1.0.0` gzip trailer: CRC32 48cd5f2d + ISIZE 00ce0000 (52,736 bytes).
    nested_stream = "\037\213\010\000body\110\315\137\055\000\316\000\000"
    asserts.equals(env, nested_stream, trim_gzip_trailing_nulls(nested_stream))
    asserts.equals(
        env,
        nested_stream,
        trim_gzip_trailing_nulls(nested_stream + ("\0" * 868)),
    )

    # Uncompressed tar size >= 64 KiB (ISIZE = 0x00010400 -> 1 trailing NUL in trailer).
    medium_stream = "\037\213\010\000body\001\002\003\004\000\004\001\000"
    asserts.equals(env, medium_stream, trim_gzip_trailing_nulls(medium_stream))
    asserts.equals(
        env,
        medium_stream,
        trim_gzip_trailing_nulls(medium_stream + ("\0" * 512)),
    )

    # Uncompressed tar size an exact multiple of 64 KiB (ISIZE = 0x00010000).
    aligned_stream = "\037\213\010\000" + ("x" * 1024) + "\253\267\114\106\000\000\001\000"
    asserts.equals(
        env,
        aligned_stream,
        trim_gzip_trailing_nulls(aligned_stream + ("\0" * 512)),
    )
    return unittest.end(env)

def _pub_lock_package_extracted_test_impl(ctx):
    env = analysistest.begin(ctx)
    target = analysistest.target_under_test(env)
    info = target[DartInfo]
    srcs = [f.short_path for f in info.transitive_srcs.to_list()]
    asserts.true(
        env,
        any([p.endswith("/lib/collection.dart") for p in srcs]),
        "pub_lock_package extracts lib/collection.dart from real pub archive: %s" % srcs,
