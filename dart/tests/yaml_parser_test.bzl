    err = parse_pubspec_document_error(doc, "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 4" in err)
    doc = head + "description: \"a\\ud800b\"\n"
    err = parse_pubspec_document_error(doc, "//:pubspec.yaml")
    asserts.true(env, err != None and "//:pubspec.yaml" in err and "line 4" in err)
    return unittest.end(env)

