# Fail-closed guard over every download in //dart: no context download
# outside dart/private/download.bzl (direct, aliased or via getattr), and a
# non-empty literal sha256/integrity on every http rule. The test discovers
# every .bzl under dart/ and every MODULE.bazel from the live tree itself, so
# it runs unsandboxed and local: it always re-runs, and a file it never
# declared cannot change under a cached pass. The anchor below additionally
# declares this test's own source as a runfiles data file, so the root
# resolves through the runfiles manifest where runfiles are a manifest
# rather than symlinks (Windows).
dart_test(
    name = "download_digest_guard_test",
    size = "small",
    args = [
        "$(rlocationpath :download_digest_guard_test.dart)",
    ],
    data = [
        "download_digest_guard_test.dart",
    ],
    local = True,
    main = "download_digest_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

dart_test(
    name = "repro_canary_guard_test",
    size = "small",
    args = [
        "$(rlocationpath :repro_canary_guard_test.dart)",
    ],
    data = [
        "repro_canary_guard_test.dart",
    ],
    local = True,
    main = "repro_canary_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

# `bazel coverage` support: each rule that owns Dart sources returns
# `InstrumentedFilesInfo` over them and their `deps`.
