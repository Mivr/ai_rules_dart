# Fail-closed guard over every download in //dart: no context download
# outside dart/private/download.bzl (direct, aliased or via getattr), and a
# non-empty literal sha256/integrity on every http rule. The test discovers
# every .bzl under dart/ and every MODULE.bazel from the live tree itself, so
# it runs unsandboxed and local: it always re-runs, and a file it never
# declared cannot change under a cached pass. The anchor below additionally
# declares this test's own source as a runfiles data file, so the root
# resolves through the runfiles manifest where runfiles are a manifest
# rather than symlinks (Windows).
dart_test(
    name = "download_digest_guard_test",
    size = "small",
    args = [
        "$(rlocationpath :download_digest_guard_test.dart)",
    ],
    data = [
        "download_digest_guard_test.dart",
    ],
    local = True,
    main = "download_digest_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

# Fail-closed guard for the strict-layering check: the aspect names the
# `dart_layering_check` feature, `expected-failure` exercises the red workspace
# and its opt-out, and no green sweep names that workspace. It reads the live
# tree, so it runs unsandboxed and always re-runs.
dart_test(
    name = "layering_check_guard_test",
    size = "small",
    args = [
        "$(rlocationpath :layering_check_guard_test.dart)",
    ],
    data = [
        "layering_check_guard_test.dart",
    ],
    local = True,
    main = "layering_check_guard_test.dart",
    tags = [
        "external",
        "no-sandbox",
    ],
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

# `rules_testing` is a dev dependency and `/dart/tests/` is `export-ignore`d
# from release archives, so no published consumer resolves it.
dart_test(
    name = "dev_dep_archive_guard_test",
    size = "small",
    args = [
        "$(rlocationpath //:MODULE.bazel)",
        "$(rlocationpath //:.gitattributes)",
    ],
    data = [
        "//:.gitattributes",
        "//:MODULE.bazel",
    ],
    main = "dev_dep_archive_guard_test.dart",
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

