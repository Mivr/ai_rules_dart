load("//dart:defs.bzl", "dart_binary", "dart_code_asset", "dart_library")

# A package whose bundled library is a pinned prebuilt file rather than a
# `cc_shared_library`. The propagation test asserts its asset id reaches the
# dependent binary's generated native-assets manifest.
#
# Kept visible only inside the test tree: making these public would also make
# them `bazel run` entry points of the repository, which `e2e/run_home` checks
# against its registry, and this fixture is not a user-facing entry point.

dart_code_asset(
    name = "code_asset",
    asset_id = "package:prebuilt_prop/ffi.g.dart",
    prebuilt = "//dart/tests/cc_fixture:prebuilt_fixture",
    visibility = ["//dart/tests:__subpackages__"],
)

dart_library(
    name = "prebuilt_prop",
    package_name = "prebuilt_prop",
    srcs = ["lib/prebuilt_prop.dart"],
    code_assets = [":code_asset"],
    visibility = ["//dart/tests:__subpackages__"],
)

dart_binary(
    name = "app",
    main = "main.dart",
    visibility = ["//dart/tests:__subpackages__"],
    deps = [":prebuilt_prop"],
)
