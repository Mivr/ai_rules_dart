load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# A minimal `cc_shared_library` for `dart_code_asset`'s validation tests: they
# need a target that really provides `CcSharedLibraryInfo`, and pointing at
# `//dart/ext/sqlite3:libsqlite3` would both break its private visibility and
# drag the SQLite amalgamation into the unit-test suite.

cc_library(
    name = "empty",
    srcs = ["empty.cc"],
)

cc_shared_library(
    name = "empty_shared",
    visibility = ["//dart/tests:__subpackages__"],
    deps = [":empty"],
)

# A second, distinct shared library, so a test can have two `dart_code_asset`
# targets claim one asset id with genuinely different definitions.
cc_shared_library(
    name = "empty_shared_alt",
    shared_lib_name = select({
        "@platforms//os:ios": "libempty_alt.dylib",
        "@platforms//os:macos": "libempty_alt.dylib",
        "@platforms//os:tvos": "libempty_alt.dylib",
        "@platforms//os:visionos": "libempty_alt.dylib",
        "@platforms//os:watchos": "libempty_alt.dylib",
        "@platforms//os:windows": "empty_alt.dll",
        "//conditions:default": "libempty_alt.so",
    }),
    visibility = ["//dart/tests:__subpackages__"],
    deps = [":empty"],
)

# A checked-in dynamic library for `dart_code_asset`'s `prebuilt` tests: one
# file per platform extension, selected the same way a real consumer would
# select its pinned download. Nothing links or loads these files, so their
# contents are placeholders.
filegroup(
    name = "prebuilt_fixture",
    srcs = select({
        "@platforms//os:ios": ["libprebuilt_fixture.dylib"],
        "@platforms//os:macos": ["libprebuilt_fixture.dylib"],
        "@platforms//os:tvos": ["libprebuilt_fixture.dylib"],
        "@platforms//os:visionos": ["libprebuilt_fixture.dylib"],
        "@platforms//os:watchos": ["libprebuilt_fixture.dylib"],
        "@platforms//os:windows": ["prebuilt_fixture.dll"],
        "//conditions:default": ["libprebuilt_fixture.so"],
    }),
    visibility = ["//dart/tests:__subpackages__"],
)
