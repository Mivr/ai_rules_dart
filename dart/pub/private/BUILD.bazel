    [
        "pub_scan.dart",
        "pub_scan_test.dart",
    ],
)

# Bare sources for `//dart/pub:pinned_sources_guard_test`, which reads every
# Starlark file in `//dart/pub` and fails when a fetch call site stops going
# through the shared pinned-source validation.
