load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "build_content",
    srcs = ["build_content.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "pub_root_pin",
    srcs = ["pub_root_pin.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":pub_repository",
        ":version",
        "//dart/pub:yaml_parser",
    ],
)

bzl_library(
    name = "pub_symlink",
    srcs = ["pub_symlink.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "pub_scc_facts",
    srcs = ["pub_scc_facts.bzl"],
    visibility = [
        "//dart/pub:__subpackages__",
        "//dart/tests:__subpackages__",
    ],
    deps = [
        ":pub_symlink",
        "//dart/pub:yaml_parser",
    ],
)

bzl_library(
    name = "scc",
    srcs = ["scc.bzl"],
    visibility = [
        "//dart/pub:__subpackages__",
        "//dart/tests:__subpackages__",
    ],
)

bzl_library(
    name = "pub_scc_verify",
    srcs = ["pub_scc_verify.bzl"],
    visibility = [
        "//dart/pub:__subpackages__",
        "//dart/tests:__subpackages__",
    ],
    deps = [
        ":scc",
    ],
)

bzl_library(
    name = "pub_repository",
    srcs = ["pub_repository.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":build_content",
        ":pub_symlink",
        "//dart/private:download",
        "//dart/pub:pinned_sources",
    ],
)

bzl_library(
    name = "language_version",
    srcs = ["language_version.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "version",
    srcs = ["version.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "yaml_subset",
    srcs = ["yaml_subset.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":yaml_chars",
        ":yaml_scalar",
        ":yaml_text",
    ],
)

bzl_library(
    name = "yaml_chars",
    srcs = ["yaml_chars.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "yaml_text",
    srcs = ["yaml_text.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":yaml_chars",
    ],
)

bzl_library(
    name = "yaml_escape",
    srcs = ["yaml_escape.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
)

bzl_library(
    name = "yaml_scalar",
    srcs = ["yaml_scalar.bzl"],
    visibility = ["//dart/pub:__subpackages__"],
    deps = [
        ":yaml_chars",
        ":yaml_escape",
        ":yaml_text",
    ],
)

# Bare scanner sources for `//dart/pub:pub_scan_test`, which imports the
# scanner and drives its verdict function over inline-built archives.
exports_files(
    [
        "pub_scan.dart",
        "pub_scan_test.dart",
    ],
)

# Bare sources for `//dart/pub:pinned_sources_guard_test`, which reads every
# Starlark file in `//dart/pub` and fails when a fetch call site stops going
# through the shared pinned-source validation.
exports_files(
    [
        "build_content.bzl",
        "language_version.bzl",
        "pub_repository.bzl",
        "pub_scc_facts.bzl",
        "pub_symlink.bzl",
        "scc.bzl",
        "version.bzl",
        "yaml_subset.bzl",
    ],
)
