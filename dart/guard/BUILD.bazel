load("//dart:defs.bzl", "dart_library")

# The shared directive-URI check every Dart compile and analysis action runs,
# as a public library so rule sets built on rules_dart can enforce the same
# check in their own tools. See lib/directive_guard.dart for the API.
dart_library(
    name = "directive_guard",
    package_name = "rules_dart_guard",
    srcs = ["lib/directive_guard.dart"],
    visibility = ["//visibility:public"],
)

# Bare source for run-from-source consumers: the JIT tool bundle stages it
# beside the entry that imports it, the kernel planner compiles it through
# `srcs`, and `directive_guard_test` reads it among the enforced sources.
exports_files(
    ["lib/directive_guard.dart"],
    visibility = ["//visibility:public"],
)
