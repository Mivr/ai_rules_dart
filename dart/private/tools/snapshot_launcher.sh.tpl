#!/usr/bin/env bash
# Generated by `dart_binary` for `aot-snapshot` and `jit-snapshot` modes.
#
# Runs the target's own pinned-SDK VM on the raw snapshot in runfiles and
# forwards every argument. Nothing here writes under HOME: a snapshot runs as
# a VM file form, which keeps the caller's environment without touching it.
set -euo pipefail

runner_rlocation='@RULES_DART_RUNNER@'
snapshot_rlocation='@RULES_DART_SNAPSHOT@'

# Resolves a runfiles-relative path through the runfiles directory, the
# manifest (--noenable_runfiles), or the executable's own sibling tree.
resolve_runfile() {
  local key="$1"
  local candidate root
  if [[ -n "${RUNFILES_DIR:-}" ]]; then
    candidate="${RUNFILES_DIR}/${key}"
    if [[ -e "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  if [[ -n "${RUNFILES_MANIFEST_FILE:-}" && -f "${RUNFILES_MANIFEST_FILE}" ]]; then
    candidate="$(awk -v key="$key" '$1 == key { sub(/^[^ ]+ /, ""); print; exit }' "${RUNFILES_MANIFEST_FILE}")"
    if [[ -n "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  for root in "$0.runfiles" "$0.exe.runfiles"; do
    candidate="${root}/${key}"
    if [[ -e "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'snapshot_launcher: cannot find %s in runfiles\n' "$key" >&2
  return 1
}

runner="$(resolve_runfile "$runner_rlocation")"
snapshot="$(resolve_runfile "$snapshot_rlocation")"
exec "$runner" "$snapshot" "$@"
