# Compiles one kernel module, excluding the sources that cannot compile for the VM.
# A Bazel persistent worker. It has no dependencies on purpose: every `dart_library`
# names it as an attribute, so depending on a `dart_library` would be a cycle.
# It reads the shared guard through `srcs` instead: the file compiles in place,
# so the relative import reaches it with no package edge.
# An AOT snapshot (run by `dartaotruntime` in `kernel_module_action`): every module
# and entry action pays the tool's startup, and the snapshot skips the VM's JIT
# compile of the wrapper. It is smaller and faster to build than `exe`.
dart_binary(
    name = "kernel_module",
    srcs = [
        "comma_patch.dart",
        "dill_outline.dart",
        "dill_reader.dart",
        "lib/worker_protocol.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    code_assets_from_deps = False,
    compile_mode = "aot-snapshot",
    main = "kernel_module.dart",
    modular_kernel = False,
    visibility = ["//visibility:public"],
)

