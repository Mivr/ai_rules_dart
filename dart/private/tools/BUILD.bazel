)

# The kernel byte readers shared by the run-from-source tools (see
# `dill_reader.dart`): compiled into `kernel_module` through `srcs`, run from
# source beside the staged JIT tool through `:jit_tool_srcs`.
exports_files(
    ["dill_reader.dart"],
    visibility = ["//dart:__subpackages__"],
)

# The one bundle every action running the JIT tool from source stages: the
# entry `app_jit_snapshot.dart` plus every source it imports, including the
# guard library its reader helper resolves URIs through. The helpers pick
# the entry by basename (see `dart_compile.bzl`), so the bundle grows by
# adding a file here, with no rule change.
filegroup(
    name = "jit_tool_srcs",
    srcs = [
        "app_jit_snapshot.dart",
        "dill_reader.dart",
        "jit_lock.dart",
        "jit_policy.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    visibility = ["//dart:__subpackages__"],
)

# The single comma-splitting patch implementation (see `comma_patch.dart`):
# run from source by the toolchain's declared patch actions, compiled into
# `kernel_module` and `app_jit_snapshot` through `srcs`.
exports_files(
    ["comma_patch.dart"],
    visibility = ["//dart:__subpackages__"],
)

# The single persistent-worker protocol and staged-source plumbing
# implementation shared by the build-action runners (see
# `worker_protocol.dart` and `worker_tool_fs.dart`). Two targets, not one:
# `worker_protocol.dart` imports only dart: libraries, while
# `worker_tool_fs.dart` needs package:analyzer and package:path, so one
# target would hand every consumer a dependency on the side it does not use.
# Both name the `rules_dart_worker` package: a package split across targets
# is normal (see `merge_package_records` in dart/private/common.bzl), and the
# shared `lib/` root means the compile still resolves all its files together.
dart_library(
    name = "worker_protocol",
    package_name = "rules_dart_worker",
    srcs = ["lib/worker_protocol.dart"],
    visibility = ["//dart:__subpackages__"],
)

dart_library(
    name = "worker_tool_fs",
    package_name = "rules_dart_worker",
    srcs = ["lib/worker_tool_fs.dart"],
    visibility = ["//dart:__subpackages__"],
    deps = [
        "@ext_pub_deps//:analyzer",
        "@ext_pub_deps//:path",
    ],
)

