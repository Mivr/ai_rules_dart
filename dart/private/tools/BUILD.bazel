# Compiles one kernel module, excluding the sources that cannot compile for the VM.
# A Bazel persistent worker. It has no dependencies on purpose: every `dart_library`
# names it as an attribute, so depending on a `dart_library` would be a cycle.
# It reads the shared guard through `srcs` instead: the file compiles in place,
# so the relative import reaches it with no package edge.
# An AOT snapshot (run by `dartaotruntime` in `kernel_module_action`): every module
# and entry action pays the tool's startup, and the snapshot skips the VM's JIT
# compile of the wrapper. It is smaller and faster to build than `exe`.
dart_binary(
    name = "kernel_module",
    srcs = [
        "comma_patch.dart",
        "dill_outline.dart",
        "dill_reader.dart",
        "kernel_module_strip.dart",
        "lib/worker_protocol.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    code_assets_from_deps = False,
    compile_mode = "aot-snapshot",
    main = "kernel_module.dart",
    modular_kernel = False,
    # A persistent-worker tool: `dartaotruntime` runs the raw snapshot, so it
    # must stay the executable rather than gaining a `bazel run` launcher.
    snapshot_launcher = False,
    visibility = ["//visibility:public"],
)

exports_files(
    ["kernel_module_test.dart"],
    visibility = ["//dart/tests/early_return_kernel_module:__pkg__"],
)

# The planner's and outline stripper's unit tests.
#
# Sharded because the suite is the slow one: it compiles from the SDK fixtures
# twice. `package:test` hands each shard a contiguous block of cases, and the
# heaviest cases sit together near the end of the file, so the slowest shard
# only shrinks once that block splits. The p95 of the slowest shard over ten
# runs each, run as the nightly flake sweep runs them (`--local_test_jobs` at
# twice the host's CPUs, cases in random order): 24.2 s unsharded, 21.3 s at
# 2 shards, 21.4 s at 4, 19.8 s at 8, 13.4 s at 16, near the floor set by the
# single slowest case (about 7 s). At 16 that is under a quarter of `small`'s
# 60 s timeout. `test_runner_test` holds the shard count and size to these
# measurements.
dart_test(
    name = "kernel_module_test",
    size = "medium",
    srcs = [
        "app_jit_aot_args.dart",
        "app_jit_snapshot.dart",
        "comma_patch.dart",
        "dill_outline.dart",
        "dill_reader.dart",
        "dill_test_writer.dart",
        "jit_lock.dart",
        "jit_policy.dart",
        "kernel_link.dart",
        "kernel_module.dart",
        "kernel_module_strip.dart",
        "kernel_module_test_support.dart",
        "lib/worker_protocol.dart",
        "worker_test_encode.dart",
        "//dart/guard:lib/directive_guard.dart",
    ],
    args = [
        "$(rlocationpath :kernel_module)",
        "$(rlocationpath @dart_toolchains//sdk/3.13.5:dart)",
        "$(rlocationpath @dart_toolchains//sdk/3.13.4:dart)",
    ],
    data = [
        ":kernel_module",
        "//dart",
        "@dart_toolchains//sdk/3.13.4:compile_files",
        "@dart_toolchains//sdk/3.13.4:dart",
        "@dart_toolchains//sdk/3.13.5:compile_files",
        "@dart_toolchains//sdk/3.13.5:dart",
    ],
    main = "kernel_module_test.dart",
    shard_count = 16,
    deps = [
        "//dart/runfiles",
        "@ext_pub_deps//:test",
    ],
)

