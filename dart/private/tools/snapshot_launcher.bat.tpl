@echo off
rem Generated by `dart_binary` for `aot-snapshot` and `jit-snapshot` modes.
rem Runs the target's own pinned-SDK VM on the raw snapshot in runfiles and
rem forwards every argument. A VM file form never touches HOME, so the caller
rem keeps its environment and nothing is written there by this launcher.
rem
rem Bazel on Windows builds no runfiles tree by default, so the lookup order
rem matches kernel_launcher.dart: RUNFILES_MANIFEST_FILE, the manifests next
rem to this file, then RUNFILES_DIR and the runfiles trees next to this file.
rem A manifest line is `<key> <absolute path>`; the path may contain spaces.
setlocal enableextensions
set "RUNNER_KEY=@RULES_DART_RUNNER@"
set "SNAPSHOT_KEY=@RULES_DART_SNAPSHOT@"
set "SELF=%~f0"
set "SELF_EXE=%~dpn0.exe"
set "SIBLING=%~dp0.."
set "LOOKED="

set "RUNNER="
call :resolve "%RUNNER_KEY%" RUNNER
if not defined RUNNER goto :missing
set "SNAPSHOT="
call :resolve "%SNAPSHOT_KEY%" SNAPSHOT
if not defined SNAPSHOT goto :missing

"%RUNNER%" "%SNAPSHOT%" %*
exit /b %ERRORLEVEL%

:missing
echo snapshot_launcher: cannot find the runfile in runfiles; looked in: 1>&2
echo   %LOOKED% 1>&2
exit /b 1

rem Resolves a runfiles-relative key (%1) into the variable named by %2.
:resolve
set "%~2="
call :from_manifest %1 %2 "%RUNFILES_MANIFEST_FILE%"
call :from_manifest %1 %2 "%SELF%.runfiles_manifest"
call :from_manifest %1 %2 "%SELF%.runfiles\MANIFEST"
call :from_manifest %1 %2 "%SELF_EXE%.runfiles_manifest"
call :from_dir %1 %2 "%RUNFILES_DIR%"
call :from_dir %1 %2 "%SELF%.runfiles"
call :from_dir %1 %2 "%SELF_EXE%.runfiles"
call :from_dir %1 %2 "%SIBLING%\.."
call :from_dir %1 %2 "%SIBLING%"
if defined %~2 exit /b 0
exit /b 1

rem %1 key, %2 result variable, %3 manifest file (may be empty).
:from_manifest
if defined %~2 exit /b 0
if "%~3"=="" exit /b 0
set "LOOKED=%LOOKED% [manifest %~3]"
if not exist "%~3" exit /b 0
for /f "usebackq tokens=1,* delims= " %%A in (`findstr /b /c:"%~1 " "%~3"`) do if /i "%%A"=="%~1" set "%~2=%%B"
exit /b 0

rem %1 key, %2 result variable, %3 runfiles directory (may be empty).
:from_dir
if defined %~2 exit /b 0
if "%~3"=="" exit /b 0
set "LOOKED=%LOOKED% [dir %~3\%~1]"
if exist "%~3\%~1" set "%~2=%~3\%~1"
exit /b 0
