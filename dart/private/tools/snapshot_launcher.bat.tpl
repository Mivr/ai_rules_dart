@echo off
rem Generated by `dart_binary` for `aot-snapshot` and `jit-snapshot` modes.
rem Runs the target's own pinned-SDK VM on the raw snapshot in runfiles and
rem forwards every argument. A VM file form never touches HOME, so the caller
rem keeps its environment and nothing is written there by this launcher.
setlocal enableextensions
set "RUNNER_KEY=@RULES_DART_RUNNER@"
set "SNAPSHOT_KEY=@RULES_DART_SNAPSHOT@"

set "RUNNER="
call :resolve "%RUNNER_KEY%" RUNNER
if not defined RUNNER exit /b 1
set "SNAPSHOT="
call :resolve "%SNAPSHOT_KEY%" SNAPSHOT
if not defined SNAPSHOT exit /b 1

"%RUNNER%" "%SNAPSHOT%" %*
exit /b %ERRORLEVEL%

rem Resolves a runfiles-relative path through the runfiles directory, the
rem manifest, or the executable's own sibling tree.
:resolve
set "%~2="
if defined RUNFILES_DIR if exist "%RUNFILES_DIR%\%~1" (
  set "%~2=%RUNFILES_DIR%\%~1"
  exit /b 0
)
if defined RUNFILES_MANIFEST_FILE if exist "%RUNFILES_MANIFEST_FILE%" (
  for /f "usebackq tokens=1,*" %%A in (`findstr /b /c:"%~1 " "%RUNFILES_MANIFEST_FILE%"`) do (
    if /i "%%A"=="%~1" (
      set "%~2=%%B"
      exit /b 0
    )
  )
)
for %%R in ("%~dp0..\.." "%~dp0..") do (
  if exist "%%~R\%~1" (
    set "%~2=%%~R\%~1"
    exit /b 0
  )
)
echo snapshot_launcher: cannot find %~1 in runfiles 1>&2
exit /b 1
