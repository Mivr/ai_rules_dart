load(":dart_analyzer_summary.bzl", "analyzer_sdk_summary")

# The SDK's own library summary, read by every analyzer-summary action. Built
# once per SDK, and only when an action needs it: `manual`, so a wildcard build
# never builds it, and the aspects reach it by label. See dart_analyzer_summary.bzl.
analyzer_sdk_summary(
    name = "analyzer_sdk_summary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "allow_analysis_failures",
    values = {"allow_analysis_failures": "true"},
)

bool_setting(
    name = "modular_kernel_off",
    build_setting_default = False,
    tags = ["manual"],
)

alias(
    name = "aspect_modular_kernel",
    actual = select({
        ":allow_analysis_failures": ":modular_kernel_off",
        "//conditions:default": "//dart:modular_kernel",
    }),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The aspects' analyzer attributes point at these aliases, which route
# unconditionally to `//dart:analyzer_summary_tool` and `:analyzer_sdk_summary`.
# `analyzer_summary` is the sole analysis engine on supported SDKs (3.13 to 3.14,
# bounded by `ANALYZER_MIN_LANGUAGE_VERSION` and `ANALYZER_MAX_LANGUAGE_VERSION`
# in `dart_analyzer_summary.bzl`) for both summary mode
# (`--//dart:analyzer_summaries=true`) and full-source mode
# (`--//dart:analyzer_summaries=false`). Both targets are `manual`, so a
# wildcard build never builds them unless an action requires them.
alias(
    name = "analyzer_summary_tool",
    actual = "//dart:analyzer_summary_tool",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

alias(
    name = "analyzer_sdk_summary_input",
    actual = ":analyzer_sdk_summary",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Curated pub-spoke `code_assets` (such as `@dart_pub__sqlite3//:sqlite3` ->
# `//dart/ext/sqlite3:code_asset`) are gated on `:code_assets_on` so pure-Dart
# library, codegen, and tool builds never configure `cc_*` targets or probe a C
# toolchain. `dart_binary(code_assets_from_deps = True)` and `dart_test`
# transition `:code_assets_enabled` to `True`, while `dart_binary` tools with
# `code_assets_from_deps = False` transition it to `False`.
bool_setting(
    name = "code_assets_enabled",
    build_setting_default = False,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The `dart.vm.product` value library modules compile with. `dart_test` transitions
# it to `False`, as `dart test` runs on the non-product VM; kernel binaries keep
# `True`. A library shared by both compiles once per value.
bool_setting(
    name = "vm_product",
    build_setting_default = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "code_assets_on",
    flag_values = {":code_assets_enabled": "true"},
    visibility = ["//visibility:public"],
)

