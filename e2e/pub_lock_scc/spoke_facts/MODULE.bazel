module(name = "pub_lock_scc_spoke_facts_e2e")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")
local_path_override(
    module_name = "ai_rules_dart",
    path = "../../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# Red-by-design: the committed MODULE.bazel.lock carries wrong
# cycle-planning facts for two spokes, and the spoke repositories recorded
# beside them carry the same wrong `planned_deps`. Exercise it with
# `--lockfile_mode=error` so the lock is taken as-is: on the base commit the
# build fails because the lock is stale there, while with the fix each case
# below fails at fetch, naming the package, instead of failing analysis with
# a bare target cycle (in default mode the base commit would instead heal the
# lock and pass, which is why the flag matters).
#
# - `spoke_a` really depends on `spoke_b`, but `spoke_a`'s fact says [].
#   Planning sees no cycle and leaves spokes; `spoke_a`'s fetch fails
#   naming the package instead of failing analysis with a bare target cycle:
#
#     bazel build @spokes//:spoke_a --lockfile_mode=error
#     # Error in fail: pub_lock_package "ai_rules_dart++pub+spokes__spoke_a":
#     # package "spoke_a" lists different dependencies than cycle planning
#     # used (planned [], pubspec [spoke_b]). ...
#
# - `spoke_d` really has no dependencies, but its fact says [`spoke_c`] with
#   no cycle resulting. The build would pass with the fake fact re-recorded;
#   `spoke_d`'s fetch fails naming the package instead:
#
#     bazel build @spokes//:spoke_d --lockfile_mode=error
#     # Error in fail: pub_lock_package "ai_rules_dart++pub+spokes__spoke_d":
#     # package "spoke_d" lists different dependencies than cycle planning
#     # used (planned [spoke_c], pubspec []). ...
#
# Both failures name the package, list the planned and the real names, and
# give the lockfile recovery step. Recovering (remove the pub extension's
# `facts` entry and its `moduleExtensions` entry from MODULE.bazel.lock,
# delete the `MODULE.bazel.lock` inside Bazel's output base, build again)
# builds cleanly, planning then records the real names. The fixtures live in
# e2e/pub_lock_scc/fixtures/ (served over file://; the FIXTURES_ROOT
# placeholder in pubspec.spoke.lock and MODULE.bazel.lock is rewritten to the
# absolute path before building, and restored afterwards).
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub.from_lock(
    name = "spokes",
    isolated = True,
    lock = "//:pubspec.spoke.lock",
)
use_repo(pub, "spokes")
