load(
    "@rules_dart//dart:defs.bzl",
    "dart_test",
)
load("@rules_dart//dart/ext/_shared:defs.bzl", "library_builder_library")
load("@rules_dart//dart/ext/freezed:defs.bzl", "freezed_library")

# Comprehensive e2e for freezed_library:
#  - basic value class (event.dart) — equality, copyWith, toString
#  - sealed union (network_result.dart) — .when/.map/.maybeWhen,
#    @Default, per-variant copyWith, variant equality

freezed_library(
    name = "freezed_fixture",
    package_name = "freezed_fixture",
    srcs = [
        "lib/event.dart",
        "lib/network_result.dart",
    ],
    language_version = "3.11",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "event_test",
    size = "small",
    main = "test/event_test.dart",
    deps = [
        ":freezed_fixture",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "network_result_test",
    size = "small",
    main = "test/network_result_test.dart",
    deps = [
        ":freezed_fixture",
        "@pub_deps//:test",
    ],
)

# The public `library_builder_library` macro that `freezed_library` wraps, called
# with the freezed shim and its output suffix itself: one codegen action per
# source emits `point.freezed.dart` straight into the package.
library_builder_library(
    name = "point_library",
    package_name = "freezed_fixture",
    srcs = ["lib/point.dart"],
    annotation_dep = "@pub_deps//:freezed_annotation",
    language_version = "3.11",
    output_suffixes = [".freezed.dart"],
    shim = "@rules_dart//dart/ext/freezed:shim",
    visibility = ["//visibility:public"],
)

dart_test(
    name = "point_test",
    size = "small",
    main = "test/point_test.dart",
    deps = [
        ":point_library",
        "@pub_deps//:test",
    ],
)
