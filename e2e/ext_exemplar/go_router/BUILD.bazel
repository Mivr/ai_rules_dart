load(
    "@rules_dart//dart:defs.bzl",
    "dart_test",
)
load("@rules_dart//dart/ext/go_router:defs.bzl", "go_router_library")

# End-to-end test for go_router_builder. go_router's published package
# depends on Flutter (package:flutter/widgets.dart), so we can't bring it
# in as a runtime dep inside rules_dart's pure-Dart test environment.
# Instead we inject a local pure-Dart stub that mirrors go_router's
# annotation surface — enough for the analyzer to resolve
# @TypedGoRoute, @TypedShellRoute, etc., which is all go_router_builder
# needs at annotation-match time.
#
# The generated .g.dart output imports package:flutter/material.dart and
# therefore cannot be compiled in pure-Dart. `go_router_library` wraps it in a
# dart_library that nothing compiles; the test reads the generated file as a
# string via the library's runfiles and asserts the builder emitted the
# expected structure.

go_router_library(
    name = "app_router",
    package_name = "go_router_routes",
    srcs = ["lib/app_router.dart"],
    annotation_dep = "//go_router/_go_router_stub:go_router_stub",
    language_version = "3.11",
    # Never compiled: its generated part imports Flutter. Tagged `manual` so a
    # wildcard build leaves it alone; the test below reads its files by `data`.
    tags = ["manual"],
)

dart_test(
    name = "app_router_test",
    size = "small",
    data = [":app_router"],
    main = "test/app_router_test.dart",
    deps = [
        "@pub_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
