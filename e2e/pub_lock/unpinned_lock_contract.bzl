"""Red-path contract check for unpinned hosted entries in pubspec.lock."""

load("@rules_dart//dart/pub:pub_lock_package.bzl", "pub_lock_package_sha256_error")
load("@rules_dart//dart/pub:yaml_parser.bzl", "lock_package_error", "parse_pubspec_lock")

_UNPINNED_LOCK = """\
# Generated by pub
packages:
  collection:
    dependency: "direct main"
    description:
      name: collection
      url: "https://pub.dev"
    source: hosted
    version: "1.18.0"
  empty_sha:
    dependency: "direct main"
    description:
      name: empty_sha
      sha256:
      url: "https://pub.dev"
    source: hosted
    version: "2.0.0"
sdks:
  dart: ">=3.11.0 <4.0.0"
"""

EXPECTED_LOCK_PACKAGE_ERROR = (
    'pub package "collection" 1.18.0 in //:pubspec.lock has no sha256. ' +
    "Run `dart pub get` (Dart 2.19 or newer records one) and commit the lock."
)

EXPECTED_PUB_LOCK_PACKAGE_SHA256_ERROR = (
    'pub_lock_package "collection" (1.18.0) requires a non-empty sha256.'
)

def check_unpinned_lock_contract():
    """Verifies that unpinned hosted lock entries fail with the named sha256 errors.

    Returns:
        List of `--define` strings containing the evaluated error messages.
    """
    parsed = parse_pubspec_lock(_UNPINNED_LOCK)
    lock_err = lock_package_error("collection", parsed["collection"], "//:pubspec.lock")
    if lock_err != EXPECTED_LOCK_PACKAGE_ERROR:
        fail("Expected lock_package_error %r, got %r" % (EXPECTED_LOCK_PACKAGE_ERROR, lock_err))

    empty_err = lock_package_error("empty_sha", parsed["empty_sha"], "//:pubspec.lock")
    expected_empty = (
        'pub package "empty_sha" 2.0.0 in //:pubspec.lock has no sha256. ' +
        "Run `dart pub get` (Dart 2.19 or newer records one) and commit the lock."
    )
    if empty_err != expected_empty:
        fail("Expected lock_package_error %r, got %r" % (expected_empty, empty_err))

    sha_err = pub_lock_package_sha256_error(
        "collection",
        parsed["collection"].get("version", ""),
        parsed["collection"].get("description", {}).get("sha256", ""),
    )
    if sha_err != EXPECTED_PUB_LOCK_PACKAGE_SHA256_ERROR:
        fail(
            "Expected pub_lock_package_sha256_error %r, got %r" % (
                EXPECTED_PUB_LOCK_PACKAGE_SHA256_ERROR,
                sha_err,
            ),
        )
    return [
        "LOCK_PACKAGE_ERROR=" + lock_err,
        "PUB_LOCK_PACKAGE_SHA256_ERROR=" + sha_err,
    ]
