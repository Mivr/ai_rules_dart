module(name = "pub_symlink_e2e")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")
local_path_override(
    module_name = "ai_rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub.from_lock(
    name = "pub_deps",
    isolated = True,
    lock = "//:pubspec.lock",
)

# Header-scan e2e over the local registry in fixtures/ (served over file://;
# the locks' FIXTURES_ROOT placeholder is rewritten to the absolute path by
# the CI step). Clean packages share one hub; each hostile package gets its
# own isolated hub so its refusal is asserted independently. The two path
# hubs cover entry paths that escape the root themselves: absolute
# (`ep_abs`) and climbing (`ep_dotdot`). Every hub fetch below runs the
# shared `dart_pub_scanner` snapshot through the fetch host SDK's
# `dartaotruntime`, which the `dart` module extension builds once per output
# base through `pub_scanner_repo` (`//dart/pub:pub_scanner.bzl`): a hostile
# tarball fails its fetch before extraction, so this workspace exercises
# that rule on every red hub. The committed lock carries the clean hub's
# planning facts, so these runs exercise planning on the hit path while
# every hostile spoke still scans its own archive: no planning verdict ever
# reaches a spoke.
pub.from_lock(
    name = "ok_deps",
    isolated = True,
    lock = "//:pubspec.ok.lock",
)
pub.from_lock(
    name = "eh_out",
    isolated = True,
    lock = "//:pubspec.evil_hard_out.lock",
)
pub.from_lock(
    name = "eh_in",
    isolated = True,
    lock = "//:pubspec.evil_hard_in.lock",
)
pub.from_lock(
    name = "eabs",
    isolated = True,
    lock = "//:pubspec.evil_abs.lock",
)
pub.from_lock(
    name = "eesc",
    isolated = True,
    lock = "//:pubspec.evil_esc.lock",
)
pub.from_lock(
    name = "ep_abs",
    isolated = True,
    lock = "//:pubspec.evil_path_abs.lock",
)
pub.from_lock(
    name = "ep_dotdot",
    isolated = True,
    lock = "//:pubspec.evil_path_dotdot.lock",
)
use_repo(pub, "eabs", "eesc", "eh_in", "eh_out", "ep_abs", "ep_dotdot", "ok_deps", "pub_deps")
