load("@rules_dart//dart:defs.bzl", "dart_binary")
load(":symlink_contract.bzl", "check_pub_symlink_contract")

exports_files(["pubspec.lock"])
# Pins the guard's decision procedure: fails at load time when an
# in-package target is rejected or an escaping one is allowed.
check_pub_symlink_contract()

# This workspace should FAIL to fetch: `evil_pkg`'s `lib/evil.dart` is a
# symlink climbing above the package root, so the guard refuses to
# materialise it. Recreate the scratch git remote, fill its commit into
# `pubspec.lock`'s `resolved-ref`, and rebuild:
#
#   rm -rf /tmp/pub_symlink_evil && mkdir -p /tmp/pub_symlink_evil/evil_pkg/lib
#   cd /tmp/pub_symlink_evil && git init -q . && git config user.email t@t.t && git config user.name t
#   printf 'name: evil_pkg\nversion: 1.0.0\nenvironment:\n  sdk: ">=3.0.0 <4.0.0"\n' > evil_pkg/pubspec.yaml
#   echo 'OUTSIDE-SECRET' > /tmp/pub_symlink_outside.txt
#   ln -s ../../outside.txt evil_pkg/lib/evil.dart
#   printf 'String get ok => "ok";\n' > evil_pkg/lib/ok.dart
#   git add -A && git commit -qm init
#   # put `git rev-parse HEAD` into pubspec.lock's resolved-ref, then:
#   if bazel build //:app 2>/dev/null; then
#     echo "ERROR: build should have failed on the escaping symlink"
#     exit 1
#   fi
#   bazel build //:app 2>&1 | grep -q 'pub package "evil_pkg": symlink "lib/evil.dart" escapes the package'
dart_binary(
    name = "app",
    main = "main.dart",
    deps = ["@pub_deps//:evil_pkg"],
)

# Header-scan e2e over the local registry in fixtures/ (see MODULE.bazel).
# `ok_app` must stay green: clean tarballs and an in-package symlink scan
# clean and materialise. Each hostile hub must fail its fetch before
# extraction instead — `@eh_out//:evil_hard_out` and `@eh_in//:evil_hard_in`
# on hard-link entries, `@eabs//:evil_abs` on the absolute target,
# `@eesc//:evil_esc` on the escaping target — with a diagnostic naming the
# package, the entry path, the entry kind and the raw target. The evil cycle
# member lives in the nested `cycle/` workspace: it fails cycle planning,
# which would poison this workspace's other hubs. The CI step drives each
# hub and greps its message.
dart_binary(
    name = "ok_app",
    main = "main_ok.dart",
    deps = [
        "@ok_deps//:ok_clean",
        "@ok_deps//:ok_inlink",
    ],
)

# One app per hostile hub, all sharing the trivial main.dart: resolving the
# dep already fetches the hostile tarball, so each of these must fail at
# fetch with its hub's header-scan refusal (see MODULE.bazel). The CI
# expected-failure step builds each and greps its diagnostic.
dart_binary(
    name = "evil_hard_out_app",
    main = "main.dart",
    deps = ["@eh_out//:evil_hard_out"],
)

dart_binary(
    name = "evil_hard_in_app",
    main = "main.dart",
    deps = ["@eh_in//:evil_hard_in"],
)

dart_binary(
    name = "evil_abs_app",
    main = "main.dart",
    deps = ["@eabs//:evil_abs"],
)

dart_binary(
    name = "evil_esc_app",
    main = "main.dart",
    deps = ["@eesc//:evil_esc"],
)
