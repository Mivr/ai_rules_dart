load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

dart_binary(
    name = "app",
    main = "main.dart",
    deps = ["@pub_deps//:characters"],
)

# A git package materialized from a bundle in this workspace (see
# git_host_config_ext.bzl): its bytes must not depend on host git
# configuration (core.autocrlf, core.eol, core.attributesFile), on any OS.
dart_test(
    name = "host_config_test",
    size = "small",
    main = "host_config_test.dart",
    deps = ["@fmtpkg"],
)

# The template probe's helper-fetched package (see template_probe.bzl): its
# bytes must survive a hostile template directory (export-subst attributes,
# post-checkout hook) all the way to the compiler, on any OS.
dart_test(
    name = "probe_test",
    size = "small",
    main = "probe_test.dart",
    deps = ["@probe//:fmtpkg"],
)
