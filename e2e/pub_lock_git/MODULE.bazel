module(name = "pub_lock_git_e2e")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")

bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

local_path_override(
    module_name = "ai_rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub", dev_dependency = True)
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
)
use_repo(pub, "pub_deps")

gitpkg = use_extension("//:git_host_config_ext.bzl", "gitpkg")
use_repo(gitpkg, "fmtpkg")

probe = use_extension("//:template_probe.bzl", "probe")
use_repo(probe, "probe")

hostile = use_extension("//:hostile_probe_ext.bzl", "hostile")
use_repo(
    hostile,
    "export_subst_protocol0",
    "export_subst_unpacklimit",
    "hostile_fallback_quarantine",
    "hostile_fsck_config_file",
    "hostile_fsck_includeif",
    "hostile_fsck_inline",
    "hostile_insteadof",
    "hostile_quarantine_empty",
    "hostile_quarantine_set",
    "hostile_unknown_vars",
    "hostile_worktree_empty",
    "hostile_worktree_set",
)
