bazel_dep(name = "ai_rules_dart", version = "0.0.0", dev_dependency = True, repo_name = "rules_dart")
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

local_path_override(
    module_name = "ai_rules_dart",
    path = "../..",
)

pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "pub_deps",
    lock = "//:pubspec.lock",
)

# The lint ruleset is declared with pub.package rather than added to
# pubspec.lock: a lint-only package is not a dependency of the code it lints.
pub.package(
    name = "very_good_analysis",
    sha256 = "0bd5eb8d6be76aa0d71e70cbdae6cac8f784f761170568e3c2214a6948c7f6d3",
    version = "11.0.0",
)
use_repo(pub, "pub_deps", "very_good_analysis")
