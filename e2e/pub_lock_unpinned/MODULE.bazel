module(name = "pub_lock_unpinned_e2e")

bazel_dep(name = "ai_rules_dart", version = "0.0.0", repo_name = "rules_dart")
local_path_override(
    module_name = "ai_rules_dart",
    path = "../..",
)

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.13.5")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

# pubspec.lock has a hosted package entry ("collection" 1.18.0) without sha256,
# so evaluating `pub` must fail with `lock_package_error`
# ('pub package "collection" 1.18.0 in @@//:pubspec.lock has no sha256. ...')
# and `pub_lock_package_sha256_error`
# ('pub_lock_package "collection" (1.18.0) requires a non-empty sha256.').
pub = use_extension("@rules_dart//dart/pub:extensions.bzl", "pub")
pub.from_lock(
    name = "deps",
    lock = "//:pubspec.lock",
)
use_repo(pub, "deps")
